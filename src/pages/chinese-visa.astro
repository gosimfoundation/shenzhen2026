---
import Layout from "layouts/LayoutLanding.astro";
import HeroText from "components/HeroText.astro";
import TextAndImageVisa from "components/TextAndImageVisa.astro";
import TextAndImage from "components/TextAndImage.astro";
import GetTickets from "components/GetTickets.astro";
import VisaTypes from "components/VisaTypes.astro";

// Images
import VisaFree from "images/subpages/visafree.png";
import VisaFreeTransit from "images/subpages/visafreetransit.png";
import VisaTraditional from "images/subpages/visa-traditional.png";
---

<Layout
  title="Visa Information – GOSIM Shenzhen 2026"
  description="Information about Chinese visa requirements for GOSIM Shenzhen 2026 attendees"
  navBackground="light"
>
  <HeroText
    title="Chinese Visa"
    text="Most attendees are now eligible for visa-free entry or transit. Some may still need a visa depending on their nationality and travel plans. Please read the updated requirements below and contact your local Chinese embassy or consulate for precise instructions."
    lightgray
  />
  <VisaTypes />
  <!-- Visa-Free Entry Section -->
  <section class="" data-theme-section="light" data-bg-section="lightgray">
    <div class="container">
      <TextAndImageVisa
        id="visa-free-entry"
        title="Visa Free Entry"
        text="Citizens from 50 countries, including most EU nations, the UK, Canada, Australia, New Zealand, Japan, South Korea, and several Latin American countries, can now enter China visa-free for up to 30 days. This applies to tourism, business, visiting family/friends, or short conferences."
        validExample1="France → China → France"
        validExample2="Singapore → China → Singapore"
        invalidExample1="USA → China → USA"
        invalidExample2="UK → China → UK"
        image={VisaFree}
        imageAlt="Visa Free Entry"
        dataBgSection="lightgray"
        dataThemeSection="lightgray"
        ctaButton={{
          text: "",
          link: "",
          openInNewTab: true,
        }}
      />
    </div>
  </section>
  <section class="" data-theme-section="light" data-bg-section="lightgray">
    <div class="container">
      <TextAndImageVisa
        id="visa-free-transit"
        title="Visa Free Transit"
        text="Travelers from 55 countries can enter mainland China visa-free for up to 240 hours (10 days) when transiting onward to a different country or region. This is the main option for nationalities not on the visa-free entry list above — most notably the US."
        text2="Shenzhen advantage: because Shenzhen borders Hong Kong — a region separate from the mainland — you can fly into Hong Kong, cross into Shenzhen under this policy, attend GOSIM, then depart. Your entry and exit points just have to differ: enter from Hong Kong and leave to the USA, and the trip qualifies even though it starts and ends in the US."
        text3="You'll need confirmed onward travel within 240 hours. For transit, Hong Kong and Macau each count as a region separate from mainland China."
        validExample1="USA → Hong Kong → Shenzhen → USA (enter via HK, exit to USA)"
        invalidExample1="USA → China → USA (same entry & exit region)"
        invalidExample2="USA → Hong Kong → Shenzhen → Hong Kong (enter & exit both via HK)"
        image={VisaFreeTransit}
        imageAlt="Visa Free Transit"
        dataBgSection="lightgray"
        dataThemeSection="lightgray"
        ctaButton={{
          text: "Getting from Hong Kong to Shenzhen",
          link: "/general-travel/#via-hong-kong",
          openInNewTab: false,
        }}
      />
    </div>
  </section>
  <section class="" data-theme-section="light" data-bg-section="lightgray">
    <div class="container">
      <TextAndImageVisa
        id="visa-traditional"
        title="Traditional Visa Applications"
        text="If you are not eligible for visa-free entry or transit, or plan to stay longer, you will need to apply for a Chinese visa. Most attendees will apply for a Tourist (L) or Business (F) visa."
        validTitle="Required Documents"
        validExample1="Valid passport for at least 6 months with 2 blank pages"
        validExample2="Completed visa application with a recent passport photo"
        validExample3="Round-trip flight booking and hotel reservation, or;"
        validExample4="GOSIM invitation letter"
        image={VisaTraditional}
        imageAlt="Traditional Visa Applications"
        dataBgSection="lightgray"
        dataThemeSection="lightgray"
        ctaButton={{
          text: "",
          link: "",
          openInNewTab: true,
        }}
      />
    </div>
  </section>
  <TextAndImage
    id="invitation-letter"
    title="Invitation Letter"
    text="After completing your registration, GOSIM can provide an invitation letter to support your visa application. Please email us with your passport name, nationality, and registration confirmation if needed. Allow sufficient time — visa processing may take 7–10 business days or longer."
    imageAlt="Visa Invitation"
    dataBgSection="light"
    dataThemeSection="light"
    ctaButton={{
      text: "Request Invitation Letter",
      link: "mailto:travel@gosim.org",
      openInNewTab: true,
    }}
  />
  <GetTickets
    title="Call for Proposals Now Open"
    location="ADEN Hotel Shenzhen Nanshan"
    date="October 16-17, 2026"
    text="We're looking for bold ideas and fresh voices in open-source AI, robotics, edge systems, and developer infrastructure. Submit a proposal to speak at GOSIM Shenzhen 2026."
    ctaButton={{
      text: "Submit a Proposal",
      link: "https://cfp.gosim.org",
      openInNewTab: true,
    }}
  />
</Layout>
<style>
  .visa-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 2rem;
    width: 60%;
  }
  @media (max-width: 768px) {
    .visa-container {
      width: 100%;
    }
  }
</style>
