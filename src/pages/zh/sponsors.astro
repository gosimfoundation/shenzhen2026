---
// Components
import Layout from "layouts/LayoutLandingZh.astro";
import GetTickets from "components/GetTickets.astro";
import HeroText from "components/HeroText.astro";
import AllSponsors from "components/Sponsors.astro";
import TextAndSponsors from "components/TextAndSponsors.astro";
---

<Layout
  title="支持者 – GOSIM Shenzhen 2026"
  description="GOSIM Shenzhen 2026 是开源 AI 项目、开发者、研究人员和行业支持者的聚会，旨在分享知识、相互学习和协作。"
  navBackground="light"
  pageTransitionName="支持者"
>
  <HeroText
    title="支持者"
    text="我们很高兴为您带来一次令人难以置信的体验，这要归功于我们的支持者和合作伙伴的慷慨支持。我们与真正的创新者合作，他们正在推动我们行业的边界。"
    lightgray
  />

  <AllSponsors lang="zh" />

  <GetTickets
    title="议题征集 CFP进行中"
    location="法国巴黎"
    date="2026年10月16-17日"
    text="我们正在寻找开源 AI、机器人、边缘系统与开发者基础设施领域的大胆想法与新声音。欢迎提交议题，登上 GOSIM Shenzhen 2026 的舞台。"
    ctaButton={{
      text: "提交议题",
      link: "https://cfp.gosim.org",
      openInNewTab: true,
    }}
  />
</Layout>
