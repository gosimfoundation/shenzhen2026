---
// Components
import Layout from "layouts/LayoutLandingZh.astro";
import GetTickets from "components/GetTickets.astro";
import HeroText from "components/HeroText.astro";
import AllSponsors from "components/Sponsors.astro";
import PastSponsors from "components/PastSponsors.astro";
---

<Layout
  title="赞助商 – GOSIM Shenzhen 2026"
  description="GOSIM Shenzhen 2026 是开源 AI 项目、开发者、研究人员和行业支持者的聚会，旨在分享知识、相互学习和协作。"
  navDarkMode={true}
  navBackground="header-home"
  pageTransitionName="赞助商"
>
  <HeroText
    title="赞助商"
    text="我们很高兴为您带来一次令人难以置信的体验，这要归功于我们的赞助商和合作伙伴的慷慨支持。我们与真正的创新者合作，他们正在推动我们行业的边界。"
    lightgray
  />

  <AllSponsors lang="zh" />

  <GetTickets
    title="CFP 议题征集 进行中"
    location="深圳南山伊敦酒店"
    date="2026年10月16-17日"
    text="我们正在寻找开源 AI、机器人、边缘系统与开发者基础设施领域的大胆想法与新声音。欢迎提交议题，登上 GOSIM Shenzhen 2026 的舞台。"
    ctaButton={{
      text: "提交议题",
      link: "https://cfp.gosim.org",
      openInNewTab: true,
    }}
  />

  <PastSponsors
    title="往届赞助商（部分）"
    intro="以下是曾支持 GOSIM 全球往届活动的部分组织。"
    contactText="有兴趣赞助 GOSIM Shenzhen 2026？欢迎随时联系我们。"
    excludeImages={["csdn.png", "kaiyuanshe.png"]}
  />
</Layout>
