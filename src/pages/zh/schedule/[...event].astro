---
// Components
import Layout from "layouts/LayoutLandingZh.astro"
import schedule from "json/ScheduleBilingual.json"
import scheduleForum from "json/Schedule-forum.json"
import speakers from "json/SpeakersZh.json"

// Types
type Event = {
  title: string
  content: string
  date: string
  timeSlot: string
  type?: string
  speakers?: { name: string; image?: string; roleOrg: string; id?: string }[]
  room?: string
}

export async function getStaticPaths() {
  const events: {
    params: { event: string }
    props: { event: Event; category: string }
  }[] = []

  const createSlug = (title: string) => {
    return title
      .toLowerCase()
      .replace(/[^\w\s\u4e00-\u9fff-]/g, "")
      .replace(/\s+/g, "-")
      .replace(/-+/g, "-")
      .replace(/^-+|-+$/g, "")
      .trim()
  }

  Object.entries(schedule.sessions).forEach(([category, categoryEvents]) => {
    categoryEvents.forEach((event: any) => {
      const eventTitleForSlug = typeof event.title === "string" ? event.title : event.title?.en || ""
      const eventTitle = typeof event.title === "string" ? event.title : event.title?.zh || event.title?.en || ""
      const transformedEvent = {
        title: eventTitle,
        content: typeof event.content === "string" ? event.content : event.content?.zh || event.content?.en || "",
        date: typeof event.date === "string" ? event.date : event.date?.zh || event.date?.en || "",
        timeSlot: event.timeSlot,
        type: event.type,
        speakers: event.speakers?.map((s: any) => ({
          name: typeof s.name === "string" ? s.name : s.name?.zh || s.name?.en || "",
          image: s.image,
          roleOrg: typeof s.roleOrg === "string" ? s.roleOrg : s.roleOrg?.zh || s.roleOrg?.en || "",
          id: s.id,
        })) || [],
        room: typeof event.room === "string" ? event.room : event.room?.zh || event.room?.en || "",
      }
      events.push({
        params: { event: createSlug(eventTitleForSlug) },
        props: { event: transformedEvent, category },
      })
    })
  })

  scheduleForum.forEach((event: Event) => {
    events.push({
      params: { event: event.title.toLowerCase().replace(/[^\w\s-]/g, "").replace(/\s+/g, "-").trim() },
      props: { event, category: "论坛" },
    })
  })

  return events
}

const { event: eventDetails, category } = Astro.props as {
  event: Event
  category: string
}

// Prev/next navigation (use EN titles for slugs)
const createSlugNav = (title: string) =>
  title.toLowerCase().replace(/[^\w\s\u4e00-\u9fff-]/g, "").replace(/\s+/g, "-").replace(/-+/g, "-").replace(/^-+|-+$/g, "").trim()

const allEvents: { slug: string; title: string }[] = []
Object.entries(schedule.sessions).forEach(([_cat, categoryEvents]) => {
  ;(categoryEvents as any[]).forEach((ev) => {
    const title = typeof ev.title === "string" ? ev.title : ev.title?.en || ""
    if (title) allEvents.push({ slug: createSlugNav(title), title })
  })
})

const currentSlug = createSlugNav(
  // Use EN title for slug matching
  (() => {
    for (const [_cat, evs] of Object.entries(schedule.sessions)) {
      for (const ev of evs as any[]) {
        const zhTitle = typeof ev.title === "string" ? ev.title : ev.title?.zh || ev.title?.en || ""
        if (zhTitle === eventDetails.title) {
          return typeof ev.title === "string" ? ev.title : ev.title?.en || ""
        }
      }
    }
    return eventDetails.title
  })()
)
const currentIndex = allEvents.findIndex((e) => e.slug === currentSlug)
const prevEvent = currentIndex > 0 ? allEvents[currentIndex - 1] : allEvents[allEvents.length - 1]
const nextEvent = currentIndex < allEvents.length - 1 ? allEvents[currentIndex + 1] : allEvents[0]

const categoryMap: Record<string, string> = {
  "gosim-plenary": "GOSIM 全体大会",
  "ai-models-infra": "AI 模型 × 基础设施",
  "embodied-ai": "具身智能",
  "agentic-web": "智能体网络",
  "apps-agents": "应用 × 智能体",
  "ai-next": "AI Next",
  "agentic-ai-on-edge": "边缘 Agentic AI",
  "open-source-robotics": "开源机器人",

  "ws-oh-tech-forum": "OpenHarmony 技术论坛",
  "ws-open-compute": "Open Compute for Agentic AI (FlagOS)",
  "ws-sglang": "SGLang Workshop",
  "ws-cangjie": "仓颉 Workshop",
  "ws-dora": "Open Source Robotics Workshop",
  "ws-future-web": "Future Web Workshop",
  "ws-edge-ai": "Edge AI Workshop",
  "ws-cann": "CANN Workshop",
  "ws-flutter": "Flutter Meetup",
  "ws-chitu": "开源赤兔首次聚会",
  "ws-ai-education": "AI教育 Workshop",
  "ws-rn": "RN Workshop",
  "ws-rust": "Rust Workshop",
  "open-for-sdg": "Open for SDG 会议",
  "forum-aivision": "AI Vision 论坛",
}
const eventCategory = eventDetails.type === "keynote" ? "Keynote" : (categoryMap[category] || category || "未分类")
---

<Layout
  title={`${eventDetails.title} – GOSIM Shenzhen 2026`}
  description={eventDetails.content
    .replace(/\n/g, " ")
    .replace(/<[^>]*>/g, "")
    .substring(0, 160)}
  navBackground="light"
  pageTransitionName={eventDetails.title}
>
  <!-- Top nav bar: prev / all schedule / next -->
  <div class="ev-nav-bar" data-theme-section="light" data-bg-section="light">
    <div class="container">
      <div class="ev-nav">
        <a href={`/zh/schedule/${prevEvent.slug}/`} class="ev-nav-btn ev-nav-prev">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          <div class="ev-nav-info">
            <span class="ev-nav-label">上一个</span>
            <span class="ev-nav-name">{prevEvent.title}</span>
          </div>
        </a>
        <a href="/zh/schedule/" class="ev-nav-btn ev-nav-all">所有日程</a>
        <a href={`/zh/schedule/${nextEvent.slug}/`} class="ev-nav-btn ev-nav-next">
          <div class="ev-nav-info" style="text-align:right">
            <span class="ev-nav-label">下一个</span>
            <span class="ev-nav-name">{nextEvent.title}</span>
          </div>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      </div>
    </div>
  </div>

  <section
    class="section speaker-detail-header"
    data-theme-section="light"
    data-bg-section="light"
  >
    <div class="container">

      <span class="ev-tag">{eventCategory}</span>

      <h1 class="ev-title">{eventDetails.title}</h1>

      <div class="ev-meta">
        <span class="ev-meta-item">
          <span class="ev-meta-label">日期</span>
          <span class="ev-meta-value">{eventDetails.date}</span>
        </span>
        <span class="ev-meta-divider" />
        <span class="ev-meta-item">
          <span class="ev-meta-label">时间</span>
          <span class="ev-meta-value">{eventDetails.timeSlot}</span>
        </span>
        <span class="ev-meta-divider" />
        <span class="ev-meta-item">
          <span class="ev-meta-label">地点</span>
          <span class="ev-meta-value">
            {eventDetails.room || (() => {
              const cat = schedule.categories.find((c) => c.id === category)
              if (cat?.room) return typeof cat.room === "string" ? cat.room : (cat.room as any)?.zh || (cat.room as any)?.en || ""
              return "待定"
            })()}
          </span>
        </span>
      </div>

      {eventDetails.content && (
        <div class="ev-description styled-content">
          <Fragment set:html={eventDetails.content.replace(/\n/g, "<br>")} />
        </div>
      )}

      {eventDetails.speakers && eventDetails.speakers.length > 0 && (
        <div class="ev-speakers">
          <p class="ev-speakers-label">讲师</p>
          <div class="ev-speaker-list">
            {eventDetails.speakers.map((speaker) => {
              const full = speakers.speakers.find(
                (s) => s.name === speaker.name || s.nameEn === speaker.name
              ) || (speaker.id ? speakers.speakers.find((s) => s.id === speaker.id) : null)
              const workshopCategories = ["ws-future-web","ws-cann","ws-flutter","ws-cangjie","ws-edge-ai","ws-chitu","ws-ai-education","ws-rn","ws-dora","ws-rust","ws-sglang","open-for-sdg","forum-aivision"]
              const isWorkshop = full ? full.tags?.some((t: string) => workshopCategories.includes(t)) : false
              const speakerPath = isWorkshop ? "/zh/workshops/" : "/zh/speakers/"
              const speakerId = full?.id || speaker.id || speaker.name.toLowerCase().replace(/\s+/g, "-")
              const img = full?.image || speaker?.image || "/images/speakers/0-speaker-placeholder.png"
              return (
                <a href={`${speakerPath}${speakerId}/`} class="ev-speaker-card">
                  <img src={img} alt={speaker.name} class="ev-speaker-img" />
                  <div class="ev-speaker-info">
                    <span class="ev-speaker-name">{full?.name || speaker.name}</span>
                    <span class="ev-speaker-role">{full?.roleOrg || speaker.roleOrg}</span>
                  </div>
                </a>
              )
            })}
          </div>
        </div>
      )}

    </div>
  </section>
</Layout>

<style>
  .ev-nav-bar {
    border-bottom: 1px solid #e5e5e5;
    padding: calc(var(--nav-bar-height) + 0.75rem) 0 0.75rem;
  }

  .ev-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  .ev-nav-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    text-decoration: none !important;
    color: var(--color-dark) !important;
  }
  .ev-nav-btn:hover { background: #f5f5f0; }

  .ev-nav-next { justify-content: flex-end; }

  .ev-nav-all {
    border: 1.5px solid currentColor;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.4rem 1rem;
    white-space: nowrap;
  }

  .ev-nav-info {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .ev-nav-label {
    font-size: 0.75rem;
    color: #999;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ev-nav-name {
    font-size: 0.9rem;
    font-weight: 600;
  }

  .ev-nav-btn svg { flex-shrink: 0; }

  .speaker-detail-header {
    padding-top: 2.5rem !important;
    padding-bottom: 5rem !important;
  }

  .ev-tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: #0f172a;
    color: #fff;
    padding: 0.3rem 0.85rem;
    border-radius: 20px;
    margin-bottom: 0.85rem;
  }

  .ev-title {
    font-size: clamp(1.35rem, 2.2vw, 1.9rem) !important;
    font-weight: 800;
    line-height: 1.25;
    margin: 0.5rem 0 1.5rem !important;
    letter-spacing: -0.02em;
  }

  .ev-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 2rem;
    align-items: flex-start;
    padding: 1.25rem 1.5rem;
    background: var(--color-lightgray);
    border-radius: var(--border-radius);
    margin-bottom: 2rem;
  }

  .ev-meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .ev-meta-divider {
    width: 1px;
    height: 2rem;
    background: rgba(0,0,0,0.12);
    align-self: center;
  }

  .ev-meta-label {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(0,0,0,0.35);
  }

  .ev-meta-value {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-dark);
  }

  .ev-description {
    font-size: 0.95rem;
    line-height: 1.75;
    color: rgba(0,0,0,0.75);
    margin-bottom: 2.5rem;
  }

  .ev-speakers {
    margin-bottom: 2rem;
  }

  .ev-speakers-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(0,0,0,0.35);
    margin: 0 0 0.85rem;
  }

  .ev-speaker-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .ev-speaker-card {
    display: flex;
    align-items: stretch;
    text-decoration: none;
    color: inherit;
    background: var(--color-lightgray);
    border-radius: 14px;
    overflow: hidden;
  }
  .ev-speaker-card:hover { background: #e2e8f0; }

  .ev-speaker-img,
  .ev-speaker-placeholder {
    width: 160px;
    flex-shrink: 0;
    object-fit: cover;
    object-position: top;
    display: block;
    background: #cbd5e1;
    min-height: 220px;
  }

  .ev-speaker-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.4rem;
    padding: 1.25rem 1.4rem;
  }

  .ev-speaker-name {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .ev-speaker-role {
    font-size: 0.83rem;
    color: rgba(62, 58, 43, 0.16);
    line-height: 1.45;
  }

  @media (max-width: 900px) {
    .ev-speaker-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .ev-speaker-list {
      grid-template-columns: 1fr;
    }
    .ev-meta {
      gap: 1rem;
    }
    .ev-meta-divider {
      display: none;
    }
  }
</style>
