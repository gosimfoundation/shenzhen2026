---
// Components
import Layout from "layouts/LayoutLandingZh.astro"
import Hero from "components/Hero.astro"
import ProgramSection from "components/ProgramSection.astro"
import CoLocatedEventFeature from "components/CoLocatedEventFeature.astro"
import VenueDetails from "components/VenueDetails.astro"
import EventGallery from "components/EventGallery.astro"
import PreviousEvents from "components/PreviousEvents.astro"
import GetTickets from "components/GetTickets.astro"
import ProudlySupported from "components/ProudlySupported.astro"

// Images
import GosimShanghai from "images/homepage/gosim-shanghai.png"
import GosimDelft from "images/homepage/gosim-delft.png"
import GosimBeijing from "images/homepage/gosim-beijing.png"
import GosimParis from "images/homepage/gosim-paris-min.png"
import GosimHangzhou from "images/homepage/gosim-hangzhou.png"
import GosimParis2026 from "images/homepage/gosim-paris-2026.jpg"
---

<Layout
  title="GOSIM Shenzhen 2026"
  description="GOSIM Shenzhen 2026 — 开源 AI、机器人、边缘系统与开发者基础设施大会。2026年10月16-17日，深圳南山伊敦酒店。"
  navDarkMode={true}
  navBackground="header-home"
  pageTransitionName="Home"
>
  <Hero
    date="2026年10月16-17日"
    location="深圳南山伊敦酒店"
    subtitle="全球顶级开源技术盛会"
    description="150+ 国际讲师与 2000+ 全球开发者齐聚深圳，带来 Keynote、技术论坛、Workshop、Hackathon 与开源项目现场演示。"
    video="/videos/shenzhen-hero-compressed.mp4"
    poster="/videos/shenzhen-hero-poster.jpg"
    links={[
      {
        text: "CFP 议题征集",
        link: "https://cfp.gosim.org",
        openInNewTab: true,
        class: "btn light xl btn-hover",
      },
      {
        text: "购票",
        link: "/zh/tickets",
        openInNewTab: false,
        class: "btn primary xl btn-hover",
      },
    ]}
  />

  <ProudlySupported lead="往届大会的行业先锋支持者" />

  <ProgramSection
    eyebrow="GOSIM 深圳 2026 / 10月16-17日 / 深圳南山伊敦酒店"
    headlineLines={[
      "当开源",
      "遇见中国创新之都",
    ]}
    accentLine={0}
    body="深圳是中国科技创新的心脏——最年轻的人口、最敢闯的创业者，与全球最密集的软硬件产业链彼此交织，成就了不断刷新想象的「深圳速度」。"
    facetsTitle="大会内容"
    facets={[
      {
        title: "智能体 AI",
        keywords: ["多智能体协作", "智能体工程", "MCP 协议", "A2A 协议", "智能体应用", "AI 原生开发"],
      },
      {
        title: "开源机器人",
        keywords: ["具身智能", "人形机器人", "灵巧操作", "运动控制", "仿真与训练", "自主导航"],
      },
      {
        title: "开源模型与基础设施",
        keywords: ["大语言模型", "代码模型", "视觉模型", "多模态模型", "语音与音频", "视频生成", "世界模型"],
      },
      {
        title: "Spotlight 与黑客松",
        keywords: ["机器人挑战赛", "智能体实战", "项目路演", "现场演示"],
      },
    ]}
    tracksTitle="分论坛主题"
    tracksIntro="从开源模型、智能体框架到机器人与边缘 AI，大会议程旨在展示技术栈的下一步走向，让开发者与构建者面对面交流。完整日程即将公布。"
    exploreLabel="查看日程"
    enterLabel="了解更多"
    tracks={[
      {
        title: "智能体 AI 峰会",
        text: "智能体浪潮的战略层。聚焦 MCP、A2A、主权 AI、AI-native 开发方式，以及开源智能体正在形成的新协议、新软件范式与新商业路径。",
        link: "/zh/schedule/#agentic-ai-summit",
      },
      {
        title: "边缘智能体 AI",
        text: "端侧 AI 正迎来性能觉醒，智能体正在向边缘设备全面渗透。本方向聚焦资源受限环境下的强大 AI 模型部署，深挖端侧推理加速、模型压缩与实时决策的工程实践。",
        link: "/zh/schedule/#agentic-ai-on-edge",
      },
      {
        title: "智能体操作系统与应用",
        text: "当 AI 智能体成为人机交互的新界面，一个全新的操作系统层正在涌现。本方向探索驱动智能体操作系统与应用的架构、框架和平台——从多智能体协调、运行时环境，到意图驱动的 AI 原生应用。",
        link: "/zh/schedule/#ai-generative-app",
      },
      {
        title: "开源模型与基础设施",
        text: "开源模型正在语言、视觉、音频与视频上快速进化。这一主题关注最新突破、实际落地，以及开放模型生态正在释放的新能力。",
        link: "/zh/schedule/#open-source-model",
      },
      {
        title: "开源机器人",
        text: "智能体软件与物理系统真正相遇的地方。这里讨论开源机器人平台、具身智能技术栈，以及构建可感知、可规划、可执行的自主机器的真实方法。",
        link: "/zh/schedule/#open-source-robotics",
      },
      {
        title: "智能体设备",
        text: "从 AI 原生手机、可穿戴设备到全新的个人计算形态，本方向关注让智能体真正落地的终端设备。探讨软硬件协同设计、多模态感知、持续上下文、语音优先交互与安全端侧执行，让 AI 从一个应用升级为设备本身的交互入口。",
        link: "/zh/schedule/#agentic-device",
      },
    ]}
    highlightsTitle="Spotlight 与黑客松"
    highlights={[
      {
        badge: "Spotlight",
        status: "全球项目征集",
        title: "Spotlight Shenzhen 2026：下一代 AI 原生产品",
        titleLines: ["Spotlight Shenzhen 2026：", "下一代 AI 原生产品"],
        text: "面向全球征集下一代 AI 原生产品，入选团队将在深圳集中共创，并于 GOSIM Shenzhen 2026 现场展示。",
        link: "https://spotlight.gosim.org/zh/shenzhen2026/",
        linkLabel: "了解 Spotlight",
      },
      {
        badge: "OAIC 智能体工厂黑客松",
        status: "报名即将开始",
        title: "智能体工厂国际黑客松",
        text: "面向全球的 Harness Engineering 竞赛，从线上初赛与大奖赛一路走向 GOSIM 深圳 2026 现场 Demo Day。",
        link: "https://create.gosim.org/factory26/",
        linkLabel: "查看黑客松",
      },
    ]}
  />

  <CoLocatedEventFeature
    id="rustchinaconf"
    eyebrow="同期活动"
    title="RustChinaConf 2026 · 深圳"
    theme="Rust and AI"
    dateLabel="大会时间"
    date="2026 年 10 月 15–17 日"
    text="RustChinaConf 与 GOSIM Shenzhen 2026 同期举办，聚焦 Rust for AI、AI for Rust 与 Rust in Production，汇聚 Rust 开发者、开源维护者与产业实践者。"
    image="https://rustchinaconf.org/hero/rustchinaconf-shenzhen-2026-banner.png"
    imageAlt="RustChinaConf 2026 深圳大会主视觉"
    link="https://rustchinaconf.org/zh-CN/"
    linkLabel="了解 RustChinaConf"
  />

  <VenueDetails
    eyebrow="大会场地"
    title="深圳南山伊敦酒店"
    venueName="相聚深圳"
    address="深圳市南山区蛇口龟山路8号"
    description="大会场地位于深圳蛇口，距离海上世界地铁站约 700 米，可乘坐 2 号线、8 号线和 12 号线，步行即可到达蛇口海滨片区。"
    image="/images/venue/aden-hotel-shenzhen-nanshan.jpg"
    imageAlt="深圳南山伊敦酒店夜景"
    link="/zh/venue/"
    linkLabel="查看场地详情"
  />

  <EventGallery
    title="The GOSIM Experience"
    albums={[
      {
        label: "GOSIM Paris 2026",
        images: [
          { src: "/images/homepage/gallery2026/paris2026-01.jpg", alt: "GOSIM Paris 2026 现场照片" },
          { src: "/images/homepage/gallery2026/paris2026-02.jpg", alt: "GOSIM Paris 2026 现场照片" },
          { src: "/images/homepage/gallery2026/paris2026-03.jpg", alt: "GOSIM Paris 2026 现场照片" },
          { src: "/images/homepage/gallery2026/paris2026-04.jpg", alt: "GOSIM Paris 2026 现场照片" },
          { src: "/images/homepage/gallery2026/paris2026-06.jpg", alt: "GOSIM Paris 2026 现场照片" },
          { src: "/images/homepage/gallery2026/paris2026-07.jpg", alt: "GOSIM Paris 2026 现场照片" },
          { src: "/images/homepage/gallery2026/paris2026-08.jpg", alt: "GOSIM Paris 2026 现场照片" },
          { src: "/images/homepage/gallery2026/paris2026-09.jpg", alt: "GOSIM Paris 2026 现场照片" },
        ],
      },
      {
        label: "GOSIM Hangzhou 2025",
        images: [
          { src: "/images/homepage/gallery2025/hangzhou2025-01.jpg", alt: "GOSIM Hangzhou 2025 现场照片" },
          { src: "/images/homepage/gallery2025/hangzhou2025-02.jpg", alt: "GOSIM Hangzhou 2025 现场照片" },
          { src: "/images/homepage/gallery2025/hangzhou2025-03.jpg", alt: "GOSIM Hangzhou 2025 现场照片" },
          { src: "/images/homepage/gallery2025/hangzhou2025-04.jpg", alt: "GOSIM Hangzhou 2025 现场照片" },
          { src: "/images/homepage/gallery2025/hangzhou2025-05.jpg", alt: "GOSIM Hangzhou 2025 现场照片" },
          { src: "/images/homepage/gallery2025/hangzhou2025-07.jpg", alt: "GOSIM Hangzhou 2025 现场照片" },
          { src: "/images/homepage/gallery2025/hangzhou2025-08.jpg", alt: "GOSIM Hangzhou 2025 现场照片" },
          { src: "/images/homepage/gallery2025/hangzhou2025-09.jpg", alt: "GOSIM Hangzhou 2025 现场照片" },
        ],
      },
    ]}
  />

  <PreviousEvents
    title="往届活动"
    events={[
      {
        title: "GOSIM Paris 2026",
        date: "2026年5月5-6日",
        description: "GOSIM Paris 2026 在巴黎 STATION F 汇聚了来自世界各地的演讲者与开源构建者，带来为期两天的演讲与工作坊。",
        image: GosimParis2026,
        link: "https://paris2026.gosim.org/",
      },
      {
        title: "GOSIM Hangzhou",
        date: "2025年9月13-14日",
        description: "GOSIM 杭州站汇聚了开源 AI 构建者与贡献者，带来一整天的演讲、工作坊与社区交流。",
        image: GosimHangzhou,
        link: "https://hangzhou2025.gosim.org/",
      },
      {
        title: "GOSIM AI Paris 2025",
        date: "2025年5月6-7日",
        description: "GOSIM AI Paris 2025 在 STATION F 汇聚了全球开源 AI 先行者。",
        image: GosimParis,
        link: "https://paris2025.gosim.org/",
      },
      {
        title: "GOSIM Beijing",
        date: "2024年10月17-18日",
        description: "GOSIM 北京大会吸引了超过 1700 名参会者，是迄今为止规模最大的 GOSIM 活动。",
        image: GosimBeijing,
        link: "https://china2024.gosim.org/",
      },
      {
        title: "GOSIM Delft",
        date: "2024年6月6-7日",
        description: "GOSIM 代尔夫特站为期两天，吸引了来自世界各地的 1200 名参会者。",
        image: GosimDelft,
        link: "https://europe2024.gosim.org/",
      },
      {
        title: "GOSIM Shanghai",
        date: "2023年9月23-24日",
        description: "GOSIM 大会与工作坊致力于支持与推动开源贡献。",
        image: GosimShanghai,
        link: "https://conference2023.gosim.org/",
      },
    ]}
  />

  <GetTickets
    title="CFP 议题征集 进行中"
    location="深圳南山伊敦酒店"
    date="2026年10月16-17日"
    text="我们正在寻找开源 AI、机器人、边缘系统与开发者基础设施领域的大胆想法与新声音。欢迎提交议题，登上 GOSIM Shenzhen 2026 的舞台。"
    ctaButton={{
      text: "提交议题",
      link: "https://cfp.gosim.org",
      openInNewTab: true,
    }}
  />
</Layout>
