---
// Components
import Layout from "layouts/LayoutLandingZh.astro";
import GetTickets from "components/GetTickets.astro";
import HeroText from "components/HeroText.astro";
import ScheduleTracks from "components/ScheduleTracks.astro";
---

<Layout
  title="议程安排 – GOSIM Shenzhen 2026"
  description="查看 GOSIM Shenzhen 2026 六大分论坛已确认的演讲题目。具体时间与会场安排将稍后公布。"
  navDarkMode={true}
  navBackground="header-home"
  pageTransitionName="议程安排"
>
  <HeroText title="议程安排" lightgray />

  <ScheduleTracks lang="zh" previewMode />

  <GetTickets
    title="相约深圳"
    location="深圳南山伊敦酒店"
    date="2026年10月16-17日"
    text="与开源 AI、机器人、边缘系统和开发者基础设施领域的建设者相聚 GOSIM Shenzhen 2026。"
    ctaButton={{
      text: "立即购票",
      link: "https://www.bagevent.com/event/gosimshenzhen2026#website_moduleId_1164696",
      openInNewTab: true,
    }}
  />
</Layout>
