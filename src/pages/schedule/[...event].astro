---
// Packages
import { Picture } from "astro:assets"
import type { ImageMetadata } from "astro"

// Components
import Layout from "layouts/LayoutLanding.astro"
import schedule from "json/ScheduleBilingual.json"
import scheduleForum from "json/Schedule-forum.json"
import schedulePreview from "json/SchedulePreview.json"
import speakers from "json/SpeakersCleaned.json"
import {
  getSpeakerImagePath,
  SPEAKER_IMAGE_FALLBACK_HANDLER,
} from "utils/speaker-images"

// Types
type Event = {
  title: string
  content: string
  date: string
  timeSlot: string
  type?: string
  speakers?: { name: string; image?: string; roleOrg: string; id?: string }[]
  room?: string
  signupUrl?: string
  slug?: string
  categoryLabel?: string
  preview?: boolean
  overview?: string
}

// Generate static paths for events
export async function getStaticPaths() {
  const events: {
    params: { event: string }
    props: { event: Event; category: string }
  }[] = []

  const createSlug = (title: string) => {
    return title
      .toLowerCase()
      .replace(/[^\w\s\u4e00-\u9fff-]/g, "") // Keep ASCII word chars, spaces, Chinese chars, and hyphens
      .replace(/\s+/g, "-")
      .replace(/-+/g, "-")
      .replace(/^-+|-+$/g, "") // Remove leading/trailing hyphens
      .trim()
  }

  // Collect all sessions from all categories in main schedule (bilingual structure)
  Object.entries(schedule.sessions).forEach(([category, categoryEvents]) => {
    categoryEvents.forEach((event: any) => {
      const eventTitle =
        typeof event.title === "string" ? event.title : event.title?.en || ""
      const transformedEvent = {
        title: eventTitle,
        content:
          typeof event.content === "string"
            ? event.content
            : event.content?.en || "",
        date:
          typeof event.date === "string" ? event.date : event.date?.en || "",
        timeSlot: event.timeSlot,
        type: event.type,
        speakers:
          event.speakers?.map((s: any) => ({
            name: typeof s.name === "string" ? s.name : s.name?.en || "",
            image: s.image,
            roleOrg:
              typeof s.roleOrg === "string" ? s.roleOrg : s.roleOrg?.en ||
              (typeof s.title === "string" ? s.title : (s.title as any)?.en || ""),
            id: s.id,
          })) || [],
        room:
          typeof event.room === "string" ? event.room : event.room?.en || "",
        signupUrl: event.signupUrl || "",
      }
      events.push({
        params: {
          event: createSlug(eventTitle),
        },
        props: { event: transformedEvent, category },
      })
    })
  })

  // Temporary no-time sessions use the same detail route as the full schedule.
  schedulePreview.tracks.forEach((track) => {
    track.talks.forEach((talk) => {
      const eventSpeakers = talk.speakers
        .map((speakerId) => speakers.speakers.find((speaker) => speaker.id === speakerId))
        .filter(Boolean)
        .map((speaker) => ({
          id: speaker!.id,
          name: speaker!.name,
          image: speaker!.image,
          roleOrg: speaker!.roleOrg,
        }))
      events.push({
        params: { event: talk.slug },
        props: {
          event: {
            title: talk.title.en,
            content: "",
            date: "",
            timeSlot: "",
            type: "talk",
            speakers: eventSpeakers,
            room: "",
            slug: talk.slug,
            categoryLabel: track.name.en,
            preview: true,
            overview: talk.overview.en,
          },
          category: track.id,
        },
      })
    })
  })

  // Add forum events
  scheduleForum.forEach((event: Event) => {
    events.push({
      params: {
        event: createSlug(event.title),
      },
      props: { event, category: "Forum" },
    })
  })

  return events
}

// Get the event from the route parameter
const { event: eventDetails, category } = Astro.props as {
  event: Event
  category: string
}

// Build flat ordered list of all events for prev/next navigation
const createSlugNav = (title: string) =>
  title.toLowerCase().replace(/[^\w\s\u4e00-\u9fff-]/g, "").replace(/\s+/g, "-").replace(/-+/g, "-").replace(/^-+|-+$/g, "").trim()

const allEvents: { slug: string; title: string }[] = []
Object.entries(schedule.sessions).forEach(([_cat, categoryEvents]) => {
  ;(categoryEvents as any[]).forEach((ev) => {
    const title = typeof ev.title === "string" ? ev.title : ev.title?.en || ""
    if (title) allEvents.push({ slug: createSlugNav(title), title })
  })
})
schedulePreview.tracks.forEach((track) => {
  track.talks.forEach((talk) => {
    allEvents.push({ slug: talk.slug, title: talk.title.en })
  })
})

const currentSlug = eventDetails.slug || createSlugNav(eventDetails.title)
const currentIndex = allEvents.findIndex((e) => e.slug === currentSlug)
const prevEvent = currentIndex > 0 ? allEvents[currentIndex - 1] : allEvents[allEvents.length - 1]
const nextEvent = currentIndex < allEvents.length - 1 ? allEvents[currentIndex + 1] : allEvents[0]

// Find the human-readable category label
const eventCategory = (() => {
  if (eventDetails.categoryLabel) return eventDetails.categoryLabel
  if (eventDetails.type === "keynote") return "Keynote"
  const cat = schedule.categories.find((c) => c.id === category)
  if (cat?.name) return typeof cat.name === "string" ? cat.name : (cat.name as any)?.en || category
  return category || "Uncategorized"
})()
---

<Layout
  title={`${eventDetails.title} – GOSIM Shenzhen 2026`}
  description={(eventDetails.overview || eventDetails.content)
    .replace(/\n/g, " ")
    .replace(/<[^>]*>/g, "")
    .substring(0, 160)}
  navBackground="light"
  pageTransitionName={eventDetails.title}
>
  <!-- Top nav bar: prev / all schedule / next -->
  <div class="ev-nav-bar" data-theme-section="dark" data-bg-section="light">
    <div class="container">
      <div class="ev-nav">
        <a href={`/schedule/${prevEvent.slug}/`} class="ev-nav-btn ev-nav-prev">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          <div class="ev-nav-info">
            <span class="ev-nav-label">Previous</span>
            <span class="ev-nav-name">{prevEvent.title}</span>
          </div>
        </a>
        <a href="/schedule/" class="ev-nav-btn ev-nav-all">All Schedule</a>
        <a href={`/schedule/${nextEvent.slug}/`} class="ev-nav-btn ev-nav-next">
          <div class="ev-nav-info" style="text-align:right">
            <span class="ev-nav-label">Next</span>
            <span class="ev-nav-name">{nextEvent.title}</span>
          </div>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      </div>
    </div>
  </div>

  <section
    class="section speaker-detail-header"
    data-theme-section="dark"
    data-bg-section="light"
  >
    <div class="container">

      <span class="ev-tag">{eventCategory}</span>

      <h1 class="ev-title">{eventDetails.title}</h1>

      {!eventDetails.preview && (
        <div class="ev-meta">
          <span class="ev-meta-item">
            <span class="ev-meta-label">Date</span>
            <span class="ev-meta-value">{eventDetails.date}</span>
          </span>
          <span class="ev-meta-divider" />
          <span class="ev-meta-item">
            <span class="ev-meta-label">Time</span>
            <span class="ev-meta-value">{eventDetails.timeSlot}</span>
          </span>
          <span class="ev-meta-divider" />
          <span class="ev-meta-item">
            <span class="ev-meta-label">Location</span>
            <span class="ev-meta-value">
              {eventDetails.room || (() => {
                const cat = schedule.categories.find((c) => c.id === category)
                if (cat?.room) return typeof cat.room === "string" ? cat.room : cat.room?.en || ""
                return "TBA"
              })()}
            </span>
          </span>
        </div>
      )}

      {eventDetails.preview && (
        <p class="ev-preview-note">Date, time, and room will be added once confirmed.</p>
      )}

      {eventDetails.overview && (
        <section class="ev-overview" aria-labelledby="talk-overview-heading">
          <h2 id="talk-overview-heading">Talk overview</h2>
          <p>{eventDetails.overview}</p>
        </section>
      )}

      {eventDetails.signupUrl && (
        <a href={eventDetails.signupUrl} target="_blank" rel="noopener" class="ev-signup-btn">Sign Up for This Event &rarr;</a>
      )}

      {eventDetails.content && (
        <div class="ev-description styled-content">
          <Fragment set:html={eventDetails.content.replace(/\n/g, "<br>")} />
        </div>
      )}

      {eventDetails.speakers && eventDetails.speakers.length > 0 && (
        <div class="ev-speakers">
          <p class="ev-speakers-label">Speakers</p>
          <div class="ev-speaker-list">
            {eventDetails.speakers.map((speaker) => {
              const full = (speaker.id ? speakers.speakers.find((s) => s.id === speaker.id) : null) || speakers.speakers.find((s) => s.name === speaker.name)
              const workshopCategories = ["ws-future-web","ws-cann","ws-flutter","ws-cangjie","ws-edge-ai","ws-chitu","ws-ai-education","ws-rn","ws-dora","ws-rust","ws-sglang","open-for-sdg","forum-aivision"]
              const isWorkshop = full ? full.tags?.some((t: string) => workshopCategories.includes(t)) : false
              const speakerPath = isWorkshop ? "/workshops/" : "/speakers/"
              const speakerId = full?.id || speaker.id || speaker.name.toLowerCase().replace(/\s+/g, "-")
              const img = getSpeakerImagePath(speakerId)
              return (
                <a href={`${speakerPath}${speakerId}/`} class="ev-speaker-card">
                  <img src={img} onerror={SPEAKER_IMAGE_FALLBACK_HANDLER} alt={speaker.name} class="ev-speaker-img" />
                  <div class="ev-speaker-info">
                    <span class="ev-speaker-name">{full?.name || speaker.name}</span>
                    <span class="ev-speaker-role">{speaker.roleOrg || full?.roleOrg}</span>
                  </div>
                </a>
              )
            })}
          </div>
        </div>
      )}

    </div>
  </section>
</Layout>

<style>
  /* Nav bar — same pattern as speaker page */
  .ev-nav-bar {
    border-bottom: 1px solid rgba(246, 243, 231, 0.22);
    padding: calc(var(--nav-bar-height) + 0.75rem) 0 0.75rem;
  }

  .ev-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  .ev-nav-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    text-decoration: none !important;
    color: #f6f3e7 !important;
  }
  .ev-nav-btn:hover { background: rgba(246, 243, 231, 0.08); }

  .ev-nav-next { justify-content: flex-end; }

  .ev-nav-all {
    border: 1.5px solid currentColor;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.4rem 1rem;
    white-space: nowrap;
    border-color: rgba(246, 243, 231, 0.55) !important;
    background: transparent !important;
    color: #f6f3e7 !important;
  }

  .ev-nav-info {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .ev-nav-label {
    font-size: 0.75rem;
    color: rgba(246, 243, 231, 0.55);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ev-nav-name {
    font-size: 0.9rem;
    font-weight: 600;
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .ev-nav-btn svg { flex-shrink: 0; }

  .speaker-detail-header {
    padding-top: 2.5rem !important;
    padding-bottom: 5rem !important;
  }

  .ev-tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: #0f172a;
    color: #fff;
    padding: 0.3rem 0.85rem;
    border-radius: 20px;
    margin-bottom: 0.85rem;
  }

  .ev-title {
    color: #f6f3e7;
    font-size: clamp(1.35rem, 2.2vw, 1.9rem) !important;
    font-weight: 800;
    line-height: 1.25;
    margin: 0.5rem 0 1.5rem !important;
    letter-spacing: -0.02em;
  }

  /* Meta row — label + value pairs */
  .ev-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 2rem;
    align-items: flex-start;
    padding: 1.25rem 1.5rem;
    background: var(--color-lightgray);
    border-radius: var(--border-radius);
    margin-bottom: 2rem;
  }

  .ev-meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .ev-meta-divider {
    width: 1px;
    height: 2rem;
    background: rgba(0,0,0,0.12);
    align-self: center;
  }

  .ev-meta-label {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(0,0,0,0.35);
  }

  .ev-meta-value {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-dark);
  }

  .ev-preview-note {
    display: inline-block;
    margin: 0 0 2rem;
    padding: 0.65rem 0.9rem;
    border-radius: 8px;
    border: 1px solid rgba(246, 243, 231, 0.12);
    background: rgba(246, 243, 231, 0.06);
    color: rgba(246, 243, 231, 0.68);
    font-size: 0.8rem;
  }

  .ev-overview {
    max-width: 62rem;
    margin: 0 0 2.5rem;
    padding: 1.1rem 1.3rem;
    border-left: 3px solid #ef6a3a;
    border-radius: 0 10px 10px 0;
    background: rgba(246, 243, 231, 0.05);
  }

  .ev-overview h2 {
    margin: 0 0 0.55rem;
    color: rgba(246, 243, 231, 0.52);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ev-overview p {
    margin: 0;
    color: rgba(246, 243, 231, 0.82);
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .ev-signup-btn {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 600;
    color: rgba(62, 58, 43, 0.16);
    background: rgba(0, 0, 0, 0.06);
    padding: 0.55rem 1.3rem;
    border-radius: 8px;
    text-decoration: none;
    margin-bottom: 2rem;
    transition: background 0.15s, color 0.15s;
  }

  .ev-signup-btn:hover {
    background: rgba(0, 0, 0, 0.1);
    color: rgba(0, 0, 0, 0.75);
  }

  .ev-description {
    font-size: 0.95rem;
    line-height: 1.75;
    color: rgba(246, 243, 231, 0.78);
    margin-bottom: 2.5rem;
  }

  /* Speakers */
  .ev-speakers {
    margin-bottom: 2rem;
  }

  .ev-speakers-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(246, 243, 231, 0.52);
    margin: 0 0 0.85rem;
  }

  .ev-speaker-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .ev-speaker-card {
    display: flex;
    flex: 0 1 25rem;
    gap: 0.8rem;
    align-items: center;
    min-width: min(100%, 17rem);
    padding: 0.7rem;
    border: 1px solid rgba(246, 243, 231, 0.12);
    text-decoration: none;
    color: #f6f3e7;
    background: rgba(246, 243, 231, 0.05);
    border-radius: 999px;
  }
  .ev-speaker-card:hover {
    border-color: rgba(246, 243, 231, 0.32);
    background: rgba(246, 243, 231, 0.09);
  }

  .ev-speaker-img,
  .ev-speaker-placeholder {
    width: 4rem;
    height: 4rem;
    flex-shrink: 0;
    object-fit: cover;
    object-position: center top;
    display: block;
    border-radius: 50%;
    background: rgba(246, 243, 231, 0.1);
  }

  .ev-speaker-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.25rem;
    padding: 0 0.65rem 0 0;
    min-width: 0;
  }

  .ev-speaker-name {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.25;
    word-break: break-word;
    color: #f6f3e7;
  }

  .ev-speaker-role {
    font-size: 0.8rem;
    color: rgba(246, 243, 231, 0.62);
    line-height: 1.45;
    word-break: break-word;
  }

  @media (max-width: 600px) {
    .ev-speaker-card {
      flex-basis: 100%;
      border-radius: 18px;
    }
    .ev-speaker-img,
    .ev-speaker-placeholder {
      width: 3.5rem;
      height: 3.5rem;
    }
    .ev-meta {
      gap: 1rem;
    }
    .ev-meta-divider {
      display: none;
    }
  }
</style>
