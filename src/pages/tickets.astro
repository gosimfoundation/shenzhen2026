---
// Components
import Layout from "layouts/LayoutLanding.astro"
import HeroText from "components/HeroText.astro"
import Button from "components/Button.astro"
import { eventSummary } from "utils/event-summary"

import ConferenceThanks from "components/ConferenceThanks.astro"

const copy = eventSummary.en
---

<Layout
  title={`${copy.closedTitle} – GOSIM Shenzhen 2026`}
  description={copy.closedDescription}
  navDarkMode={true}
  navBackground="header-home"
  pageTransitionName="Tickets"
>
  <HeroText
    title={copy.closedTitle}
    text={copy.closedDescription}
    lightgray
  />

  <div class="archive-actions">
    <Button text="View Schedule" link="/schedule/" class="btn light xl btn-hover" />
    <Button text="View Speakers" link="/speakers/" class="btn light xl btn-hover" />
  </div>

  <ConferenceThanks lang="en" />
</Layout>

<style>
  .archive-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 1rem; padding: 2rem 1.25rem; background: #100e09; }
</style>
