---
// Components
import Layout from "layouts/LayoutLanding.astro"
import Hero from "components/Hero.astro"
import ProgramSection from "components/ProgramSection.astro"
import CoLocatedEventFeature from "components/CoLocatedEventFeature.astro"
import VenueDetails from "components/VenueDetails.astro"
import EventGallery from "components/EventGallery.astro"
import PreviousEvents from "components/PreviousEvents.astro"
import GetTickets from "components/GetTickets.astro"
import ProudlySupported from "components/ProudlySupported.astro"

// Images
import GosimShanghai from "images/homepage/gosim-shanghai.png"
import GosimDelft from "images/homepage/gosim-delft.png"
import GosimBeijing from "images/homepage/gosim-beijing.png"
import GosimParis from "images/homepage/gosim-paris-min.png"
import GosimHangzhou from "images/homepage/gosim-hangzhou.png"
import GosimParis2026 from "images/homepage/gosim-paris-2026.jpg"
---

<Layout
  title="GOSIM Shenzhen 2026"
  description="GOSIM Shenzhen 2026 — open-source AI, robotics, edge systems, and developer infrastructure. October 16-17, 2026 at ADEN Hotel Shenzhen Nanshan."
  navDarkMode={true}
  navBackground="header-home"
  pageTransitionName="Home"
>
  <Hero
    date="October 16-17, 2026"
    location="ADEN Hotel · Shenzhen"
    subtitle="The Premier Open Source Summit"
    description="150+ international speakers and 2,000+ developers gather for keynotes, technical forums, workshops, hackathons, and live open-source demos."
    video="/videos/shenzhen-hero-compressed.mp4"
    poster="/videos/shenzhen-hero-poster.jpg"
    links={[
      {
        text: "Call for Proposals",
        link: "https://cfp.gosim.org",
        openInNewTab: true,
        class: "btn light xl btn-hover",
      },
      {
        text: "Buy Tickets",
        link: "/tickets",
        openInNewTab: false,
        class: "btn primary xl btn-hover",
      },
    ]}
  />

  <ProudlySupported lead="Proudly supported by" emphasis="industry pioneers" />

  <ProgramSection
    eyebrow="GOSIM SHENZHEN 2026 / OCTOBER 16-17 / ADEN HOTEL, SHENZHEN"
    headlineLines={[
      "Where Open Source Meets",
      "China's Capital Of Innovation",
    ]}
    accentLine={0}
    body="Shenzhen is the heart of China's tech innovation — its youthful population and fearless founders, woven together with the world's densest software-and-hardware supply chain, power the relentless 'Shenzhen speed.'"
    facetsTitle="Across The Program"
    facets={[
      {
        title: "Agentic AI",
        keywords: ["Multi-Agent Collaboration", "Agent Engineering", "MCP", "A2A", "Agentic Apps", "AI-Native Development"],
      },
      {
        title: "Open Source Robotics",
        keywords: ["Embodied AI", "Humanoid Robots", "Dexterous Manipulation", "Motion Control", "Sim-to-Real Training", "Autonomous Navigation"],
      },
      {
        title: "Open Source Models & Infra",
        keywords: ["Large Language Models", "Code Models", "Vision Models", "Multimodal Models", "Speech & Audio", "Video Generation", "World Models"],
      },
      {
        title: "Spotlight & Hackathons",
        keywords: ["Robotics Challenge", "Agentic Builds", "Project Demos", "Live Showcase"],
      },
    ]}
    tracksTitle="Tracks"
    tracksIntro="From open source models and agent frameworks to robotics and edge AI, the program is built to show where the stack is moving next and let developers get close to the people building it. Full schedule coming soon."
    tracks={[
      {
        title: "Agentic AI Summit",
        text: "The strategy layer of the agentic wave: protocols, software patterns, tooling, and business models. Follow MCP, A2A, sovereign AI, AI-native development, and the emerging playbook for open-source agents.",
        link: "/schedule/#agentic-ai-summit",
      },
      {
        title: "Agentic AI on Edge",
        text: "On-device AI is experiencing a performance awakening, with agentic AI rapidly infiltrating edge devices. This track focuses on deploying powerful AI models in resource-constrained environments, diving deep into engineering practices for on-device inference acceleration, model compression, and real-time decision-making.",
        link: "/schedule/#agentic-ai-on-edge",
      },
      {
        title: "Agentic OS & App",
        text: "As AI agents become the new interface between humans and machines, a new operating system layer is emerging to orchestrate them. This track explores the architecture, frameworks, and platforms powering agentic operating systems and applications — from multi-agent coordination and runtime environments to intent-driven AI-native apps.",
        link: "/schedule/#ai-generative-app",
      },
      {
        title: "Open Source Models & Infra",
        text: "Open models are advancing quickly across language, vision, audio, and video. This track follows the latest breakthroughs, practical deployments, and the new capabilities emerging from the open model ecosystem.",
        link: "/schedule/#open-source-model",
      },
      {
        title: "Open Source Robotics",
        text: "Where agentic software meets physical systems. Explore open robotics platforms, embodied AI stacks, and hands-on methods for building autonomous machines that can perceive, plan, and act.",
        link: "/schedule/#open-source-robotics",
      },
      {
        title: "Agentic Device",
        text: "From AI-native phones and wearables to new personal computing form factors, this track focuses on the devices that make agents tangible. Explore hardware-software co-design, multimodal sensing, persistent context, voice-first interaction, and secure on-device action — turning AI from an app into the interface of the device itself.",
        link: "/schedule/#agentic-device",
      },
    ]}
    highlightsTitle="Spotlight & Hackathons"
    highlights={[
      {
        badge: "Spotlight",
        status: "Global open call",
        title: "Spotlight Shenzhen 2026: Next-Gen AI-Native Products",
        titleLines: ["Spotlight Shenzhen 2026:", "Next-Gen AI-Native Products"],
        text: "A global open call for next-generation AI-native products, followed by a focused Shenzhen build sprint and a live showcase at GOSIM Shenzhen 2026.",
        link: "https://spotlight.gosim.org/shenzhen2026/",
        linkLabel: "Explore Spotlight",
      },
      {
        badge: "OAIC Hackathon",
        status: "Registration opens soon",
        title: "International Hackathon for Agentic Factory",
        text: "A global Harness Engineering competition with an online qualifier and Grand Challenge leading to Demo Day at GOSIM Shenzhen 2026.",
        link: "https://create.gosim.org/factory26/",
        linkLabel: "View hackathon",
      },
    ]}
    enterLabel="Learn more"
  />

  <CoLocatedEventFeature
    id="rustchinaconf"
    eyebrow="Co-located Event"
    title="RustChinaConf 2026 · Shenzhen"
    theme="Rust and AI"
    dateLabel="Conference dates"
    date="October 15–17, 2026"
    text="Alongside GOSIM Shenzhen 2026, RustChinaConf brings the Rust community together to explore Rust for AI, AI for Rust, and lessons from Rust in production."
    image="https://rustchinaconf.org/hero/rustchinaconf-shenzhen-2026-banner.png"
    imageAlt="RustChinaConf 2026 Shenzhen banner"
    link="https://rustchinaconf.org"
    linkLabel="Explore RustChinaConf"
  />

  <VenueDetails
    eyebrow="Conference Venue"
    title="ADEN Hotel Shenzhen Nanshan"
    venueName="Meet Us in Shenzhen"
    address="No. 8 Guishan Road, Shekou, Nanshan District, Shenzhen"
    description="Set in Shekou, the conference venue is about 700 metres from Sea World Metro Station, served by Lines 2, 8 and 12, with easy access to Shenzhen's metro network and waterfront district."
    image="/images/venue/aden-hotel-shenzhen-nanshan.jpg"
    imageAlt="ADEN Hotel Shenzhen Nanshan at night"
    link="/venue/"
    linkLabel="Explore the venue"
  />

  <EventGallery
    title="The GOSIM Experience"
    albums={[
      {
        label: "GOSIM Paris 2026",
        images: [
          { src: "/images/homepage/gallery2026/paris2026-01.jpg", alt: "GOSIM Paris 2026 event photo" },
          { src: "/images/homepage/gallery2026/paris2026-02.jpg", alt: "GOSIM Paris 2026 event photo" },
          { src: "/images/homepage/gallery2026/paris2026-03.jpg", alt: "GOSIM Paris 2026 event photo" },
          { src: "/images/homepage/gallery2026/paris2026-04.jpg", alt: "GOSIM Paris 2026 event photo" },
          { src: "/images/homepage/gallery2026/paris2026-06.jpg", alt: "GOSIM Paris 2026 event photo" },
          { src: "/images/homepage/gallery2026/paris2026-07.jpg", alt: "GOSIM Paris 2026 event photo" },
          { src: "/images/homepage/gallery2026/paris2026-08.jpg", alt: "GOSIM Paris 2026 event photo" },
          { src: "/images/homepage/gallery2026/paris2026-09.jpg", alt: "GOSIM Paris 2026 event photo" },
        ],
      },
      {
        label: "GOSIM Hangzhou 2025",
        images: [
          { src: "/images/homepage/gallery2025/hangzhou2025-01.jpg", alt: "GOSIM Hangzhou 2025 event photo" },
          { src: "/images/homepage/gallery2025/hangzhou2025-02.jpg", alt: "GOSIM Hangzhou 2025 event photo" },
          { src: "/images/homepage/gallery2025/hangzhou2025-03.jpg", alt: "GOSIM Hangzhou 2025 event photo" },
          { src: "/images/homepage/gallery2025/hangzhou2025-04.jpg", alt: "GOSIM Hangzhou 2025 event photo" },
          { src: "/images/homepage/gallery2025/hangzhou2025-05.jpg", alt: "GOSIM Hangzhou 2025 event photo" },
          { src: "/images/homepage/gallery2025/hangzhou2025-07.jpg", alt: "GOSIM Hangzhou 2025 event photo" },
          { src: "/images/homepage/gallery2025/hangzhou2025-08.jpg", alt: "GOSIM Hangzhou 2025 event photo" },
          { src: "/images/homepage/gallery2025/hangzhou2025-09.jpg", alt: "GOSIM Hangzhou 2025 event photo" },
        ],
      },
    ]}
  />

  <PreviousEvents
    title="Previous Events"
    events={[
      {
        title: "GOSIM Paris 2026",
        date: "May 5–6, 2026",
        description: "GOSIM Paris 2026 brought the agentic AI convergence to STATION F, gathering speakers and open-source builders from around the world for two days of talks and workshops.",
        image: GosimParis2026,
        link: "https://paris2026.gosim.org/",
      },
      {
        title: "GOSIM Hangzhou",
        date: "September 13–14, 2025",
        description: "GOSIM Hangzhou brought together open-source AI builders and contributors for a full day of talks, workshops, and community connection.",
        image: GosimHangzhou,
        link: "https://hangzhou2025.gosim.org/",
      },
      {
        title: "GOSIM AI Paris 2025",
        date: "May 6–7, 2025",
        description: "GOSIM AI Paris 2025 united open-source AI pioneers at STATION F, bringing together speakers and builders from across the globe.",
        image: GosimParis,
        link: "https://paris2025.gosim.org/",
      },
      {
        title: "GOSIM Beijing",
        date: "October 17–18, 2024",
        description: "The GOSIM Beijing conference attracted more than 1,700 attendees, making it the largest GOSIM event so far.",
        image: GosimBeijing,
        link: "https://china2024.gosim.org/",
      },
      {
        title: "GOSIM Delft",
        date: "June 6–7, 2024",
        description: "GOSIM Delft was a two-day event that brought together 1,200 attendees from around the world.",
        image: GosimDelft,
        link: "https://europe2024.gosim.org/",
      },
      {
        title: "GOSIM Shanghai",
        date: "September 23–24, 2023",
        description: "The GOSIM conference and workshop focused on championing and enhancing open-source contributions.",
        image: GosimShanghai,
        link: "https://conference2023.gosim.org/",
      },
    ]}
  />

  <GetTickets
    title="Call for Proposals Now Open"
    location="ADEN Hotel Shenzhen Nanshan"
    date="October 16-17, 2026"
    text="We're looking for bold ideas and fresh voices in open-source AI, robotics, edge systems, and developer infrastructure. Submit a proposal to speak at GOSIM Shenzhen 2026."
    ctaButton={{
      text: "Submit a Proposal",
      link: "https://cfp.gosim.org",
      openInNewTab: true,
    }}
  />
</Layout>
