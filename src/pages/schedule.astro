---
// Components
import Layout from "layouts/LayoutLanding.astro";
import GetTickets from "components/GetTickets.astro";
import HeroText from "components/HeroText.astro";
import ScheduleTracks from "components/ScheduleTracks.astro";
---

<Layout
  title="Schedule – GOSIM Shenzhen 2026"
  description="GOSIM Shenzhen 2026 is a gathering of open-source AI projects, developers, researchers, and industry sponsors to share knowledge, learn from each other, and collaborate."
  navBackground="light"
  pageTransitionName="Schedule"
>
  <HeroText title="Schedule" lightgray />

  <ScheduleTracks currentDay="October 16" lang="en" speakerBasePath="/speakers/" />

  <GetTickets
    title="Call for Proposals Now Open"
    location="Shenzhen, China"
    date="October 16-17, 2026"
    text="We're looking for bold ideas and fresh voices in open-source AI, robotics, edge systems, and developer infrastructure. Submit a proposal to speak at GOSIM Shenzhen 2026."
    ctaButton={{
      text: "Submit a Proposal",
      link: "https://cfp.gosim.org",
      openInNewTab: true,
    }}
  />
</Layout>
