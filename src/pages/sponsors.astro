---
// Components
import Layout from "layouts/LayoutLanding.astro"
import GetTickets from "components/GetTickets.astro"
import HeroText from "components/HeroText.astro"
import AllSponsors from "components/Sponsors.astro"
import PastSponsors from "components/PastSponsors.astro"
---

<Layout
  title="Sponsors – GOSIM Shenzhen 2026"
  description="Meet the sponsors and supporting organizations helping make GOSIM Shenzhen 2026 possible."
  navDarkMode={true}
  navBackground="header-home"
  pageTransitionName="Sponsors"
>
  <HeroText
    title="Sponsors"
    text="We're excited to bring you an incredible experience, made possible by the generous support of our Sponsors and Supporting Organizations. We've partnered with true innovators that are pushing the boundaries of our industry."
    lightgray
  />

  <AllSponsors />

  <GetTickets
    title="Call for Proposals Now Open"
    location="ADEN Hotel Shenzhen Nanshan"
    date="October 16-17, 2026"
    text="We're looking for bold ideas and fresh voices in open-source AI, robotics, edge systems, and developer infrastructure. Submit a proposal to speak at GOSIM Shenzhen 2026."
    ctaButton={{
      text: "Submit a Proposal",
      link: "https://cfp.gosim.org",
      openInNewTab: true,
    }}
  />

  <PastSponsors
    title="Past Sponsors (Partial)"
    intro="A selection of organizations that have supported previous GOSIM events around the world."
    contactText="Interested in sponsoring GOSIM Shenzhen 2026? We'd love to hear from you."
    excludeImages={["csdn.png", "kaiyuanshe.png"]}
  />
</Layout>
