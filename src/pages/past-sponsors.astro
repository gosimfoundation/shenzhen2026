import Layout from "layouts/LayoutLanding.astro"
import ConferenceThanks from "components/ConferenceThanks.astro"
import HeroText from "components/HeroText.astro"
import PastSponsors from "components/PastSponsors.astro"
---

<Layout
  title="Past Sponsors – GOSIM Shenzhen 2026"
  description="The organizations who have powered GOSIM events around the world."
  navDarkMode={true}
  navBackground="header-home"
  pageTransitionName="Past Sponsors"
>
  <HeroText
    title="Past Sponsors (Partial)"
    text="GOSIM events around the world have been powered by an incredible community of sponsors and partners. Below is a selection of them — this is a partial list, not every past sponsor is shown."
    lightgray
  />

  <PastSponsors
    title=""
    intro=""
    contactText="Interested in partnering with future GOSIM events? We'd love to hear from you."
    email="support@gosim.org"
  />

  <ConferenceThanks lang="en" />
</Layout>
