---
// Components
import Button from "components/Button.astro";
import Logo from "./Logo.astro";
import NotificationBar from "components/NotificationBar.astro";

const hasNotificationBar = false; // Set this to false when NotificationBar is removed or page will crash

const slug = Astro.url.pathname;
const isZhPath = slug.startsWith("/zh/");
const isFrPath = slug.startsWith("/fr/");
const basePath = isZhPath ? slug.replace(/^\/zh/, "") : isFrPath ? slug.replace(/^\/fr/, "") : slug;
const switchPath = isZhPath ? slug.replace("/zh/", "/") : `/zh${slug}`;

// 只有讲师列表提供移动端筛选面板；其他页面不渲染无效按钮。
const hasFilter = basePath === "/speakers/";

const links = [
  {
    text: "议程安排",
    link: "/zh/schedule/",
  },
  {
    text: "讲师",
    link: "/zh/speakers/",
  },
  {
    text: "赞助商",
    link: "/zh/sponsors/",
  },
  {
    text: "同期活动",
    subLinks: [
      {
        text: "Spotlight",
        link: "https://spotlight.gosim.org/zh/shenzhen2026/",
        openInNewTab: true,
      },
      {
        text: "AI Vision Forum · AI 愿景论坛",
        link: "https://shenzhen2026.visionforum.ai/zh-cn/",
        openInNewTab: true,
      },
      {
        text: "OAIC 智能体工厂黑客松",
        link: "https://create.gosim.org/factory26/",
        openInNewTab: true,
      },
      {
        text: "RustChinaConf 2026",
        link: "https://rustchinaconf.org/zh-CN/",
        openInNewTab: true,
      },
    ],
  },
  {
    text: "志愿者",
    link: "/zh/volunteers/",
  },
  {
    text: "大会地点",
    link: "/zh/venue/",
  },
];

const normalizePath = (path: string) => path === "/" ? "/" : path.replace(/\/$/, "");
const currentPath = normalizePath(slug);
const isNavigationLinkActive = (link?: string) => {
  if (!link?.startsWith("/")) return false;
  const linkPath = normalizePath(link);
  return currentPath === linkPath || currentPath.startsWith(`${linkPath}/`);
};
---

<header>
  {
    hasNotificationBar && (
      <NotificationBar
        text="🎉 参加GOSIM门票 🎟 幸运抽奖！ ✨"
        link="https://x.com/gosimfoundation/status/1912744752925282408"
      />
    )
  }

  <div class="mobile-nav">
    <div class="overlay overlay-dark" data-navigation-toggle="close"></div>

    <div class="mobile-nav-box">
      <div class="box-row box-row-logo">
        <a href="/zh/" aria-label="前往首页" class="logo-click">
          <Logo />
        </a>
      </div>
      <nav class="box-row box-row-nav" aria-label="Navigation Mobile">
        <ul>
          {
            links.map((loop) => (
              <li
                class={`link link-hover ${loop.subLinks ? "has-sublinks" : ""}`}
                data-barba-update
                data-link-status={isNavigationLinkActive(loop.link) ? "active" : "not-active"}
                data-has-sublinks={loop.subLinks ? "true" : "false"}
                data-sublinks={
                  loop.subLinks ? JSON.stringify(loop.subLinks) : "[]"
                }
              >
                {loop?.subLinks ? (
                  <button class="link-click" aria-expanded="false">
                    <span>{loop.text}</span>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="ml-2 inline-block"
                    >
                      <path d="m6 9 6 6 6-6" />
                    </svg>
                  </button>
                ) : (
                  <a class="link-click" href={loop.link} aria-current={isNavigationLinkActive(loop.link) ? "page" : undefined} target={loop.openInNewTab ? "_blank" : undefined} rel={loop.openInNewTab ? "noopener noreferrer" : undefined}>
                    <span>{loop.text}</span>
                  </a>
                )}
              </li>
            ))
          }
          <li class="link link-hover mobile-language-item">
            <div class="language-mobile-menu">
              <a
                class="language-item active"
                href={`/zh${basePath}`}
                onclick="localStorage.setItem('language_preference', 'zh')"
                >中文</a
              >
              <a
                class="language-item"
                href={basePath}
                onclick="localStorage.setItem('language_preference', 'en'); sessionStorage.setItem('language_just_switched', 'true');"
                >English</a
              >
            </div>
          </li>
        </ul>
      </nav>
      <div class="box-row box-row-btn">
        <Button
          text="CFP 议题征集"
          link="https://cfp.gosim.org"
          openInNewTab={true}
          class="btn light xl btn-hover"
        />
        <Button
          text="购票"
          link="https://www.bagevent.com/event/gosimshenzhen2026#website_moduleId_1164696"
          openInNewTab={true}
          class="btn primary glass-orange xl btn-hover"
        />
      </div>
    </div>
  </div>

  <div class="floating-controls">
    <button
      class="hamburger btn-floating"
      aria-label="Open menu"
      aria-expanded="false"
      data-navigation-toggle="toggle"
      data-has-notification={hasNotificationBar}
    >
      <div class="hamburger-fill"></div>
      <div class="bar bar-top"></div>
      <div class="bar bar-bottom"></div>
    </button>

    <div class="floating-ticket-button">
      <Button
        text="购票"
        link="https://www.bagevent.com/event/gosimshenzhen2026#website_moduleId_1164696"
        openInNewTab={true}
        class="btn primary glass-orange btn-floating btn-hover"
      />
    </div>

    {hasFilter && (
      <button
        type="button"
        aria-label="打开讲师筛选"
        aria-expanded="false"
        class="btn primary glass-orange btn-floating btn-filter btn-filter-floating btn-hover"
        data-has-notification={hasNotificationBar}
      >
        <div class="btn-click" data-filter-toggle="toggle">
          <div class="btn-content duplicate">
            <div class="btn-fill"></div>
            <span>筛选</span>
          </div>
          <div class="border-box"></div>
        </div>
      </button>
    )}
  </div>

  <div
    class="main-nav-bar"
    style="opacity: 1;"
    data-has-notification={hasNotificationBar}
  >
    <div class="overlay nav-fill"></div>
    <div class="row">
      <div class="border-bottom"></div>

      <div class="logo">
        <a href="/zh/" aria-label="前往首页" class="logo-click">
          <Logo />
          <Logo />
        </a>
      </div>

      <nav aria-label="Navigation Desktop">
        <ul>
          {
            links.map((loop) => (
              <li
                class={`link link-hover ${loop.subLinks ? "has-sublinks" : ""}`}
                style="position: relative;"
                data-barba-update
                data-link-status={isNavigationLinkActive(loop.link) ? "active" : "not-active"}
                data-has-sublinks={loop.subLinks ? "true" : "false"}
                data-sublinks={
                  loop.subLinks ? JSON.stringify(loop.subLinks) : "[]"
                }
              >
                {loop?.subLinks ? (
                  <button class="link-click" aria-expanded="false">
                    <span>{loop.text}</span>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="ml-2 inline-block"
                    >
                      <path d="m6 9 6 6 6-6" />
                    </svg>
                  </button>
                ) : (
                  <a class="link-click" href={loop.link} aria-current={isNavigationLinkActive(loop.link) ? "page" : undefined} target={loop.openInNewTab ? "_blank" : undefined} rel={loop.openInNewTab ? "noopener noreferrer" : undefined}>
                    <span>{loop.text}</span>
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="header-buttons">
        <div class="language-dropdown">
          <button class="language-btn" aria-label="选择语言" aria-expanded="false">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path
                d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
              ></path>
            </svg>
          </button>
          <div class="language-dropdown-content">
            <a
              href={`/zh${basePath}`}
              class="active"
              onclick="localStorage.setItem('language_preference', 'zh')"
              >中文</a
            >
            <a
              href={basePath}
              onclick="localStorage.setItem('language_preference', 'en'); sessionStorage.setItem('language_just_switched', 'true');"
              >English</a
            >
          </div>
        </div>
        <Button
          text="CFP 议题征集"
          link="https://cfp.gosim.org"
          openInNewTab={true}
          class="btn light btn-hover"
        />
        <Button
          text="购票"
          link="https://www.bagevent.com/event/gosimshenzhen2026#website_moduleId_1164696"
          openInNewTab={true}
          class="btn primary glass-orange btn-hover"
        />
      </div>
      <button class="hamburger outline" type="button" aria-label="打开菜单" aria-expanded="false" data-navigation-toggle="toggle">
        <div class="hamburger-fill"></div>
        <div class="bar bar-top"></div>
        <div class="bar bar-bottom"></div>
      </button>

      {hasFilter && (
        <button class="btn primary glass-orange btn-filter btn-filter-static btn-hover" type="button" aria-label="打开讲师筛选" aria-expanded="false">
          <div class="btn-click" data-filter-toggle="toggle">
            <div class="btn-content duplicate">
              <div class="btn-fill"></div>
              <span>筛选</span>
            </div>
            <div class="border-box"></div>
          </div>
        </button>
      )}
    </div>
  </div>
</header>

<style>
  .floating-ticket-button {
    position: relative;
    z-index: 201;
  }

  .floating-ticket-button :global(.btn-floating) {
    position: relative;
    top: auto;
    right: auto;
  }

  /* Ensure notification bar is clickable */
  :global(.notification-bar) {
    position: relative;
    z-index: 20; /* Higher than other header elements */
    width: 100%;
    pointer-events: auto;
  }

  .main-nav-bar[data-has-notification="true"] {
    padding-top: calc(var(--row-gap) + 45px);
  }

  .hamburger.btn-floating[data-has-notification="true"],
  .btn.btn-filter-floating[data-has-notification="true"] {
    margin-top: 32px;
  }

  /* Language dropdown styles */
  .header-buttons {
    display: flex;
    align-items: center;
    gap: 15px;
    color: inherit; /* Ensure header buttons inherit text color for icon */
  }

  .language-dropdown {
    position: relative;
    display: inline-block;
    color: inherit; /* Inherit text color from parent */
  }

  .language-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    transition: color 0.3s ease;
  }

  /* Ensure the globe icon inherits the text color */
  .language-btn svg {
    color: inherit;
    stroke: currentColor;
    transition: color 0.3s;
  }

  .language-dropdown-content {
    display: none;
    position: absolute;
    background-color: #f9f9f9;
    min-width: 120px;
    box-shadow: 0px 8px 16px 0px rgba(0, 0, 0, 0.2);
    z-index: 1;
    border-radius: 4px;
    right: 0;
  }

  .language-dropdown-content a {
    color: black;
    padding: 12px 16px;
    text-decoration: none;
    display: block;
    text-align: left;
  }

  .language-dropdown-content a:hover {
    background-color: #f1f1f1;
  }

  .language-dropdown-content a.active {
    font-weight: bold;
    background-color: #e9e9e9;
  }

  .language-dropdown:hover .language-dropdown-content {
    display: block;
  }

  /* Mobile language menu */
  .mobile-language-item {
    margin-top: 15px;
  }

  .language-mobile-menu {
    display: flex;
    justify-content: center;
    gap: 15px;
    padding: 10px 0;
  }

  .language-item {
    padding: 5px 10px;
    border-radius: 4px;
    text-decoration: none;
  }

  .language-item.active {
    font-weight: bold;
    background-color: rgba(255, 255, 255, 0.1);
  }
  @media screen and (max-width: 1070px) {
    .main-nav-bar .row {
      display: grid;
      grid-template-columns: auto auto minmax(0, 1fr) auto auto;
      column-gap: clamp(0.4rem, 1.4vw, 0.8rem);
    }

    .main-nav-bar .logo {
      grid-column: 1;
    }

    .main-nav-bar nav {
      display: none;
    }

    .header-buttons {
      position: relative;
      grid-column: 2;
      gap: 0;
    }

    .language-dropdown {
      position: relative;
      left: auto;
    }

    .main-nav-bar .btn-filter-static {
      position: relative;
      top: auto;
      right: auto;
      grid-column: 4;
      grid-row: 1;
      justify-self: end;
    }

    .main-nav-bar .hamburger.outline {
      grid-column: 5;
      grid-row: 1;
      justify-self: end;
    }
  }

  /* Keep the expanded navigation clear of the desktop CTAs on narrower
     laptop viewports. The CFP action remains available in the mobile menu. */
  @media screen and (min-width: 1071px) and (max-width: 1300px) {
    .header-buttons :global(.btn.light) {
      display: none;
    }
  }
</style>
