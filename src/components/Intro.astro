---
interface Facet {
  title: string;
  text: string;
}

interface Props {
  eyebrow: string;
  headlineLines: string[];
  accentLine?: number;
  body: string;
  facetsTitle?: string;
  facets?: Facet[];
  signals?: string[];
  projectsLabel?: string;
  projects?: string[];
}

const {
  eyebrow,
  headlineLines,
  accentLine = 1,
  body,
  facetsTitle = "Why Shenzhen 2026",
  facets = [],
  signals = [],
  projectsLabel = "Featuring the teams behind",
  projects = [],
} = Astro.props;
---

<section
  class="section section-home-intro"
  data-theme-section="light"
  data-bg-section="light"
>
  <div class="container">
    <div class="row">
      <div class="col">
        <div class="intro-stack">
          <div class="intro-hero animate-read">
            <div class="intro-hero-copy">
              <p class="intro-eyebrow">{eyebrow}</p>

              <div class="intro-headline-frame">
                <h3 class="intro-headline split-words">
                  {
                    headlineLines.map((line, index) => (
                      <span class={index === accentLine ? "intro-headline-line is-accent" : "intro-headline-line"}>
                        {line}
                      </span>
                    ))
                  }
                </h3>
              </div>

              <p class="intro-body">{body}</p>
            </div>

            {(signals.length > 0 || projects.length > 0) && (
              <div class="intro-meta">
                {signals.length > 0 && (
                  <div class="intro-signal-row">
                    {signals.map((signal) => <span class="intro-signal">{signal}</span>)}
                  </div>
                )}

                {projects.length > 0 && (
                  <div class="intro-project-block">
                    <p class="intro-project-label">{projectsLabel}</p>
                    <div class="intro-project-row">
                      {projects.map((project) => <span class="intro-project-chip">{project}</span>)}
                    </div>
                  </div>
                )}
              </div>
            )}
          </div>

          {facets.length > 0 && (
            <div class="intro-program animate-read" aria-label={facetsTitle}>
              <div class="intro-program-header">
                {facetsTitle && <p class="intro-program-title">{facetsTitle}</p>}
              </div>

              <div class="intro-facets-list">
                {facets.map((facet) => (
                  <article class="intro-facet-card">
                    <p class="intro-facet-title">{facet.title}</p>
                    <p class="intro-facet-text">{facet.text}</p>
                  </article>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-home-intro {
    background-color: transparent;
    z-index: 2;
    padding-top: calc(var(--section-padding) * 0.65);
    padding-bottom: calc(var(--section-padding) * 1.05);
  }

  .section-home-intro .row {
    justify-content: center;
  }

  .section-home-intro .col {
    max-width: min(100%, 86rem);
    justify-content: center;
  }

  .intro-stack {
    display: grid;
    gap: 1.35rem;
  }

  .intro-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    gap: 1.4rem;
    padding: clamp(1.55rem, 3vw, 2.85rem);
    border-radius: 2.2rem;
    border: 2px solid #0A0908;
    background:
      radial-gradient(circle at 12% 16%, rgba(248, 74, 16, 0.14), transparent 28%),
      radial-gradient(circle at 88% 16%, rgba(255, 122, 60, 0.12), transparent 22%),
      radial-gradient(circle at 76% 76%, rgba(255, 122, 60, 0.08), transparent 24%),
      linear-gradient(180deg, #201E16 0%, #201E16 46%, #201E16 100%);
    box-shadow: 10px 10px 0 rgba(10, 9, 8, 0.92);
  }

  .intro-hero::before,
  .intro-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .intro-hero::before {
    background:
      linear-gradient(132deg, rgba(255, 255, 255, 0.05), transparent 36%),
      linear-gradient(90deg, rgba(248, 74, 16, 0.95), rgba(255, 122, 60, 0.9) 52%, rgba(255, 122, 60, 0.95));
    background-size: 100% 100%, 100% 0.18rem;
    background-repeat: no-repeat;
    background-position: center center, top center;
    opacity: 0.96;
  }

  .intro-hero::after {
    background:
      radial-gradient(circle at 86% 28%, rgba(255, 122, 60, 0.1), transparent 16%),
      radial-gradient(circle at 18% 82%, rgba(248, 74, 16, 0.08), transparent 18%);
    opacity: 0.84;
  }

  .intro-hero-copy,
  .intro-meta,
  .intro-program {
    position: relative;
    z-index: 1;
  }

  .intro-hero-copy {
    display: grid;
    gap: 1.15rem;
    text-align: left;
  }

  .intro-eyebrow,
  .intro-project-label {
    margin: 0;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(234, 230, 210, 0.52);
  }

  .intro-headline-frame {
    position: relative;
    display: inline-grid;
    overflow: visible;
    width: auto;
    max-width: 58rem;
    justify-self: center;
    margin-inline: auto;
    padding: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
  }

  .intro-headline-frame::before,
  .intro-headline-frame::after {
    content: "";
    position: absolute;
    pointer-events: none;
  }

  .intro-headline-frame::before {
    display: none;
  }

  .intro-headline-frame::after {
    inset: 10% auto auto 50%;
    width: 36rem;
    height: 36rem;
    border-radius: 50%;
    background:
      radial-gradient(circle, rgba(255, 122, 60, 0.08), transparent 62%);
    transform: translateX(-50%);
    z-index: -1;
  }

  .intro-headline {
    margin: 0;
    display: grid;
    gap: 0.08em;
    text-align: center;
    font-size: clamp(2.9rem, 5.6vw, 6rem);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.03em;
    color: #EAE6D2;
  }

  .intro-headline-line {
    display: block;
  }

  .intro-headline-line.is-accent {
    background: linear-gradient(90deg, #F84A10 0%, #C23A0C 55%, #3F3C2D 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .intro-body {
    margin: 0;
    width: min(100%, 62rem);
    max-width: 62rem;
    margin-inline: auto;
    font-size: clamp(1.18rem, 1.02rem + 0.45vw, 1.42rem);
    font-weight: 500;
    line-height: 1.62;
    color: rgba(234, 230, 210, 0.82);
  }

  .intro-signal-row,
  .intro-project-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .intro-signal {
    display: inline-flex;
    align-items: center;
    min-height: 2.3rem;
    padding: 0.5rem 0.86rem;
    border-radius: 999px;
    border: 2px solid #0A0908;
    background: rgba(32, 30, 22, 0.92);
    color: rgba(234, 230, 210, 0.84);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    box-shadow: 0 8px 18px rgba(234, 230, 210, 0.14);
  }

  .intro-meta {
    display: grid;
    gap: 1rem;
    width: min(100%, 82rem);
    margin-inline: auto;
    padding: 1rem 1rem 1.1rem;
    border-radius: 1.5rem;
    border: 2px solid #0A0908;
    background: linear-gradient(180deg, rgba(32, 30, 22, 0.96), rgba(26, 24, 17, 0.94));
    box-shadow:
      0 14px 34px rgba(62, 58, 43, 0.16),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .intro-project-block {
    display: grid;
    gap: 0.8rem;
    padding-top: 1rem;
    border-top: 2px solid #0A0908;
  }

  .intro-project-chip {
    display: inline-flex;
    align-items: center;
    min-height: 2.15rem;
    padding: 0.45rem 0.92rem;
    border-radius: 999px;
    border: 2px solid #0A0908;
    background: rgba(168, 153, 104, 0.1);
    color: #EAE6D2;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .intro-program {
    position: relative;
    padding: clamp(1.45rem, 2.45vw, 2.45rem);
    border-radius: 2rem;
    border: 2px solid #0A0908;
    background: linear-gradient(180deg, rgba(32, 30, 22, 0.96), rgba(26, 24, 17, 0.94));
    box-shadow:
      0 22px 52px rgba(62, 58, 43, 0.16),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .intro-program::before,
  .intro-program::after {
    display: none;
  }

  .intro-program-header,
  .intro-facets-list {
    position: relative;
    z-index: 1;
  }

  .intro-program-header {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-bottom: 1.15rem;
    border-bottom: 0;
    text-align: center;
  }

  .intro-program-title {
    position: relative;
    display: inline-block;
    margin: 0;
    padding-bottom: 0.75rem;
    font-size: clamp(2rem, 2.2vw + 1.2rem, 3.25rem);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.04em;
    color: #EAE6D2;
  }

  .intro-program-title::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    left: 50%;
    width: 6rem;
    height: 0.24rem;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(248, 74, 16, 0.78), rgba(168, 153, 104, 0.74), rgba(255, 122, 60, 0.72));
    box-shadow: none;
    transform: translateX(-50%);
  }

  .intro-facets-list {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1rem;
    align-items: start;
    padding: 1.15rem 0 0.1rem;
  }

  .intro-facet-card {
    position: relative;
    display: grid;
    align-content: start;
    gap: 1rem;
    min-height: 13.25rem;
    padding: 1.55rem 1.48rem 1.42rem;
    border: 2px solid #0A0908;
    border-radius: 1.45rem;
    background: linear-gradient(180deg, rgba(32, 30, 22, 0.96), rgba(26, 24, 17, 0.94));
    box-shadow:
      0 14px 28px rgba(62, 58, 43, 0.16),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    transition:
      transform 220ms ease,
      box-shadow 220ms ease;
  }

  .intro-facet-card:nth-child(1) {
    grid-column: 1 / span 7;
    background: linear-gradient(180deg, rgba(32, 30, 22, 0.96), rgba(26, 24, 17, 0.94));
  }

  .intro-facet-card:nth-child(2) {
    grid-column: 8 / span 5;
    margin-top: 0.9rem;
    background: linear-gradient(180deg, rgba(32, 30, 22, 0.96), rgba(26, 24, 17, 0.94));
  }

  .intro-facet-card:nth-child(3) {
    grid-column: 1 / span 5;
    background: linear-gradient(180deg, rgba(32, 30, 22, 0.96), rgba(26, 24, 17, 0.94));
  }

  .intro-facet-card:nth-child(4) {
    grid-column: 6 / span 7;
    margin-top: 0.7rem;
    background: linear-gradient(180deg, rgba(32, 30, 22, 0.96), rgba(26, 24, 17, 0.94));
  }

  .intro-facet-card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 0.28rem;
    border-radius: 1.45rem 1.45rem 0 0;
    background: linear-gradient(90deg, rgba(248, 74, 16, 0.18), rgba(255, 122, 60, 0.12));
    opacity: 1;
  }

  .intro-facet-card::after {
    display: none;
  }

  .intro-facet-card:hover {
    transform: translateY(-0.16rem);
    box-shadow: 0 18px 32px rgba(234, 230, 210, 0.14);
  }

  .intro-facet-title,
  .intro-facet-text {
    margin: 0;
    position: relative;
    z-index: 1;
  }

  .intro-facet-title {
    max-width: 18rem;
    padding-top: 0.05rem;
    font-size: clamp(1.42rem, 1.1rem + 0.65vw, 1.9rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.94;
    color: #EAE6D2;
  }

  .intro-facet-text {
    max-width: 29rem;
    font-size: 1.04rem;
    font-weight: 500;
    line-height: 1.6;
    color: rgba(234, 230, 210, 0.76);
  }

  @media (max-width: 1080px) {
    .intro-body {
      width: 100%;
      max-width: none;
    }

    .intro-facets-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.15rem;
    }

    .intro-facet-card:nth-child(1),
    .intro-facet-card:nth-child(2),
    .intro-facet-card:nth-child(3),
    .intro-facet-card:nth-child(4) {
      grid-column: auto;
      margin-top: 0;
    }
  }

  @media (max-width: 980px) {
    .intro-facets-list {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding-bottom: 0;
    }

    .intro-facet-card,
    .intro-facet-card:nth-child(1),
    .intro-facet-card:nth-child(2),
    .intro-facet-card:nth-child(3),
    .intro-facet-card:nth-child(4) {
      min-height: auto;
      margin-top: 0;
      border-radius: 1.2rem;
    }

    .intro-facet-card:hover {
      transform: translateY(-0.14rem);
    }
  }

  @media (max-width: 640px) {
    .section-home-intro {
      padding-top: calc(var(--section-padding) * 1.05);
    }

    .intro-hero,
    .intro-program,
    .intro-headline-frame {
      border-radius: 1.5rem;
    }

    .intro-hero,
    .intro-program {
      padding: 1.25rem;
    }

    .intro-meta {
      padding: 0.9rem;
    }

    .intro-program-header {
      align-items: center;
    }

    .intro-program-title {
      letter-spacing: -0.02em;
      line-height: 0.96;
    }

    .intro-body {
      font-size: 1.02rem;
      line-height: 1.66;
    }
  }
</style>
