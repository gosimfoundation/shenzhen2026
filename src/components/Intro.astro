---
interface Facet {
  title: string;
  text?: string;
  keywords?: string[];
}

interface Props {
  eyebrow: string;
  headlineLines: string[];
  accentLine?: number;
  body: string;
  facetsTitle?: string;
  facets?: Facet[];
  signals?: string[];
  projectsLabel?: string;
  projects?: string[];
}

const {
  eyebrow,
  headlineLines,
  accentLine = 1,
  body,
  facetsTitle = "Why Shenzhen 2026",
  facets = [],
  signals = [],
  projectsLabel = "Featuring the teams behind",
  projects = [],
} = Astro.props;

// Split a facet's text into keyword terms when an explicit keywords array isn't given
const splitKeywords = (text?: string): string[] =>
  (text || "")
    .replace(/[。.]+$/u, "")
    .split(/[、，,]|—|\band\b|与/u)
    .map((t) => t.trim())
    .filter((t) => t.length > 0 && t.length <= 24);

const isZh = Astro.url.pathname.startsWith("/zh");

// Ambient open-source / GOSIM / AI vocabulary that fills out the cloud as faint background depth
const ambientWords = isZh
  ? [
      "开源", "人工智能", "开发者", "社区", "协作", "创新", "构建者", "生态",
      "前沿", "研究", "推理", "多模态", "基础模型", "大模型", "运行时", "算力",
      "端侧", "主权 AI", "互操作", "黑客松", "工作坊", "全球", "未来", "机器人",
      "边缘", "智能体", "开放", "贡献", "落地", "部署", "协议", "标准",
    ]
  : [
      "Open Source", "AI", "Developers", "Community", "Collaboration", "Innovation",
      "Builders", "Ecosystem", "Frontier", "Research", "Inference", "Multimodal",
      "Foundation Models", "Reasoning", "Runtime", "Compute", "On-Device", "Sovereign AI",
      "Interoperability", "Hackathon", "Workshops", "Global", "Future", "Rust",
      "WebAssembly", "RISC-V", "Robotics", "Edge", "Agents", "Open Models", "Scale", "Deploy",
    ];

// Deterministic pseudo-random in [0,1) from an integer seed (SSR-safe; no Math.random)
const prand = (i: number): number => {
  const x = Math.sin((i + 1) * 12.9898) * 43758.5453;
  return x - Math.floor(x);
};

// Per-tier size (rem) and opacity ranges — drives the layered depth
const TIERS: Record<string, { sMin: number; sMax: number; oMin: number; oMax: number }> = {
  hero:    { sMin: 2.3, sMax: 3.6, oMin: 1,    oMax: 1 },
  key:     { sMin: 1.15, sMax: 2,  oMin: 0.6,  oMax: 0.95 },
  ambient: { sMin: 0.78, sMax: 1.25, oMin: 0.14, oMax: 0.42 },
};

// Build the full term list: facet titles (hero) + their keywords (key) + ambient filler
const rawTerms: Array<{ text: string; tier: keyof typeof TIERS }> = [
  ...facets.flatMap((facet) => {
    const keywords = facet.keywords && facet.keywords.length > 0
      ? facet.keywords
      : splitKeywords(facet.text);
    return [
      { text: facet.title, tier: "hero" as const },
      ...keywords.map((k) => ({ text: k, tier: "key" as const })),
    ];
  }),
  ...ambientWords.map((w) => ({ text: w, tier: "ambient" as const })),
];

// Assign deterministic size / opacity / float motion, then scatter the order pseudo-randomly
const cloudTerms = rawTerms
  .map((t, i) => {
    const tier = TIERS[t.tier];
    const r1 = prand(i * 5 + 1);
    const r2 = prand(i * 5 + 2);
    const r3 = prand(i * 5 + 3);
    const r4 = prand(i * 5 + 4);
    const r5 = prand(i * 5 + 5);
    const dur = 5.5 + r3 * 4; // 5.5–9.5s (≈40% slower)
    return {
      ...t,
      size: (tier.sMin + r1 * (tier.sMax - tier.sMin)).toFixed(2),
      op: (tier.oMin + r2 * (tier.oMax - tier.oMin)).toFixed(2),
      amp: Math.round(11 + r4 * 12), // vertical travel 11–23px
      ampX: Math.round(7 + r5 * 13), // horizontal drift 7–20px
      dur: dur.toFixed(1),
      delay: (r5 * dur).toFixed(1),
      sort: r4,
    };
  })
  .sort((a, b) => a.sort - b.sort);
---

<section
  class="section section-home-intro"
  data-theme-section="light"
  data-bg-section="light"
>
  <div class="container">
    <div class="row">
      <div class="col">
        <div class="intro-stack">
          <div class="intro-hero animate-read">
            <div class="intro-hero-copy">
              <p class="intro-eyebrow">{eyebrow}</p>

              <div class="intro-headline-frame">
                <h3 class="intro-headline split-words">
                  {
                    headlineLines.map((line, index) => (
                      <span class={index === accentLine ? "intro-headline-line is-accent" : "intro-headline-line"}>
                        {line}
                      </span>
                    ))
                  }
                </h3>
              </div>

              <p class="intro-body">{body}</p>
            </div>

            {(signals.length > 0 || projects.length > 0) && (
              <div class="intro-meta">
                {signals.length > 0 && (
                  <div class="intro-signal-row">
                    {signals.map((signal) => <span class="intro-signal">{signal}</span>)}
                  </div>
                )}

                {projects.length > 0 && (
                  <div class="intro-project-block">
                    <p class="intro-project-label">{projectsLabel}</p>
                    <div class="intro-project-row">
                      {projects.map((project) => <span class="intro-project-chip">{project}</span>)}
                    </div>
                  </div>
                )}
              </div>
            )}
          </div>

          {facets.length > 0 && (
            <div class="intro-program animate-read" aria-label={facetsTitle}>
              <div class="intro-program-header">
                {facetsTitle && <p class="intro-program-title">{facetsTitle}</p>}
              </div>

              <div class="intro-facet-cloud">
                {cloudTerms.map((term) => (
                  <span
                    class={`fc-word fc-${term.tier}`}
                    style={`font-size:${term.size}rem; opacity:${term.op}; --amp:${term.amp}px; --ampX:${term.ampX}px; animation-duration:${term.dur}s; animation-delay:-${term.delay}s;`}
                  >{term.text}</span>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-home-intro {
    background-color: transparent;
    z-index: 2;
    padding-top: calc(var(--section-padding) * 0.65);
    padding-bottom: calc(var(--section-padding) * 1.05);
  }

  .section-home-intro .row {
    justify-content: center;
  }

  .section-home-intro .col {
    max-width: min(100%, 86rem);
    justify-content: center;
  }

  .intro-stack {
    display: grid;
    gap: 1.35rem;
  }

  .intro-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    gap: 1.4rem;
    padding: clamp(1.55rem, 3vw, 2.85rem);
    border-radius: 2.2rem;
    border: 2px solid #0A0908;
    background:
      radial-gradient(circle at 12% 16%, rgba(248, 74, 16, 0.14), transparent 28%),
      radial-gradient(circle at 88% 16%, rgba(255, 122, 60, 0.12), transparent 22%),
      radial-gradient(circle at 76% 76%, rgba(255, 122, 60, 0.08), transparent 24%),
      linear-gradient(180deg, #201E16 0%, #201E16 46%, #201E16 100%);
    box-shadow: 10px 10px 0 rgba(10, 9, 8, 0.92);
  }

  .intro-hero::before,
  .intro-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .intro-hero::before {
    background:
      linear-gradient(132deg, rgba(255, 255, 255, 0.05), transparent 36%),
      linear-gradient(90deg, rgba(248, 74, 16, 0.95), rgba(255, 122, 60, 0.9) 52%, rgba(255, 122, 60, 0.95));
    background-size: 100% 100%, 100% 0.18rem;
    background-repeat: no-repeat;
    background-position: center center, top center;
    opacity: 0.96;
  }

  .intro-hero::after {
    background:
      radial-gradient(circle at 86% 28%, rgba(255, 122, 60, 0.1), transparent 16%),
      radial-gradient(circle at 18% 82%, rgba(248, 74, 16, 0.08), transparent 18%);
    opacity: 0.84;
  }

  .intro-hero-copy,
  .intro-meta,
  .intro-program {
    position: relative;
    z-index: 1;
  }

  .intro-hero-copy {
    display: grid;
    gap: 1.15rem;
    text-align: left;
  }

  .intro-eyebrow,
  .intro-project-label {
    margin: 0;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(234, 230, 210, 0.52);
  }

  .intro-headline-frame {
    position: relative;
    display: inline-grid;
    overflow: visible;
    width: auto;
    max-width: 58rem;
    justify-self: center;
    margin-inline: auto;
    padding: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
  }

  .intro-headline-frame::before,
  .intro-headline-frame::after {
    content: "";
    position: absolute;
    pointer-events: none;
  }

  .intro-headline-frame::before {
    display: none;
  }

  .intro-headline-frame::after {
    inset: 10% auto auto 50%;
    width: 36rem;
    height: 36rem;
    border-radius: 50%;
    background:
      radial-gradient(circle, rgba(255, 122, 60, 0.08), transparent 62%);
    transform: translateX(-50%);
    z-index: -1;
  }

  .intro-headline {
    margin: 0;
    display: grid;
    gap: 0.05em;
    text-align: center;
    font-size: clamp(1.7rem, 1.1rem + 2vw, 2.85rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: #EAE6D2;
  }

  .intro-headline-line {
    display: block;
  }

  .intro-headline-line.is-accent {
    background: linear-gradient(90deg, #F84A10 0%, #FF7A3C 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .intro-body {
    margin: 0;
    width: min(100%, 62rem);
    max-width: 62rem;
    margin-inline: auto;
    font-size: clamp(1.18rem, 1.02rem + 0.45vw, 1.42rem);
    font-weight: 500;
    line-height: 1.62;
    color: rgba(234, 230, 210, 0.82);
  }

  .intro-signal-row,
  .intro-project-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .intro-signal {
    display: inline-flex;
    align-items: center;
    min-height: 2.3rem;
    padding: 0.5rem 0.86rem;
    border-radius: 999px;
    border: 2px solid #0A0908;
    background: rgba(32, 30, 22, 0.92);
    color: rgba(234, 230, 210, 0.84);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    box-shadow: 0 8px 18px rgba(234, 230, 210, 0.14);
  }

  .intro-meta {
    display: grid;
    gap: 1rem;
    width: min(100%, 82rem);
    margin-inline: auto;
    padding: 1rem 1rem 1.1rem;
    border-radius: 1.5rem;
    border: 2px solid #0A0908;
    background: linear-gradient(180deg, rgba(32, 30, 22, 0.96), rgba(26, 24, 17, 0.94));
    box-shadow:
      0 14px 34px rgba(62, 58, 43, 0.16),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .intro-project-block {
    display: grid;
    gap: 0.8rem;
    padding-top: 1rem;
    border-top: 2px solid #0A0908;
  }

  .intro-project-chip {
    display: inline-flex;
    align-items: center;
    min-height: 2.15rem;
    padding: 0.45rem 0.92rem;
    border-radius: 999px;
    border: 2px solid #0A0908;
    background: rgba(168, 153, 104, 0.1);
    color: #EAE6D2;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .intro-program {
    position: relative;
    padding: clamp(1.2rem, 2vw, 2.2rem) 0 0.5rem;
    border-radius: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
  }

  .intro-program::before,
  .intro-program::after {
    display: none;
  }

  .intro-program-header {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-bottom: 0.4rem;
    border-bottom: 0;
    text-align: center;
  }

  .intro-program-title {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    line-height: 1;
    color: rgba(234, 230, 210, 0.5);
  }

  .intro-program-title::before {
    content: "";
    width: 1.6rem;
    height: 1px;
    background: linear-gradient(90deg, #F84A10, transparent);
  }

  /* ─── 大会内容 layered word cloud ──────────────────── */
  .intro-facet-cloud {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.15rem 0.95rem;
    padding: 1.6rem 0.5rem 1rem;
    max-width: 72rem;
    margin-inline: auto;
  }

  .fc-word {
    display: inline-block;
    line-height: 1;
    white-space: nowrap;
    /* font-size, opacity, --amp, duration & delay are set inline per word */
    animation-name: fc-float;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    will-change: transform;
  }

  /* foreground anchors — bold orange, sit on top of the depth field */
  .fc-hero {
    font-weight: 800;
    letter-spacing: -0.03em;
    background: linear-gradient(95deg, #F84A10 0%, #FF7A3C 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: 0 0 28px rgba(248, 74, 16, 0.25);
  }

  /* mid layer — brighter cream keywords */
  .fc-key {
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #EAE6D2;
  }

  /* background layer — faint recessed filler (opacity set inline, low) */
  .fc-ambient {
    font-weight: 500;
    letter-spacing: 0.01em;
    color: #EAE6D2;
  }

  /* gentle elliptical orbit — X and Y peak out of phase so it drifts organically */
  @keyframes fc-float {
    0%   { transform: translate(0, 0); }
    25%  { transform: translate(var(--ampX, 12px), calc(var(--amp, 14px) * -0.5)); }
    50%  { transform: translate(0, calc(var(--amp, 14px) * -1)); }
    75%  { transform: translate(calc(var(--ampX, 12px) * -1), calc(var(--amp, 14px) * -0.5)); }
    100% { transform: translate(0, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .fc-word { animation: none; }
  }

  @media (max-width: 1080px) {
    .intro-body {
      width: 100%;
      max-width: none;
    }

    .intro-facet-cloud {
      gap: 0.3rem 1.1rem;
    }
  }

  @media (max-width: 640px) {
    .section-home-intro {
      padding-top: calc(var(--section-padding) * 1.05);
    }

    .intro-hero,
    .intro-program,
    .intro-headline-frame {
      border-radius: 1.5rem;
    }

    .intro-hero,
    .intro-program {
      padding: 1.25rem;
    }

    .intro-meta {
      padding: 0.9rem;
    }

    .intro-program-header {
      align-items: center;
    }

    .intro-program-title {
      letter-spacing: -0.02em;
      line-height: 0.96;
    }

    .intro-body {
      font-size: 1.02rem;
      line-height: 1.66;
    }
  }
</style>
