---
import scheduleData from "json/ScheduleBilingual.json"
import schedulePreview from "json/SchedulePreview.json"
import speakersEn from "json/SpeakersCleaned.json"
import speakersZh from "json/SpeakersZh.json"
import {
  getSpeakerImagePath,
  SPEAKER_IMAGE_FALLBACK_HANDLER,
} from "utils/speaker-images"
import "styles/SchedulePreview.scss"

interface Props {
  currentDay?: string
  lang?: "en" | "zh" | "fr"
  speakerBasePath?: string
  previewMode?: boolean
}

const { lang = "en", speakerBasePath = "/speakers/", previewMode = false } = Astro.props
const previewLang: "en" | "zh" = lang === "zh" ? "zh" : "en"
const previewCopy = {
  en: {
    tracks: "Conference Tracks",
    sessions: (count: number) => `${count} talk${count === 1 ? "" : "s"}`,
    note: "Session dates, times, and rooms will be added once confirmed.",
  },
  zh: {
    tracks: "分论坛主题",
    sessions: (count: number) => `${count} 场演讲`,
    note: "具体日期、时间与会场确认后将在此补充。",
  },
}[previewLang]
const previewSpeakerData = previewLang === "zh" ? speakersZh : speakersEn
const previewSpeakerById = new Map(
  previewSpeakerData.speakers.map((speaker: any) => [speaker.id, speaker]),
)
const previewScheduleBasePath = previewLang === "zh" ? "/zh/schedule/" : "/schedule/"
const previewSpeakerBasePath = previewLang === "zh" ? "/zh/speakers/" : speakerBasePath

// Get English text from bilingual objects
const en = (obj: any): string => {
  if (!obj) return ""
  if (typeof obj === "string") return obj
  return obj.en || obj.zh || ""
}

// Get text in current language (for UI labels and translated content like break names)
const loc = (obj: any): string => {
  if (!obj) return ""
  if (typeof obj === "string") return obj
  return obj[lang] || obj.en || obj.zh || ""
}

const i18n = {
  en: {
    conferenceTracks: "Conference Tracks",
    hackathons: "Spotlight & Hackathons",
    workshops: "Workshops",
    overview: "Overview",
    allTracks: "All Tracks",
    venue: "Venue",
    venueMaps: "Our Spaces",
    sessionsByVenue: "Sessions by Room",
    floorplan: "Floor Plan",
    allRooms: "All Rooms",
    gridLabel: "Room × Time",
    gridSub: "Grid View",
    keynotesLabel: "★ Keynotes ★",
    tbd: "TBD",
    keynotesTbd: "Keynote speakers will be announced soon.",
    noSessionsOnDay: (day: string) => `No sessions on ${day} for this track.`,
    noSessions: "No sessions scheduled for this track.",
    sessionsScheduledOn: "Sessions are scheduled on:",
    viewDaySessions: (day: string) => `→ View ${day} sessions`,
    disclaimer: "Schedule is subject to change.",
    dayOnly: (day: string) => `${day} only`,
    tracks: "Tracks",
    sessionCount: (n: number) => `${n} session${n !== 1 ? "s" : ""}`,
    typeLabels: { keynote: "Keynote", talk: "Talk", panel: "Panel", break: "Break", workshop: "Workshop", hackathon: "Hackathon" },
  },
  zh: {
    conferenceTracks: "议程安排",
    hackathons: "Spotlight & Hackathons",
    workshops: "工作坊",
    overview: "概览",
    allTracks: "所有议程",
    venue: "场地",
    venueMaps: "Our Spaces",
    sessionsByVenue: "按房间查看",
    floorplan: "平面图",
    allRooms: "所有房间",
    gridLabel: "房间 × 时间",
    gridSub: "网格视图",
    keynotesLabel: "★ Keynotes ★",
    tbd: "TBD",
    keynotesTbd: "主旨演讲嘉宾将很快公布。",
    noSessionsOnDay: (day: string) => `${day} 暂无该议题的会议安排。`,
    noSessions: "该议题暂无会议安排。",
    sessionsScheduledOn: "会议安排在：",
    viewDaySessions: (day: string) => `→ 查看 ${day} 的会议`,
    disclaimer: "议程安排可能有所变动。",
    dayOnly: (day: string) => `仅 ${day}`,
    tracks: "议程",
    sessionCount: (n: number) => `${n} 场演讲`,
    typeLabels: { keynote: "Keynote", talk: "演讲", panel: "圆桌", break: "休息", workshop: "工作坊", hackathon: "Hackathon" },
  },
  fr: {
    conferenceTracks: "Conférences",
    hackathons: "Spotlight & Hackathons",
    workshops: "Ateliers",
    overview: "Vue d'ensemble",
    allTracks: "Tous les tracks",
    venue: "Lieu",
    venueMaps: "Nos espaces",
    sessionsByVenue: "Sessions par salle",
    floorplan: "Plan",
    allRooms: "Toutes les salles",
    gridLabel: "Salle × Horaire",
    gridSub: "Vue grille",
    keynotesLabel: "★ Keynotes ★",
    tbd: "TBD",
    keynotesTbd: "Les conférenciers seront annoncés prochainement.",
    noSessionsOnDay: (day: string) => `Aucune session le ${day} pour ce thème.`,
    noSessions: "Aucune session prévue pour ce thème.",
    sessionsScheduledOn: "Sessions prévues le :",
    viewDaySessions: (day: string) => `→ Voir les sessions du ${day}`,
    disclaimer: "Le programme est susceptible de changer.",
    dayOnly: (day: string) => `${day} uniquement`,
    tracks: "Tracks",
    sessionCount: (n: number) => `${n} session${n !== 1 ? "s" : ""}`,
    typeLabels: { keynote: "Keynote", talk: "Conférence", panel: "Table ronde", break: "Pause", workshop: "Atelier", hackathon: "Hackathon" },
  },
}
const t = i18n[lang] || i18n.en

const isWorkshop = (id: string) => id.startsWith("ws-")
const isHackathon = (id: string) => id.startsWith("hackathon-")
const tracks = scheduleData.categories.filter((c) => !isWorkshop(c.id) && !isHackathon(c.id))
const hackathons = scheduleData.categories.filter((c) => isHackathon(c.id))
const workshops = scheduleData.categories.filter((c) => isWorkshop(c.id))
const allCategories = [...tracks, ...workshops, ...hackathons]

// Collect all keynotes across every category for a given day
const getKeynotes = (day: string) => {
  const result: any[] = []
  for (const cat of allCategories) {
    const all = (scheduleData.sessions as Record<string, any[]>)[cat.id] || []
    all.filter((s) => en(s.date) === day && s.type === "keynote").forEach((s) => result.push(s))
  }
  // Dedupe by title + timeSlot in case a keynote appears in multiple categories
  const seen = new Set<string>()
  return result.filter((s) => {
    const key = `${s.timeSlot}||${en(s.title)}`
    if (seen.has(key)) return false
    seen.add(key)
    return true
  }).sort((a, b) => (a.timeSlot || "").localeCompare(b.timeSlot || ""))
}

// Collect all ceremonies across every category for a given day (same pattern as getKeynotes)
const getCeremonies = (day: string) => {
  const result: any[] = []
  for (const cat of allCategories) {
    const all = (scheduleData.sessions as Record<string, any[]>)[cat.id] || []
    all.filter((s) => en(s.date) === day && s.type === "ceremony").forEach((s) => result.push(s))
  }
  const seen = new Set<string>()
  return result.filter((s) => {
    const key = `${s.timeSlot}||${en(s.title)}`
    if (seen.has(key)) return false
    seen.add(key)
    return true
  }).sort((a, b) => (a.timeSlot || "").localeCompare(b.timeSlot || ""))
}

// Get non-keynote, non-ceremony sessions for a specific day + category, sorted by time
const getSessions = (catId: string, day: string) => {
  const all = (scheduleData.sessions as Record<string, any[]>)[catId] || []
  return all
    .filter((s) => en(s.date) === day && s.type !== "keynote" && s.type !== "ceremony")
    .sort((a, b) => (a.timeSlot || "").localeCompare(b.timeSlot || ""))
}

const TRACK_COLORS: Record<string, string> = {
  // Keep these in sync with ProgramSection.astro's six homepage track inks.
  "agentic-ai-summit":          "#EF6A3A",
  "agentic-ai-on-edge":         "#D5A24A",
  "ai-generative-app":          "#75A49C",
  "open-source-model":          "#91A66B",
  "open-source-robotics":       "#8096B2",
  "agentic-device":             "#A48692",
}
const WORKSHOP_COLOR = "#6B6450"
const trackColor = (id: string) => TRACK_COLORS[id] || WORKSHOP_COLOR

const TYPE_BG_FG: Record<string, { bg: string; fg: string }> = {
  keynote:   { bg: "#3F3C2D", fg: "#EAE6D2" },
  ceremony:  { bg: "#F84A10", fg: "#EAE6D2" },
  talk:      { bg: "#2A2719", fg: "#8A8266" },
  panel:     { bg: "#2A2719", fg: "#8A8266" },
  break:     { bg: "#2A2719", fg: "#9C947C" },
  workshop:  { bg: "#2A2719", fg: "#8A8266" },
  hackathon: { bg: "#F84A10", fg: "#EAE6D2" },
}
const typeMeta = (type: string) => {
  const style = TYPE_BG_FG[type] || { bg: "#2A2719", fg: "#8A8266" }
  const label = (t.typeLabels as Record<string, string>)[type] || type || t.typeLabels.talk
  return { label, ...style }
}

const createSlug = (title: string) =>
  title
    .toLowerCase()
    .replace(/[^\w\s\u4e00-\u9fff-]/g, "")
    .replace(/\s+/g, "-")
    .replace(/-+/g, "-")
    .replace(/^-+|-+$/g, "")
    .trim()

const days = scheduleData.days
const firstDay = en(days[0]?.date)
const firstCat = allCategories[0]?.id || ""

// Which days each category has at least one (non-keynote) session
const catDaysMap: Record<string, string[]> = {}
for (const cat of allCategories) {
  catDaysMap[cat.id] = days
    .map((d) => en(d.date))
    .filter((dayEn) => getSessions(cat.id, dayEn).some(s => s.type !== "break"))
}

// Short day label for display (e.g. "May 5" → "May 5")
const dayLabels: Record<string, string> = {}
for (const d of days) { dayLabels[en(d.date)] = en(d.date) }

// Build room data for room view
const roomSessionsMap = new Map<string, { room: any, sessions: Map<string, any[]>, primaryColor: string }>()

for (const cat of allCategories) {
  const catSessions = (scheduleData.sessions as Record<string, any[]>)[cat.id] || []
  for (const session of catSessions) {
    const effectiveRoom = session.room || cat.room
    if (!effectiveRoom) continue
    const roomKey = en(effectiveRoom)
    if (!roomKey) continue

    if (!roomSessionsMap.has(roomKey)) {
      roomSessionsMap.set(roomKey, { room: effectiveRoom, sessions: new Map(), primaryColor: trackColor(cat.id) })
    }
    const roomEntry = roomSessionsMap.get(roomKey)!
    const dayKey = en(session.date)
    if (!dayKey) continue

    if (!roomEntry.sessions.has(dayKey)) {
      roomEntry.sessions.set(dayKey, [])
    }
    roomEntry.sessions.get(dayKey)!.push({
      ...session,
      _trackId: cat.id,
      _trackName: en(cat.name),
      _trackColor: trackColor(cat.id),
    })
  }
}

// Sort and dedupe sessions within each room+day
for (const [, roomEntry] of roomSessionsMap) {
  for (const [dayKey, sessions] of roomEntry.sessions) {
    const seen = new Set<string>()
    const deduped = sessions.filter((s: any) => {
      if (s.type === "keynote" || s.type === "ceremony") {
        const key = `${s.timeSlot}||${en(s.title)}`
        if (seen.has(key)) return false
        seen.add(key)
      }
      return true
    })
    deduped.sort((a: any, b: any) => (a.timeSlot || "").localeCompare(b.timeSlot || ""))
    roomEntry.sessions.set(dayKey, deduped)
  }
}

const allRooms = Array.from(roomSessionsMap.entries()).map(([key, data]) => ({
  key,
  room: data.room,
  sessions: data.sessions,
  primaryColor: data.primaryColor,
  days: Array.from(data.sessions.keys()).sort(),
}))
const firstRoom = allRooms[0]?.key || ""

// ── Grid (Room × Time) view data ──
// Room columns derive from the schedule data (individual room assignments are still pending)
const GRID_ROOM_ORDER = [...new Set(allCategories.map((cat: any) => en(cat.room)).filter(Boolean))]
const gridRooms = GRID_ROOM_ORDER
const GRID_SLOT_MINUTES = 5
const BREAK_BANDS = [
  { start: "10:00", end: "10:20", label: "Morning Coffee" },
  { start: "15:00", end: "15:30", label: "Tea Break" },
]

function timeToMinutes(t: string): number {
  const [h, m] = t.split(":").map(Number)
  return h * 60 + m
}
function minutesToTime(m: number): string {
  const hh = String(Math.floor(m / 60)).padStart(2, "0")
  const mm = String(m % 60).padStart(2, "0")
  return `${hh}:${mm}`
}

// Map all categories to their default room (for grid view, we need workshops too)
const trackRoomMap = new Map<string, string>()
for (const cat of allCategories) {
  const roomName = en(cat.room)
  if (roomName) trackRoomMap.set(cat.id, roomName)
}

interface GridCell { session: any; trackId: string; trackName: string; trackColor: string; rowSpan: number; slug: string }
interface GridDay {
  dayEn: string
  dayLabel: string
  timeSlots: string[]
  placed: Map<string, Map<string, GridCell>>
  occupied: Map<string, Set<string>>
  totalRows: number
}

const gridDays: GridDay[] = days.map(d => {
  const dayEn = en(d.date)
  const dayLabel = loc(d.date)
  let minTime = 24 * 60, maxTime = 0

  type SessionInfo = { session: any; roomKey: string; startMin: number; endMin: number; trackId: string; trackName: string; trackColor: string }
  const allGridSessions: SessionInfo[] = []

  // All categories — sessions go to their category's designated room
  for (const cat of allCategories) {
    const catRoom = trackRoomMap.get(cat.id)
    if (!catRoom) continue
    const catSessions = (scheduleData.sessions as Record<string, any[]>)[cat.id] || []
    for (const s of catSessions) {
      if (!s.timeSlot) continue
      if (en(s.date) !== dayEn) continue
      const isSpecial = s.type === "keynote" || s.type === "ceremony"
      const sessionRoom = s.room ? en(s.room) : ""
      const roomKey = sessionRoom || catRoom
      if (!GRID_ROOM_ORDER.includes(roomKey)) continue
      const parts = s.timeSlot.split(" - ").map((t: string) => t.trim())
      if (parts.length !== 2) continue
      const startMin = timeToMinutes(parts[0])
      const endMin = timeToMinutes(parts[1])
      if (startMin < minTime) minTime = startMin
      if (endMin > maxTime) maxTime = endMin
      allGridSessions.push({
        session: { ...s, _trackId: cat.id, _trackName: en(cat.name), _trackColor: trackColor(cat.id) },
        roomKey, startMin, endMin,
        trackId: cat.id, trackName: en(cat.name), trackColor: trackColor(cat.id),
      })
    }
  }

  // Snap to 15-min grid for display boundaries
  minTime = Math.floor(minTime / 15) * 15
  maxTime = Math.ceil(maxTime / 15) * 15

  const timeSlots: string[] = []
  for (let t = minTime; t < maxTime; t += GRID_SLOT_MINUTES) {
    timeSlots.push(minutesToTime(t))
  }

  const placed = new Map<string, Map<string, GridCell>>()
  const occupied = new Map<string, Set<string>>()
  for (const roomKey of gridRooms) {
    placed.set(roomKey, new Map())
    occupied.set(roomKey, new Set())
  }

  // Pass 1: Place all sessions using real durations
  const seenKeys = new Set<string>()
  for (const { session, roomKey, startMin, endMin, trackId, trackName, trackColor: tc } of allGridSessions) {
    const dedupKey = `${roomKey}||${session.timeSlot}||${en(session.title)}`
    if (seenKeys.has(dedupKey)) continue
    seenKeys.add(dedupKey)
    const startSlot = minutesToTime(Math.floor(startMin / GRID_SLOT_MINUTES) * GRID_SLOT_MINUTES)
    const naturalSlots = Math.max(1, Math.ceil((endMin - startMin) / GRID_SLOT_MINUTES))
    const slug = createSlug(en(session.title))

    if (placed.get(roomKey)?.has(startSlot)) continue
    if (occupied.get(roomKey)?.has(startSlot)) continue
    placed.get(roomKey)!.set(startSlot, {
      session, trackId, trackName, trackColor: tc, rowSpan: naturalSlots, slug,
    })
    const startIdx = timeSlots.indexOf(startSlot)
    for (let i = 1; i < naturalSlots && startIdx + i < timeSlots.length; i++) {
      occupied.get(roomKey)!.add(timeSlots[startIdx + i])
    }
  }

  // Pass 2: Inflate short sessions for display (skip keynotes/ceremonies to keep timeline accurate)
  const MIN_ROW_SPAN = 4
  let maxRowEnd = timeSlots.length
  for (const roomKey of gridRooms) {
    const roomPlaced = placed.get(roomKey)!
    const slots = Array.from(roomPlaced.keys()).sort()
    let rowShift = 0
    for (let si = 0; si < slots.length; si++) {
      const slot = slots[si]
      const cell = roomPlaced.get(slot)!
      const ri = timeSlots.indexOf(slot)
      ;(cell as any).rowOffset = ri + rowShift
      const isFixed = cell.session.type === "keynote" || cell.session.type === "ceremony"
      const inflated = isFixed ? cell.rowSpan : Math.max(MIN_ROW_SPAN, cell.rowSpan)
      const extra = inflated - cell.rowSpan
      cell.rowSpan = inflated
      rowShift += extra
    }
    const lastSlot = slots[slots.length - 1]
    if (lastSlot) {
      const lastCell = roomPlaced.get(lastSlot)!
      const lastEnd = (lastCell as any).rowOffset + lastCell.rowSpan
      if (lastEnd > maxRowEnd) maxRowEnd = lastEnd
    }
  }

  return { dayEn, dayLabel, timeSlots, placed, occupied, totalRows: maxRowEnd }
})
---

{previewMode && (
  <section class="schedule-preview-mode" data-bg-section="lightgray" data-theme-section="light">
    <div class="preview-container">
      <div class="preview-body">
        <aside class="preview-sidebar">
          <p class="preview-group-label">{previewCopy.tracks}</p>
          {schedulePreview.tracks.map((track, index) => (
            <button
              class={`preview-track-button${index === 0 ? " active" : ""}`}
              data-preview-track-button={track.id}
              style={`--tc: ${trackColor(track.id)}`}
              type="button"
            >
              <span class="preview-track-dot"></span>
              <span>{track.name[previewLang]}</span>
            </button>
          ))}
        </aside>

        <div class="preview-main">
          <div class="preview-mobile-tracks">
            <p class="preview-group-label">{previewCopy.tracks}</p>
            <div class="preview-mobile-pills">
              {schedulePreview.tracks.map((track, index) => (
                <button
                  class={`preview-mobile-pill${index === 0 ? " active" : ""}`}
                  data-preview-track-button={track.id}
                  style={`--tc: ${trackColor(track.id)}`}
                  type="button"
                >
                  {track.name[previewLang]}
                </button>
              ))}
            </div>
          </div>

          {schedulePreview.tracks.map((track, trackIndex) => (
            <div
              class="preview-track-panel"
              data-preview-track-panel={track.id}
              style={trackIndex === 0 ? undefined : "display:none"}
            >
              <div class="preview-panel-header" style={`--tc: ${trackColor(track.id)}`}>
                <h2>{track.name[previewLang]}</h2>
                <span>{previewCopy.sessions(track.talks.length)}</span>
              </div>

              <div class="preview-session-list">
                {track.talks.map((talk, talkIndex) => {
                  const talkSpeakers = talk.speakers
                    .map((speakerId) => previewSpeakerById.get(speakerId))
                    .filter(Boolean) as any[]
                  return (
                    <article class="preview-session-card" style={`--tc: ${trackColor(track.id)}`}>
                      <a
                        class="preview-session-cell-link"
                        href={`${previewScheduleBasePath}${talk.slug}/`}
                        aria-label={talk.title[previewLang]}
                      ></a>
                      <span class="preview-session-index">{String(talkIndex + 1).padStart(2, "0")}</span>
                      <div class="preview-session-content">
                        <h3>{talk.title[previewLang]}</h3>
                      </div>
                      <div class="preview-session-speakers">
                        {talkSpeakers.map((speaker) => (
                          <a
                            class="preview-speaker-link"
                            href={`${previewSpeakerBasePath}${speaker.id}/`}
                          >
                            <img
                              src={getSpeakerImagePath(speaker.id)}
                              onerror={SPEAKER_IMAGE_FALLBACK_HANDLER}
                              alt=""
                              loading="lazy"
                            />
                            <span>
                              <strong>{speaker.name}</strong>
                              {speaker.roleOrg && <small>{speaker.roleOrg}</small>}
                            </span>
                          </a>
                        ))}
                      </div>
                    </article>
                  )
                })}
              </div>
            </div>
          ))}

          <p class="preview-note">{previewCopy.note}</p>
        </div>
      </div>
    </div>
  </section>
)}

<section class="sched-section" data-bg-section="lightgray" data-theme-section="light" style={previewMode ? "display:none" : undefined}>

  <!-- Day Tabs -->
  <div class="sched-day-nav">
    <div class="day-nav-inner">
      <div class="day-tabs-track">
        {days.map((day, i) => (
          <button class={`sched-day-btn${i === 0 ? " active" : ""}`} data-day={en(day.date)}>
            <span class="day-label">{loc(day.title)}</span>
            <span class="day-date">{loc(day.date)}</span>
          </button>
        ))}
        <button class="sched-day-btn" data-view="grid">
          <span class="day-label">{t.gridLabel}</span>
          <span class="day-date">{t.gridSub}</span>
        </button>
      </div>
    </div>
  </div>

  <div class="sched-container">
    <div class="sched-body">

      <!-- Left Sidebar -->
      <aside class="sched-sidebar">
        <div class="track-group">
          <p class="track-group-label">{t.conferenceTracks}</p>
          {tracks.map((cat, i) => {
            const catDays = catDaysMap[cat.id] || []
            const dayBadge = catDays.length === days.length ? null : catDays.join(" & ")
            return (
              <button
                class={`sched-track-btn${i === 0 ? " active" : ""}`}
                data-track={cat.id}
                data-cat-days={catDays.join(",")}
                style={`--tc: ${trackColor(cat.id)}`}
              >
                <span class="track-dot"></span>
                <span class="track-info">
                  <span class="track-name">{loc(cat.name)}</span>
                  {cat.room && <span class="track-room">{en(cat.room)}</span>}
                  {dayBadge && <span class="track-day-badge">{t.dayOnly(dayBadge)}</span>}
                </span>
              </button>
            )
          })}
        </div>

        <div class="track-group">
          <p class="track-group-label">{t.workshops}</p>
          {workshops.map((cat) => {
            const catDays = catDaysMap[cat.id] || []
            const dayBadge = catDays.length === days.length ? null : catDays.join(" & ")
            return (
            <button
              class="sched-track-btn"
              data-track={cat.id}
              data-cat-days={catDays.join(",")}
              style={`--tc: ${trackColor(cat.id)}`}
            >
              <span class="track-dot"></span>
              <span class="track-info">
                <span class="track-name">{loc(cat.name)}</span>
                {cat.room && <span class="track-room">{en(cat.room)}</span>}
                {dayBadge && <span class="track-day-badge">{t.dayOnly(dayBadge)}</span>}
              </span>
            </button>
            )
          })}
        </div>

        {hackathons.length > 0 && (
          <div class="track-group">
            <p class="track-group-label">{t.hackathons}</p>
            {hackathons.map((cat) => {
              const catDays = catDaysMap[cat.id] || []
              const dayBadge = catDays.length === days.length ? null : catDays.join(" & ")
              return (
                <button
                  class="sched-track-btn"
                  data-track={cat.id}
                  data-cat-days={catDays.join(",")}
                  style={`--tc: ${trackColor(cat.id)}`}
                >
                  <span class="track-dot"></span>
                  <span class="track-info">
                    <span class="track-name">{loc(cat.name)}</span>
                    {cat.room && <span class="track-room">{en(cat.room)}</span>}
                    {dayBadge && <span class="track-day-badge">{t.dayOnly(dayBadge)}</span>}
                  </span>
                </button>
              )
            })}
          </div>
        )}
      </aside>

      <!-- Sessions Panel -->
      <div class="sched-main">

        <!-- Mobile track selector -->
        <div class="mobile-track-scroll">
          <div class="mobile-track-inner">
            <p class="mobile-track-label">{t.tracks}</p>
            <div class="mobile-track-pills">
              {allCategories.map((cat, i) => (
                <button
                  class={`mobile-track-pill${i === 0 ? " active" : ""}`}
                  data-track={cat.id}
                  style={`--tc: ${trackColor(cat.id)}`}
                >
                  {loc(cat.name)}
                </button>
              ))}
            </div>
          </div>
        </div>

        <!-- One panel per day × track combination -->
        {days.map((day) => {
          const dayEn = en(day.date)
          const keynotes = getKeynotes(dayEn)
          const ceremonies = getCeremonies(dayEn)
          return allCategories.map((cat) => {
            const sessions = getSessions(cat.id, dayEn)
            const firstKeynoteTime = keynotes[0]?.timeSlot || "99:99"
            const earlyBreaks = sessions.filter(s => (s.timeSlot || "99:99") < firstKeynoteTime)
            const laterSessions = sessions.filter(s => (s.timeSlot || "99:99") >= firstKeynoteTime)
            const firstCeremonyStart = ceremonies.length > 0 ? (ceremonies[0]?.timeSlot || "99:99").split(" - ")[0] : "99:99"
            const preCeremonySessions = laterSessions.filter(s => ((s.timeSlot || "99:99").split(" - ")[0]) < firstCeremonyStart)
            const postCeremonySessions = laterSessions.filter(s => ((s.timeSlot || "99:99").split(" - ")[0]) >= firstCeremonyStart)
            const color = trackColor(cat.id)
            return (
              <div
                class="track-panel"
                data-panel-day={dayEn}
                data-panel-track={cat.id}
                style="display:none"
              >
                <div class="panel-header" style={`border-left-color: ${color}`}>
                  <div class="panel-header-left">
                    <h2 class="panel-title">{loc(cat.name)}</h2>
                    {cat.room && <span class="panel-room">{en(cat.room)}</span>}
                  </div>
                  <span class="panel-count">{t.sessionCount(sessions.filter(s => s.type !== "break").length)}</span>
                </div>

                {/* Pre-keynote breaks (e.g. Registration) */}
                {earlyBreaks.length > 0 && (
                  <div class="session-list">
                    {earlyBreaks.map((session) => {
                      const isReg = (session.title as any)?.en === "Registration"
                      return (
                        <div class={isReg ? "break-divider registration-divider" : "break-divider"}>
                          <span class="break-line" />
                          <span class="break-label">
                            {session.timeSlot && <span class="break-time">{session.timeSlot}</span>}
                            {loc(session.title)}
                          </span>
                          <span class="break-line" />
                        </div>
                      )
                    })}
                  </div>
                )}

                {/* Keynote block */}
                <div class="keynote-block">
                  {keynotes.length > 0 ? keynotes.map((kn) => {
                    const hasSpeakers = kn.speakers && kn.speakers.length > 0
                    const titleText = loc(kn.title)
                    const isTitleTbd = !titleText || titleText === "TBD" || titleText === "待定" || titleText === "À confirmer"
                    const slug = createSlug(en(kn.title))
                    return (
                      <a class="session-card keynote-card" href={`/schedule/${slug}/`}>
                        <div class="session-left">
                          {kn.timeSlot && <span class="session-time">{kn.timeSlot}</span>}
                          <span class="type-badge" style="background:#FF7A3C; color:#EAE6D2">{t.keynotesLabel}</span>
                          {(kn as any).room && (
                            <span class="special-location-badge keynote-location">
                              <svg width="10" height="12" viewBox="0 0 16 19" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8 18.6668C8.12016 18.6653 8.23643 18.624 8.33067 18.5494C8.65067 18.2934 16 12.3307 16 8.00005C16 5.8783 15.1571 3.84346 13.6569 2.34316C12.1566 0.84286 10.1217 0 8 0C5.87827 0 3.84344 0.84286 2.34315 2.34316C0.842855 3.84346 0 5.8783 0 8.00005C0 12.3307 7.34933 18.2934 7.66933 18.5494C7.76357 18.624 7.87984 18.6653 8 18.6668ZM8 4.80003C8.52742 4.80003 9.04299 4.95643 9.48152 5.24945C9.92005 5.54246 10.2618 5.95894 10.4637 6.44622C10.6655 6.93349 10.7183 7.46967 10.6154 7.98696C10.5125 8.50424 10.2586 8.9794 9.88562 9.35234C9.51268 9.72528 9.03752 9.97926 8.52024 10.0822C8.00296 10.185 7.46678 10.1322 6.97951 9.9304C6.49224 9.72857 6.07576 9.38677 5.78275 8.94824C5.48973 8.50971 5.33333 7.99413 5.33333 7.46671C5.33333 6.75946 5.61429 6.08118 6.11438 5.58108C6.61448 5.08098 7.29276 4.80003 8 4.80003Z" fill="currentColor"/></svg>
                              {en((kn as any).room)}
                            </span>
                          )}
                        </div>
                        <div class="session-right">
                          {!isTitleTbd && <h3 class="session-title">{titleText}</h3>}
                          {hasSpeakers ? (
                            <div class="speaker-list">
                              {kn.speakers.map((sp: any) => (
                                <div class="speaker-row">
                                  <span class="speaker-name">{sp.name}</span>
                                  {sp.title && <span class="speaker-role">{sp.title}</span>}
                                </div>
                              ))}
                            </div>
                          ) : (
                            <span class="keynote-tbd-text">{t.keynotesTbd}</span>
                          )}
                        </div>
                      </a>
                    )
                  }) : (
                    <div class="session-card keynote-card">
                      <div class="session-left">
                        <span class="type-badge" style="background:#3F3C2D; color:#EAE6D2">{t.keynotesLabel}</span>
                      </div>
                      <div class="session-right">
                        <span class="keynote-tbd-text">{t.keynotesTbd}</span>
                      </div>
                    </div>
                  )}
                </div>

                {laterSessions.length === 0 ? (() => {
                  const otherDays = (catDaysMap[cat.id] || []).filter(d => d !== dayEn)
                  return (
                    <div class="no-sessions">
                      {otherDays.length > 0 ? (
                        <>
                          <p class="no-sessions-msg">{t.noSessionsOnDay(dayEn)}</p>
                          <p class="no-sessions-hint">{t.sessionsScheduledOn}</p>
                          <div class="no-sessions-days">
                            {otherDays.map(d => (
                              <button class="switch-day-btn" data-switch-day={d}>{t.viewDaySessions(d)}</button>
                            ))}
                          </div>
                        </>
                      ) : (
                        <p class="no-sessions-msg">{t.noSessions}</p>
                      )}
                    </div>
                  )
                })() : (
                  <div class="session-list">
                    {preCeremonySessions.map((session) => {
                      const meta = typeMeta(session.type)
                      const isBreak = session.type === "break"
                      const hasContent = !isBreak && session.speakers && session.speakers.length > 0
                      if (isBreak) {
                        const isLunch = (session.title as any)?.en === "Lunch" || session.title === "Lunch"
                        const isRegistration = (session.title as any)?.en === "Registration"
                        return (
                          <div class={isLunch ? "break-divider lunch-divider" : isRegistration ? "break-divider registration-divider" : "break-divider"}>
                            <span class="break-line" />
                            <span class="break-label">
                              {session.timeSlot && <span class="break-time">{session.timeSlot}</span>}
                              {loc(session.title)}
                            </span>
                            <span class="break-line" />
                          </div>
                        )
                      }
                      const slug = createSlug(en(session.title))
                      return (
                        <a class="session-card" href={`/schedule/${slug}/`}>
                          <div class="session-left">
                            <span class="session-time">{session.timeSlot}</span>
                            <span class="type-badge" style={`background:${meta.bg}; color:${meta.fg}`}>
                              {meta.label}
                            </span>
                          </div>
                          <div class="session-right">
                            <h3 class="session-title">{loc(session.title)}</h3>
                            {hasContent && (
                              <div class="speaker-list">
                                {session.speakers.map((sp: any) => (
                                  <div class="speaker-row">
                                    <span class="speaker-name">{sp.name}</span>
                                    {sp.title && <span class="speaker-role">{sp.title}</span>}
                                  </div>
                                ))}
                              </div>
                            )}
                            {session.signupUrl && (
                              <span class="signup-link" data-href={session.signupUrl}>Sign Up &rarr;</span>
                            )}
                          </div>
                        </a>
                      )
                    })}
                  </div>
                )}

                {/* Ceremony block — shown on all tracks, same pattern as keynote block */}
                {ceremonies.length > 0 && (
                  <div class="ceremony-block">
                    {ceremonies.map((cer: any) => {
                      const slug = createSlug(en(cer.title))
                      return (
                        <a class="session-card keynote-card ceremony-card" href={`/schedule/${slug}/`}>
                          <div class="session-left">
                            {cer.timeSlot && <span class="session-time">{cer.timeSlot}</span>}
                            <span class="type-badge" style="background:#FF7A3C; color:#EAE6D2">★ Ceremony ★</span>
                            {cer.room && (
                              <span class="special-location-badge keynote-location">
                                <svg width="10" height="12" viewBox="0 0 16 19" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8 18.6668C8.12016 18.6653 8.23643 18.624 8.33067 18.5494C8.65067 18.2934 16 12.3307 16 8.00005C16 5.8783 15.1571 3.84346 13.6569 2.34316C12.1566 0.84286 10.1217 0 8 0C5.87827 0 3.84344 0.84286 2.34315 2.34316C0.842855 3.84346 0 5.8783 0 8.00005C0 12.3307 7.34933 18.2934 7.66933 18.5494C7.76357 18.624 7.87984 18.6653 8 18.6668ZM8 4.80003C8.52742 4.80003 9.04299 4.95643 9.48152 5.24945C9.92005 5.54246 10.2618 5.95894 10.4637 6.44622C10.6655 6.93349 10.7183 7.46967 10.6154 7.98696C10.5125 8.50424 10.2586 8.9794 9.88562 9.35234C9.51268 9.72528 9.03752 9.97926 8.52024 10.0822C8.00296 10.185 7.46678 10.1322 6.97951 9.9304C6.49224 9.72857 6.07576 9.38677 5.78275 8.94824C5.48973 8.50971 5.33333 7.99413 5.33333 7.46671C5.33333 6.75946 5.61429 6.08118 6.11438 5.58108C6.61448 5.08098 7.29276 4.80003 8 4.80003Z" fill="currentColor"/></svg>
                                {en(cer.room)}
                              </span>
                            )}
                          </div>
                          <div class="session-right">
                            <h3 class="session-title">{loc(cer.title)}</h3>
                            {cer.speakers && cer.speakers.length > 0 && (
                              <div class="speaker-list">
                                {cer.speakers.map((sp: any) => (
                                  <div class="speaker-row">
                                    <span class="speaker-name">{sp.name}</span>
                                    {sp.title && <span class="speaker-role">{sp.title}</span>}
                                  </div>
                                ))}
                              </div>
                            )}
                          </div>
                        </a>
                      )
                    })}
                  </div>
                )}

                {/* Post-ceremony sessions (e.g. Dinner after closing ceremony) */}
                {postCeremonySessions.length > 0 && (
                  <div class="session-list">
                    {postCeremonySessions.map((session) => {
                      const meta = typeMeta(session.type)
                      const isBreak = session.type === "break"
                      const hasContent = !isBreak && session.speakers && session.speakers.length > 0
                      if (isBreak) {
                        const isLunch = (session.title as any)?.en === "Lunch" || session.title === "Lunch"
                        const isRegistration = (session.title as any)?.en === "Registration"
                        return (
                          <div class={isLunch ? "break-divider lunch-divider" : isRegistration ? "break-divider registration-divider" : "break-divider"}>
                            <span class="break-line" />
                            <span class="break-label">
                              {session.timeSlot && <span class="break-time">{session.timeSlot}</span>}
                              {loc(session.title)}
                            </span>
                            <span class="break-line" />
                          </div>
                        )
                      }
                      const slug = createSlug(en(session.title))
                      return (
                        <a class="session-card" href={`/schedule/${slug}/`}>
                          <div class="session-left">
                            <span class="session-time">{session.timeSlot}</span>
                            <span class="type-badge" style={`background:${meta.bg}; color:${meta.fg}`}>
                              {meta.label}
                            </span>
                          </div>
                          <div class="session-right">
                            <h3 class="session-title">{loc(session.title)}</h3>
                            {hasContent && (
                              <div class="speaker-list">
                                {session.speakers.map((sp: any) => (
                                  <div class="speaker-row">
                                    <span class="speaker-name">{sp.name}</span>
                                    {sp.title && <span class="speaker-role">{sp.title}</span>}
                                  </div>
                                ))}
                              </div>
                            )}
                            {session.signupUrl && (
                              <span class="signup-link" data-href={session.signupUrl}>Sign Up &rarr;</span>
                            )}
                          </div>
                        </a>
                      )
                    })}
                  </div>
                )}
              </div>
            )
          })
        })}

        <p class="disclaimer">{t.disclaimer}</p>
      </div>
    </div>
  </div>

  <!-- Room view panel (hidden by default) -->
  <div class="rooms-panel" style="display:none">
    <div class="room-view-container">
      <!-- Day sub-tabs for room view -->
      <div class="room-day-nav">
        {days.map((day, i) => (
          <button class={`room-day-btn${i === 0 ? " active" : ""}`} data-room-day={en(day.date)}>
            {loc(day.date)}
          </button>
        ))}
      </div>

      <div class="room-view-body">
        <!-- Room sidebar -->
        <aside class="room-sidebar">
          <p class="track-group-label">{t.allRooms}</p>
          {allRooms.map((room, i) => (
            <button
              class={`room-btn${i === 0 ? " active" : ""}`}
              data-room={room.key}
              style={`--rc: ${room.primaryColor}`}
              data-room-days={room.days.join(",")}
            >
              <span class="room-dot"></span>
              <span class="room-btn-name">{loc(room.room)}</span>
            </button>
          ))}
        </aside>

        <!-- Mobile room selector -->
        <div class="mobile-room-scroll">
          <p class="mobile-track-label">{t.allRooms}</p>
          <div class="mobile-track-pills">
            {allRooms.map((room, i) => (
              <button
                class={`mobile-track-pill${i === 0 ? " active" : ""}`}
                data-room={room.key}
                style={`--tc: ${room.primaryColor}`}
              >
                {loc(room.room)}
              </button>
            ))}
          </div>
        </div>

        <!-- Room session panels -->
        <div class="room-main">
          {days.map((day) =>
            allRooms.map((room) => {
              const dayEn = en(day.date)
              const daySessions = room.sessions.get(dayEn) || []
              const nonBreakCount = daySessions.filter((s: any) => s.type !== "break").length
              return (
                <div
                  class="room-session-panel"
                  data-room-panel-day={dayEn}
                  data-room-panel-room={room.key}
                  style="display:none"
                >
                  <div class="panel-header">
                    <div class="panel-header-left">
                      <h2 class="panel-title">{loc(room.room)}</h2>
                      <span class="panel-room">{dayEn}</span>
                    </div>
                    <span class="panel-count">{t.sessionCount(nonBreakCount)}</span>
                  </div>

                  {daySessions.length === 0 ? (
                    <div class="no-sessions">
                      <p class="no-sessions-msg">{t.noSessionsOnDay(dayEn)}</p>
                    </div>
                  ) : (
                    <div class="session-list">
                      {daySessions.map((session: any) => {
                        const meta = typeMeta(session.type)
                        const isBreak = session.type === "break"
                        if (isBreak) {
                          const isLunch = en(session.title) === "Lunch"
                          const isReg = en(session.title) === "Registration"
                          return (
                            <div class={isLunch ? "break-divider lunch-divider" : isReg ? "break-divider registration-divider" : "break-divider"}>
                              <span class="break-line" />
                              <span class="break-label">
                                {session.timeSlot && <span class="break-time">{session.timeSlot}</span>}
                                {loc(session.title)}
                              </span>
                              <span class="break-line" />
                            </div>
                          )
                        }
                        const slug = createSlug(en(session.title))
                        const isKeynote = session.type === "keynote"
                        const isCeremony = session.type === "ceremony"
                        const isSpecial = isKeynote || isCeremony
                        return (
                          <a class={`session-card${isSpecial ? " keynote-card" : ""}`} href={`/schedule/${slug}/`}>
                            <div class="session-left">
                              <span class="session-time">{session.timeSlot}</span>
                              <span class="type-badge" style={isSpecial ? "background:#FF7A3C; color:#EAE6D2" : `background:${meta.bg}; color:${meta.fg}`}>
                                {isSpecial ? (isKeynote ? t.keynotesLabel : "★ Ceremony ★") : meta.label}
                              </span>
                            </div>
                            <div class="session-right">
                              <h3 class="session-title">{loc(session.title)}</h3>
                              {session.speakers && session.speakers.length > 0 && (
                                <div class="speaker-list">
                                  {session.speakers.map((sp: any) => (
                                    <div class="speaker-row">
                                      <span class="speaker-name">{sp.name}</span>
                                      {sp.title && <span class="speaker-role">{sp.title}</span>}
                                    </div>
                                  ))}
                                </div>
                              )}
                              {session.signupUrl && (
                                <span class="signup-link" data-href={session.signupUrl}>Sign Up &rarr;</span>
                              )}
                              <span class="room-track-badge" style={`--tc: ${session._trackColor}`}>
                                <span class="room-track-dot"></span>
                                {session._trackName}
                              </span>
                            </div>
                          </a>
                        )
                      })}
                    </div>
                  )}
                </div>
              )
            })
          )}
        </div>
      </div>

    </div>
  </div>

  <!-- Grid (Room × Time) panel -->
  <div class="grid-panel" style="display:none">
    <div class="grid-day-tabs">
      {gridDays.map((gd, di) => (
        <button class={`grid-day-btn${di === 0 ? " active" : ""}`} data-grid-day={gd.dayEn}>
          <span class="grid-day-label">{loc(days[di].title)}</span>
          <span class="grid-day-date">{gd.dayLabel}</span>
        </button>
      ))}
    </div>
    {gridDays.map((gd, di) => (
      <div class={`grid-table-wrap${di === 0 ? "" : " hidden"}`} data-grid-panel={gd.dayEn}>
        <div class="grid-scroll">
          <div class="tg" style={`--tg-rows: ${gd.totalRows}; height: ${40 + gd.totalRows * 20}px`}>
            {/* Sticky header row */}
            <div class="tg-hdr tg-corner">TIME</div>
            {gridRooms.map((room, ci) => (
              <div class="tg-hdr" style={`grid-column: ${ci + 2}`}>{room}</div>
            ))}

            {/* Time labels */}
            {gd.timeSlots.map((slot, ri) => {
              const m = parseInt(slot.split(":")[1])
              const is15 = m % 15 === 0
              return (
                <div class={`tg-time${is15 ? "" : " tg-time-minor"}`} style={`grid-row: ${ri + 2}`}>
                  {is15 ? slot : ""}
                </div>
              )
            })}

            {/* Horizontal grid lines (background layer) */}
            {gd.timeSlots.map((slot, ri) => {
              const m = parseInt(slot.split(":")[1])
              const is15 = m % 15 === 0
              return (
                <div
                  class={`tg-ruler${is15 ? " tg-ruler-major" : ""}`}
                  style={`grid-row: ${ri + 2}; grid-column: 2 / -1`}
                />
              )
            })}

            {/* Break time bands */}
            {BREAK_BANDS.map((band) => {
              const startIdx = gd.timeSlots.indexOf(band.start)
              const endIdx = gd.timeSlots.indexOf(band.end)
              if (startIdx < 0 || endIdx < 0) return null
              const span = endIdx - startIdx
              return (
                <div class="tg-break-band" style={`grid-row: ${startIdx + 2} / span ${span}; grid-column: 1 / -1`}>
                  <span class="tg-break-label">{band.label}</span>
                </div>
              )
            })}

            {/* Session cards */}
            {gridRooms.map((roomKey, ci) => {
              const roomPlaced = gd.placed.get(roomKey)
              if (!roomPlaced) return null
              return Array.from(roomPlaced.entries()).map(([slotTime, cell]) => {
                const ri = (cell as any).rowOffset ?? gd.timeSlots.indexOf(slotTime)
                if (ri < 0) return null
                const isBreak = cell.session.type === "break"
                const isKeynote = cell.session.type === "keynote"
                const isCeremony = cell.session.type === "ceremony"
                const isSpecial = isKeynote || isCeremony
                const isHack = isHackathon(cell.trackId)
                const typeLabel = isKeynote ? "★ KEYNOTE ★" : isCeremony ? "★ CEREMONY ★" : cell.trackName
                const labelColor = isSpecial ? "#FF7A3C" : cell.trackColor
                const borderColor = isSpecial ? "#B3A878" : cell.trackColor
                const schedBase = lang === "en" ? "/schedule" : `/${lang}/schedule`
                return (
                  <div class="tg-cell" style={`grid-row: ${ri + 2} / span ${cell.rowSpan}; grid-column: ${ci + 2}`}>
                    {isBreak ? (
                      <div class="grid-card grid-card-break">
                        <div class="grid-card-time">{cell.session.timeSlot}</div>
                        <div class="grid-card-title">{loc(cell.session.title)}</div>
                      </div>
                    ) : isHack ? (
                      <div class="grid-card grid-card-link" style={`border-left-color: ${borderColor}; cursor: pointer`}
                        data-grid-hackathon-track={cell.trackId}
                        data-grid-hackathon-day={gd.dayEn}
                      >
                        <div class="grid-card-time">{cell.session.timeSlot}</div>
                        <div class="grid-card-title">{loc(cell.session.title)}</div>
                        <div class="grid-card-track" style={`color: ${labelColor}`}>{typeLabel}</div>
                      </div>
                    ) : (
                      <a class={`grid-card grid-card-link${isSpecial ? " grid-card-keynote" : ""}`} href={`${schedBase}/${cell.slug}/`} style={!isSpecial ? `border-left-color: ${borderColor}` : ""}>
                        <div class="grid-card-time">{cell.session.timeSlot}</div>
                        <div class="grid-card-title">{loc(cell.session.title)}</div>
                        {cell.session.speakers?.length > 0 && (
                          <div class="grid-card-speakers">
                            {cell.session.speakers.map((sp: any) => typeof sp.name === 'string' ? sp.name : sp.name?.en || '').join("; ")}
                          </div>
                        )}
                        {!isSpecial && (
                          <div class="grid-card-track" style={`color: ${labelColor}`}>
                            {typeLabel}
                          </div>
                        )}
                      </a>
                    )}
                  </div>
                )
              })
            })}
          </div>
        </div>
      </div>
    ))}
  </div>

</section>

<script>
  function initPreviewSchedule(root: Element) {
    if (!(root instanceof HTMLElement) || root.dataset.previewInitialized === "true") return
    root.dataset.previewInitialized = "true"

    const buttons = root.querySelectorAll<HTMLElement>("[data-preview-track-button]")
    const panels = root.querySelectorAll<HTMLElement>("[data-preview-track-panel]")
    const availableTracks = new Set(
      Array.from(panels, (panel) => panel.dataset.previewTrackPanel).filter(Boolean),
    )

    const revealPanel = (panel: HTMLElement | undefined) => {
      if (!panel || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return
      if (typeof panel.animate !== "function") return
      panel.getAnimations?.().forEach((animation) => animation.cancel())
      panel.animate(
        [
          { opacity: 0, transform: "translateY(14px) scale(0.985)", filter: "blur(5px)" },
          { opacity: 1, transform: "translateY(0) scale(1)", filter: "blur(0)" },
        ],
        { duration: 380, easing: "cubic-bezier(0.16, 1, 0.3, 1)" },
      )
    }

    const showTrack = (trackId: string, updateHash = true) => {
      buttons.forEach((button) => {
        button.classList.toggle("active", button.dataset.previewTrackButton === trackId)
      })
      let incoming: HTMLElement | undefined
      panels.forEach((panel) => {
        const matches = panel.dataset.previewTrackPanel === trackId
        panel.style.display = matches ? "block" : "none"
        if (matches) incoming = panel
      })
      revealPanel(incoming)
      if (updateHash) history.replaceState(null, "", `#${trackId}`)
    }

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const trackId = button.dataset.previewTrackButton
        if (trackId) showTrack(trackId)
      })
    })

    const hashTrack = window.location.hash.slice(1)
    const firstTrack = panels[0]?.dataset.previewTrackPanel
    showTrack(availableTracks.has(hashTrack) ? hashTrack : firstTrack || "", false)
  }

  document.querySelectorAll(".schedule-preview-mode").forEach(initPreviewSchedule)
</script>

<script define:vars={{ firstDay, firstCat, firstRoom }}>
  let activeDay = firstDay
  let activeTrack = firstCat
  let activeRoomDay = firstDay
  let activeRoom = firstRoom

  const schedContainer = document.querySelector(".sched-container")
  const overviewPanel = document.querySelector(".overview-panel")
  const roomsPanel = document.querySelector(".rooms-panel")
  const gridPanel = document.querySelector(".grid-panel")
  const venuePanel = document.querySelector(".venue-panel")
  const overviewBtn = document.querySelector("[data-view='overview']")
  const roomsBtn = document.querySelector("[data-view='rooms']")
  const gridBtn = document.querySelector("[data-view='grid']")
  const venueBtn = document.querySelector("[data-view='venue']")
  const reduceScheduleMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches

  function revealSchedulePanel(panel) {
    if (!(panel instanceof HTMLElement) || reduceScheduleMotion) return
    if (typeof panel.animate !== "function") return
    panel.getAnimations?.().forEach((animation) => animation.cancel())
    panel.animate(
      [
        { opacity: 0, transform: "translateY(14px) scale(0.988)", filter: "blur(5px)" },
        { opacity: 1, transform: "translateY(0) scale(1)", filter: "blur(0)" },
      ],
      { duration: 380, easing: "cubic-bezier(0.16, 1, 0.3, 1)" },
    )
  }

  function hideAllPanels() {
    schedContainer.style.display = "none"
    if (overviewPanel) overviewPanel.style.display = "none"
    if (roomsPanel) roomsPanel.style.display = "none"
    if (gridPanel) gridPanel.style.display = "none"
    if (venuePanel) venuePanel.style.display = "none"
  }

  // Tell Lenis to recalculate page height after view switches
  function refreshScroll() {
    requestAnimationFrame(() => {
      if (typeof scroll !== "undefined" && scroll && scroll.resize) {
        scroll.resize()
      }
      if (typeof ScrollTrigger !== "undefined" && ScrollTrigger.refresh) {
        ScrollTrigger.refresh()
      }
    })
  }

  function setAllTabsInactive() {
    document.querySelectorAll("[data-day], [data-view]").forEach((btn) => btn.classList.remove("active"))
  }

  function showOverview() {
    setAllTabsInactive()
    overviewBtn.classList.add("active")
    hideAllPanels()
    overviewPanel.style.display = "block"
    revealSchedulePanel(overviewPanel)
    refreshScroll()
  }

  function showRooms() {
    setAllTabsInactive()
    roomsBtn.classList.add("active")
    hideAllPanels()
    roomsPanel.style.display = "block"
    showRoomPanel(activeRoomDay, activeRoom)
    revealSchedulePanel(roomsPanel)
    refreshScroll()
  }

  function showGrid() {
    setAllTabsInactive()
    gridBtn.classList.add("active")
    hideAllPanels()
    gridPanel.style.display = "block"
    revealSchedulePanel(gridPanel)
    refreshScroll()
  }

  function showVenue() {
    setAllTabsInactive()
    venueBtn.classList.add("active")
    hideAllPanels()
    venuePanel.style.display = "block"
    revealSchedulePanel(venuePanel)
    refreshScroll()
  }

  function showRoomPanel(day, room) {
    activeRoomDay = day
    activeRoom = room

    document.querySelectorAll("[data-room-day]").forEach((btn) => {
      btn.classList.toggle("active", btn.dataset.roomDay === day)
    })

    document.querySelectorAll(".room-sidebar [data-room], .mobile-room-scroll [data-room]").forEach((btn) => {
      btn.classList.toggle("active", btn.dataset.room === room)
      const roomDays = (btn.dataset.roomDays || "").split(",").filter(Boolean)
      if (roomDays.length > 0) {
        btn.classList.toggle("off-day", !roomDays.includes(day))
      }
    })

    document.querySelectorAll("[data-room-panel-day]").forEach((panel) => {
      const match = panel.dataset.roomPanelDay === day && panel.dataset.roomPanelRoom === room
      panel.style.display = match ? "block" : "none"
      if (match) revealSchedulePanel(panel)
    })
  }

  function show(day, track) {
    activeDay = day
    activeTrack = track

    hideAllPanels()
    schedContainer.style.display = ""

    setAllTabsInactive()
    document.querySelectorAll("[data-day]").forEach((btn) => {
      btn.classList.toggle("active", btn.dataset.day === day)
    })

    document.querySelectorAll("[data-track]").forEach((btn) => {
      btn.classList.toggle("active", btn.dataset.track === track)
      const catDays = (btn.dataset.catDays || "").split(",").filter(Boolean)
      const hasSessionsOnDay = catDays.length === 0 || catDays.includes(day)
      btn.classList.toggle("off-day", !hasSessionsOnDay)
    })

    document.querySelectorAll("[data-panel-day]").forEach((panel) => {
      const match = panel.dataset.panelDay === day && panel.dataset.panelTrack === track
      panel.style.display = match ? "block" : "none"
      if (match) revealSchedulePanel(panel)
    })
    refreshScroll()
  }

  if (overviewBtn) overviewBtn.addEventListener("click", showOverview)
  if (roomsBtn) roomsBtn.addEventListener("click", showRooms)
  if (gridBtn) gridBtn.addEventListener("click", showGrid)
  if (venueBtn) venueBtn.addEventListener("click", showVenue)

  // Grid day tab switching
  document.querySelectorAll("[data-grid-day]").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll("[data-grid-day]").forEach((b) => b.classList.remove("active"))
      btn.classList.add("active")
      document.querySelectorAll("[data-grid-panel]").forEach((p) => {
        const match = p.dataset.gridPanel === btn.dataset.gridDay
        p.classList.toggle("hidden", !match)
        if (match) revealSchedulePanel(p)
      })
      refreshScroll()
    })
  })

  document.querySelectorAll("[data-day]").forEach((btn) => {
    btn.addEventListener("click", () => show(btn.dataset.day, activeTrack))
  })

  document.querySelectorAll("[data-track]").forEach((btn) => {
    btn.addEventListener("click", () => show(activeDay, btn.dataset.track))
  })

  document.querySelectorAll("[data-switch-day]").forEach((btn) => {
    btn.addEventListener("click", () => show(btn.dataset.switchDay, activeTrack))
  })

  // Room view event listeners
  document.querySelectorAll("[data-room-day]").forEach((btn) => {
    btn.addEventListener("click", () => showRoomPanel(btn.dataset.roomDay, activeRoom))
  })

  document.querySelectorAll("[data-room]").forEach((btn) => {
    btn.addEventListener("click", () => showRoomPanel(activeRoomDay, btn.dataset.room))
  })


  document.querySelectorAll("[data-overview-track]").forEach((card) => {
    card.addEventListener("click", () => {
      const track = card.dataset.overviewTrack
      const day = card.dataset.overviewDay
      if (track) show(day || firstDay, track)
    })
  })

  document.querySelectorAll("[data-grid-hackathon-track]").forEach((card) => {
    card.addEventListener("click", () => {
      const track = card.dataset.gridHackathonTrack
      const day = card.dataset.gridHackathonDay
      if (track) show(day || firstDay, track)
    })
  })

  document.querySelectorAll(".signup-link[data-href]").forEach((el) => {
    el.addEventListener("click", (e) => {
      e.preventDefault()
      e.stopPropagation()
      window.open(el.dataset.href, "_blank", "noopener")
    })
  })

  const hashTrack = window.location.hash.slice(1)
  const hashBtn = hashTrack && document.querySelector(`.sched-sidebar [data-track="${hashTrack}"]`)
  if (hashBtn) {
    const catDays = (hashBtn.dataset.catDays || "").split(",").filter(Boolean)
    const targetDay = catDays.includes(firstDay) ? firstDay : (catDays[0] || firstDay)
    show(targetDay, hashTrack)
  } else {
    show(firstDay, firstCat)
  }
</script>

