---
import { conferenceDays, groupScheduleDays } from "utils/preview-schedule-days"
import { schedule as schedulePreview } from "utils/conference"
import { speakersEn as speakersEn } from "utils/conference";
import { speakersZh as speakersZh } from "utils/conference";
import {
  getSpeakerImagePath,
  SPEAKER_IMAGE_FALLBACK_HANDLER,
} from "utils/speaker-images"
import { programCategoryColor } from "utils/program-colors"
import "styles/SchedulePreview.scss"

interface Props {
  lang?: "en" | "zh"
  speakerBasePath?: string
}

const { lang = "en", speakerBasePath = "/speakers/" } = Astro.props
const previewLang: "en" | "zh" = lang === "zh" ? "zh" : "en"
const previewCopy = {
  en: {
    sidebarTitle: "Browse schedule",
    sidebarAria: "Schedule categories",
    tracks: "Tracks",
    workshops: "Workshops",
    sessions: (count: number) => `${count} talk${count === 1 ? "" : "s"}`,
    summary: (talks: number, categories: number) => `All ${talks} talks · ${categories} program categories`,
    note: "Remaining dates, times, and rooms will be added once confirmed.",
  },
  zh: {
    sidebarTitle: "筛选议程",
    sidebarAria: "议程分类",
    tracks: "分论坛主题",
    workshops: "工作坊",
    sessions: (count: number) => `${count} 场演讲`,
    summary: (talks: number, categories: number) => `全部共 ${talks} 场演讲 · ${categories} 个议程分类`,
    note: "其余日期、时间与会场确认后将在此补充。",
  },
}[previewLang]
const previewTalkCount = schedulePreview.tracks.reduce(
  (count, track) => count + track.talks.length,
  0,
)
const previewFirstTrackId = schedulePreview.tracks[0]?.id
const previewSidebarGroups = [
  {
    id: "tracks",
    label: previewCopy.tracks,
    tracks: schedulePreview.tracks.filter((track) => !track.id.startsWith("ws-")),
  },
  {
    id: "workshops",
    label: previewCopy.workshops,
    tracks: schedulePreview.tracks.filter((track) => track.id.startsWith("ws-")),
  },
].filter((group) => group.tracks.length > 0)
const previewSpeakerData = previewLang === "zh" ? speakersZh : speakersEn
const previewSpeakerById = new Map(
  previewSpeakerData.speakers.map((speaker: any) => [speaker.id, speaker]),
)
const previewScheduleBasePath = previewLang === "zh" ? "/zh/schedule/" : "/schedule/"
const previewSpeakerBasePath = previewLang === "zh" ? "/zh/speakers/" : speakerBasePath

const trackColor = programCategoryColor
---

<section class="schedule-preview-mode" data-bg-section="lightgray" data-theme-section="light">
    <div class="preview-container">
      <div class="preview-body">
        <aside class="preview-sidebar" aria-label={previewCopy.sidebarAria}>
          <div class="preview-sidebar-heading">
            <p class="preview-sidebar-title">{previewCopy.sidebarTitle}</p>
            <p class="preview-sidebar-summary">
              {previewCopy.summary(previewTalkCount, schedulePreview.tracks.length)}
            </p>
          </div>
          {previewSidebarGroups.map((group) => (
            <div class="preview-track-group" data-preview-track-group={group.id}>
              <p class="preview-group-label">{group.label}</p>
              <div class="preview-track-options">
                {group.tracks.map((track) => (
                  <button
                    class={`preview-track-button${track.id === previewFirstTrackId ? " active" : ""}`}
                    data-preview-track-button={track.id}
                    style={`--tc: ${trackColor(track.id)}`}
                    type="button"
                  >
                    <span class="preview-track-dot"></span>
                    <span>{track.name[previewLang]}</span>
                  </button>
                ))}
              </div>
            </div>
          ))}
        </aside>

        <div class="preview-main">
          <div class="preview-mobile-tracks">
            <p class="preview-group-label">{previewCopy.tracks}</p>
            <div class="preview-mobile-pills">
              {schedulePreview.tracks.map((track, index) => (
                <button
                  class={`preview-mobile-pill${index === 0 ? " active" : ""}`}
                  data-preview-track-button={track.id}
                  style={`--tc: ${trackColor(track.id)}`}
                  type="button"
                >
                  {track.name[previewLang]}
                </button>
              ))}
            </div>
          </div>

          {schedulePreview.tracks.map((track, trackIndex) => {
            const groups = groupScheduleDays(track.talks)
            const firstDay = groups.find((group) => group.talks.length > 0)?.date
            return (
            <div
              class="preview-track-panel"
              data-preview-track-panel={track.id}
              style={trackIndex === 0 ? undefined : "display:none"}
            >
              <div class="preview-panel-header" style={`--tc: ${trackColor(track.id)}`}>
                <h2>{track.name[previewLang]}</h2>
                <span>{previewCopy.sessions(track.talks.length)}</span>
              </div>

              {"notice" in track && <p class="preview-workshop-notice">{track.notice[previewLang]}</p>}

              <div class="preview-day-nav" aria-label={previewLang === "zh" ? "选择日期" : "Choose day"}>
                {groups.filter((group) => conferenceDays.some((day) => day.date === group.date) || group.talks.length > 0).map((group) => {
                  const day = conferenceDays.find((day) => day.date === group.date)
                  return (
                    <button type="button" class="preview-day-button"
                      data-preview-day-button={group.date}
                      aria-pressed={group.date === firstDay ? "true" : "false"}
                      disabled={group.talks.length === 0}>
                      <strong>{day?.label || (group.date === "unscheduled" ? (previewLang === "zh" ? "日期待定" : "Date TBA") : group.date)}</strong>
                      {day && <span>{day[previewLang]}</span>}
                    </button>
                  )
                })}
              </div>
              {groups.filter((group) => group.talks.length > 0).map((group) => (
              <div class="preview-session-list" data-preview-day-panel={group.date} hidden={group.date !== firstDay}>
                {group.talks.map((talk) => {
                  const talkSpeakers = talk.speakers
                    .map((speakerId) => previewSpeakerById.get(speakerId))
                    .filter(Boolean) as any[]
                  return (
                    <article class="preview-session-card" style={`--tc: ${trackColor(track.id)}`}>
                      <a
                        class="preview-session-cell-link"
                        href={`${previewScheduleBasePath}${talk.slug}/`}
                        aria-label={talk.title[previewLang]}
                      ></a>
                      <div class="preview-session-time">
                        {"timeSlot" in talk && talk.timeSlot ? String(talk.timeSlot).split("-").map((time, index) => (
                          <span class={index === 0 ? "preview-time-start" : "preview-time-end"}>{time}</span>
                        )) : <span class="preview-time-pending">{previewLang === "zh" ? "时间待定" : "Time TBA"}</span>}
                      </div>
                      <div class="preview-session-content">
                        <h3>{talk.title[previewLang]}</h3>
                      </div>
                      <div class="preview-session-speakers">
                        {talkSpeakers.map((speaker) => (
                          <a
                            class="preview-speaker-link"
                            href={`${previewSpeakerBasePath}${speaker.id}/`}
                          >
                            <img
                              src={getSpeakerImagePath(speaker.id)}
                              onerror={SPEAKER_IMAGE_FALLBACK_HANDLER}
                              alt=""
                              loading="lazy"
                            />
                            <span>
                              <strong>{speaker.name}</strong>
                              {speaker.roleOrg && <small>{speaker.roleOrg}</small>}
                            </span>
                          </a>
                        ))}
                      </div>
                    </article>
                  )
                })}
              </div>
              ))}
            </div>
          )})}

          <p class="preview-note">{previewCopy.note}</p>
        </div>
      </div>
    </div>
  </section>

<script>
  function initPreviewSchedule(root: Element) {
    if (!(root instanceof HTMLElement) || root.dataset.previewInitialized === "true") return
    root.dataset.previewInitialized = "true"

    const buttons = root.querySelectorAll<HTMLElement>("[data-preview-track-button]")
    const panels = root.querySelectorAll<HTMLElement>("[data-preview-track-panel]")
    panels.forEach((panel) => {
      const dayButtons = panel.querySelectorAll<HTMLButtonElement>("[data-preview-day-button]")
      const dayPanels = panel.querySelectorAll<HTMLElement>("[data-preview-day-panel]")
      dayButtons.forEach((button) => button.addEventListener("click", () => {
        if (button.disabled) return
        dayButtons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)))
        dayPanels.forEach((item) => { item.hidden = item.dataset.previewDayPanel !== button.dataset.previewDayButton })
      }))
    })
    const availableTracks = new Set(
      Array.from(panels, (panel) => panel.dataset.previewTrackPanel).filter(Boolean),
    )

    const revealPanel = (panel: HTMLElement | undefined) => {
      if (!panel || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return
      if (typeof panel.animate !== "function") return
      panel.getAnimations?.().forEach((animation) => animation.cancel())
      panel.animate(
        [
          { opacity: 0, transform: "translateY(14px) scale(0.985)", filter: "blur(5px)" },
          { opacity: 1, transform: "translateY(0) scale(1)", filter: "blur(0)" },
        ],
        { duration: 380, easing: "cubic-bezier(0.16, 1, 0.3, 1)" },
      )
    }

    const showTrack = (trackId: string, updateHash = true) => {
      buttons.forEach((button) => {
        button.classList.toggle("active", button.dataset.previewTrackButton === trackId)
      })
      let incoming: HTMLElement | undefined
      panels.forEach((panel) => {
        const matches = panel.dataset.previewTrackPanel === trackId
        panel.style.display = matches ? "block" : "none"
        if (matches) incoming = panel
      })
      revealPanel(incoming)
      if (updateHash) history.replaceState(null, "", `#${trackId}`)
    }

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const trackId = button.dataset.previewTrackButton
        if (trackId) showTrack(trackId)
      })
    })

    const hashTrack = window.location.hash.slice(1)
    const firstTrack = panels[0]?.dataset.previewTrackPanel
    showTrack(availableTracks.has(hashTrack) ? hashTrack : firstTrack || "", false)
  }

  document.querySelectorAll(".schedule-preview-mode").forEach(initPreviewSchedule)
</script>
