---
// Components
import Button from "components/Button.astro"
import Logo from "./Logo.astro"
import { eventPhotoAlbumUrl, eventSummary } from "utils/event-summary"
import { conferenceNavigation } from "utils/conference-navigation"

const rawLinks = conferenceNavigation("en")
const copy = eventSummary.en

const slug = Astro.url.pathname
const isZhPath = slug.startsWith("/zh/")
const isFrPath = slug.startsWith("/fr/")
const basePath = isZhPath ? slug.replace(/^\/zh/, "") : isFrPath ? slug.replace(/^\/fr/, "") : slug
const switchPath = isZhPath ? slug.replace("/zh/", "/") : `/zh${slug}`

// Pages that exist in English only — the Chinese site has no localized version.
// Without this guard the 中文 toggle prepends "/zh" and lands on a 404
// (e.g. /zh/general-travel/, /zh/chinese-visa/), so fall back to the zh homepage.
const enOnlyBasePaths = ["/general-travel/", "/chinese-visa/", "/travel-fund-policy/"]
const zhTogglePath = enOnlyBasePaths.includes(basePath) ? "/zh/" : `/zh${basePath}`

// Only the speakers list renders the mobile filter panel. Keep the control out
// of every other page so the shared header never exposes a dead action.
const hasFilter = basePath === "/speakers/"

// If not on the homepage, prefix anchor links with the homepage path
const isHomepage = slug === "/" || slug === "/zh/" || slug === "/fr/"
const anchorBase = isHomepage ? "" : isZhPath ? "/zh/" : isFrPath ? "/fr/" : "/"
const links = rawLinks.map(l => l.anchor ? { ...l, link: `${anchorBase}${l.anchor}` } : l) as Array<{ text: string; link: string; anchor?: string; openInNewTab?: boolean; subLinks?: any[] }>

const normalizePath = (path: string) => path === "/" ? "/" : path.replace(/\/$/, "")
const currentPath = normalizePath(slug)
const isNavigationLinkActive = (link?: string) => {
  if (!link?.startsWith("/")) return false
  const linkPath = normalizePath(link)
  return linkPath === "/"
    ? currentPath === "/"
    : currentPath === linkPath || currentPath.startsWith(`${linkPath}/`)
}
---

<header>
  <div class="mobile-nav">
    <div class="overlay overlay-dark" data-navigation-toggle="close"></div>

    <div class="mobile-nav-box" data-lenis-prevent>
      <div class="box-row box-row-logo">
        <a href="/" aria-label="Go to homepage" class="logo-click">
          <Logo />
        </a>
      </div>
      <nav class="box-row box-row-nav" aria-label="Navigation Mobile">
        <ul>
          {
            links.map((loop) => (
              <li
                class={`link link-hover ${loop.subLinks ? "has-sublinks" : ""}`}
                data-barba-update
                data-link-status={(isNavigationLinkActive(loop.link) || loop.subLinks?.some(item => isNavigationLinkActive(item.link))) ? "active" : "not-active"}
                data-has-sublinks={loop.subLinks ? "true" : "false"}
                data-sublinks={
                  loop.subLinks ? JSON.stringify(loop.subLinks) : "[]"
                }
              >
                {loop?.subLinks ? (
                  <button class="link-click" aria-expanded="false">
                    <span>{loop.text}</span>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="ml-2 inline-block"
                    >
                      <path d="m6 9 6 6 6-6" />
                    </svg>
                  </button>
                ) : (
                  <a class="link-click" href={loop.link} aria-current={isNavigationLinkActive(loop.link) ? "page" : undefined} target={loop.openInNewTab ? "_blank" : undefined} rel={loop.openInNewTab ? "noopener noreferrer" : undefined}>
                    <span>{loop.text}</span>
                  </a>
                )}
              </li>
            ))
          }
          <li class="link link-hover mobile-language-item">
            <div class="language-mobile-menu">
              <a
                class="language-item"
                href={zhTogglePath}
                onclick="localStorage.setItem('language_preference', 'zh'); sessionStorage.setItem('language_just_switched', 'true');"
                >中文</a
              >
              <a
                class="language-item active"
                href={basePath}
                onclick="localStorage.setItem('language_preference', 'en')"
                >English</a
              >
            </div>
          </li>
        </ul>
      </nav>
      <div class="box-row box-row-btn">
        <Button text={copy.albumLabel} link={eventPhotoAlbumUrl} openInNewTab={true} class="btn primary glass-orange xl btn-hover" />
        <Button text={copy.slidesLabel} link={copy.slidesDownloadPath} slidesDownload={true} class="btn primary glass-orange xl btn-hover" />
      </div>
    </div>
  </div>

  <div class="floating-controls">
    <button
      class="hamburger btn-floating"
      aria-label="Open menu"
      aria-expanded="false"
      data-navigation-toggle="toggle"
    >
      <div class="hamburger-fill"></div>
      <div class="bar bar-top"></div>
      <div class="bar bar-bottom"></div>
    </button>

    <div class="floating-photo-button">
      <Button
        text={copy.albumShortLabel}
        link={eventPhotoAlbumUrl}
        openInNewTab={true}
        class="btn primary glass-orange btn-floating btn-hover"
      />
      <Button
        text={copy.slidesShortLabel}
        link={copy.slidesDownloadPath}
        slidesDownload={true}
        class="btn primary glass-orange btn-floating btn-hover"
      />
    </div>

    {hasFilter && (
      <button
        type="button"
        aria-label="Open speaker filters"
        aria-expanded="false"
        class="btn primary glass-orange btn-floating btn-filter btn-filter-floating btn-hover"
        >
        <div class="btn-click" data-filter-toggle="toggle">
          <div class="btn-content duplicate">
            <div class="btn-fill"></div>
            <span>Filter</span>
          </div>
          <div class="border-box"></div>
        </div>
      </button>
    )}
  </div>

  <div
    class="main-nav-bar"
    style="opacity: 1;"

  >
    <div class="overlay nav-fill"></div>
    <div class="row">
      <div class="border-bottom"></div>

      <div class="logo">
        <a href="/" aria-label="Go to homepage" class="logo-click">
          <Logo />
          <Logo />
        </a>
      </div>

      <nav aria-label="Navigation Desktop">
        <ul>
          {
            links.map((loop) => (
              <li
                class={`link link-hover ${loop.subLinks ? "has-sublinks" : ""}`}
                style="position: relative;"
                data-barba-update
                data-link-status={(isNavigationLinkActive(loop.link) || loop.subLinks?.some(item => isNavigationLinkActive(item.link))) ? "active" : "not-active"}
                data-has-sublinks={loop.subLinks ? "true" : "false"}
                data-sublinks={
                  loop.subLinks ? JSON.stringify(loop.subLinks) : "[]"
                }
              >
                {loop?.subLinks ? (
                  <button class="link-click" aria-expanded="false">
                    <span>{loop.text}</span>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="ml-2 inline-block"
                    >
                      <path d="m6 9 6 6 6-6" />
                    </svg>
                  </button>
                ) : (
                  <a class="link-click" href={loop.link} aria-current={isNavigationLinkActive(loop.link) ? "page" : undefined} target={loop.openInNewTab ? "_blank" : undefined} rel={loop.openInNewTab ? "noopener noreferrer" : undefined}>
                    <span>{loop.text}</span>
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="header-buttons">
        <div class="language-dropdown">
          <button class="language-btn" aria-label="Choose language" aria-expanded="false">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path
                d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
              ></path>
            </svg>
          </button>
          <div class="language-dropdown-content">
            <a
              href={zhTogglePath}
              onclick="localStorage.setItem('language_preference', 'zh'); sessionStorage.setItem('language_just_switched', 'true');"
              >中文</a
            >
            <a
              href={basePath}
              class="active"
              onclick="localStorage.setItem('language_preference', 'en')"
              >English</a
            >
          </div>
        </div>
        <Button text={copy.albumLabel} link={eventPhotoAlbumUrl} openInNewTab={true} class="btn primary glass-orange xl btn-hover" />
        <Button text={copy.slidesLabel} link={copy.slidesDownloadPath} slidesDownload={true} class="btn primary glass-orange xl btn-hover" />
      </div>
      <button class="hamburger outline" type="button" aria-label="Open menu" aria-expanded="false" data-navigation-toggle="toggle">
        <div class="hamburger-fill"></div>
        <div class="bar bar-top"></div>
        <div class="bar bar-bottom"></div>
      </button>

      {hasFilter && (
        <button class="btn primary glass-orange btn-filter btn-filter-static btn-hover" type="button" aria-label="Open speaker filters" aria-expanded="false">
          <div class="btn-click" data-filter-toggle="toggle">
            <div class="btn-content duplicate">
              <div class="btn-fill"></div>
              <span>Filter</span>
            </div>
            <div class="border-box"></div>
          </div>
        </button>
      )}
    </div>
  </div>
</header>
