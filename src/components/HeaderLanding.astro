---
// Components
import Button from "components/Button.astro"
import Logo from "./Logo.astro"
import NotificationBar from "components/NotificationBar.astro"

const hasNotificationBar = false // Set this to false when NotificationBar is removed or page will crash

const rawLinks = [
  {
    text: "Tracks",
    anchor: "#tracks",
  },
  {
    text: "Speakers",
    link: "/speakers/",
  },
  {
    text: "Co-located Events",
    subLinks: [
      {
        text: "Spotlight",
        link: "https://spotlight.gosim.org/#current",
        openInNewTab: true,
      },
      {
        text: "AI Vision Forum",
        link: "https://shenzhen2026.visionforum.ai",
        openInNewTab: true,
      },
    ],
  },
  {
    text: "Volunteers",
    link: "/volunteers/",
  },
  {
    text: "Venue",
    link: "/venue/",
  },
  {
    text: "Past Supporters",
    link: "/past-sponsors/",
  },
  {
    text: "Travel",
    subLinks: [
      {
        text: "General Travel Info",
        link: "/general-travel/",
      },
      {
        text: "Chinese Visa",
        link: "/chinese-visa/",
      },
    ],
  },
]

const slug = Astro.url.pathname
const isZhPath = slug.startsWith("/zh/")
const isFrPath = slug.startsWith("/fr/")
const basePath = isZhPath ? slug.replace(/^\/zh/, "") : isFrPath ? slug.replace(/^\/fr/, "") : slug
const switchPath = isZhPath ? slug.replace("/zh/", "/") : `/zh${slug}`

// Pages that exist in English only — the Chinese site has no localized version.
// Without this guard the 中文 toggle prepends "/zh" and lands on a 404
// (e.g. /zh/general-travel/, /zh/chinese-visa/), so fall back to the zh homepage.
const enOnlyBasePaths = ["/general-travel/", "/chinese-visa/", "/travel-fund-policy/"]
const zhTogglePath = enOnlyBasePaths.includes(basePath) ? "/zh/" : `/zh${basePath}`

// The "Filter" button only does something on pages that render a filter panel
// (speakers / sponsors / past-supporters lists). Everywhere else it was showing
// as an empty, dead pill, so only render it on those pages.
const hasFilter = ["/speakers/", "/sponsors/"].includes(basePath)

// If not on the homepage, prefix anchor links with the homepage path
const isHomepage = slug === "/" || slug === "/zh/" || slug === "/fr/"
const anchorBase = isHomepage ? "" : isZhPath ? "/zh/" : isFrPath ? "/fr/" : "/"
const links = rawLinks.map(l => l.anchor ? { ...l, link: `${anchorBase}${l.anchor}` } : l) as Array<{ text: string; link: string; anchor?: string; openInNewTab?: boolean; subLinks?: any[] }>
---

<header>
  {
    hasNotificationBar && (
      <NotificationBar
        text="🎉 Try the GOSIM Ticket 🎟 Lucky Draw! ✨"
        link="https://x.com/gosimfoundation/status/1912744752925282408"
      />
    )
  }

  <div class="mobile-nav">
    <div class="overlay overlay-dark" data-navigation-toggle="close"></div>

    <div class="mobile-nav-box">
      <div class="box-row box-row-logo">
        <a href="/" aria-label="Go to homepage" class="logo-click">
          <Logo />
        </a>
      </div>
      <nav class="box-row box-row-nav" aria-label="Navigation Mobile">
        <ul>
          {
            links.map((loop) => (
              <li
                class={`link link-hover ${loop.subLinks ? "has-sublinks" : ""}`}
                data-barba-update
                data-link-status={loop.link === slug ? "active" : "not-active"}
                data-has-sublinks={loop.subLinks ? "true" : "false"}
                data-sublinks={
                  loop.subLinks ? JSON.stringify(loop.subLinks) : "[]"
                }
              >
                {loop?.subLinks ? (
                  <button class="link-click">
                    <span>{loop.text}</span>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="ml-2 inline-block"
                    >
                      <path d="m6 9 6 6 6-6" />
                    </svg>
                  </button>
                ) : (
                  <a class="link-click" href={loop.link} target={loop.openInNewTab ? "_blank" : undefined} rel={loop.openInNewTab ? "noopener noreferrer" : undefined}>
                    <span>{loop.text}</span>
                  </a>
                )}
              </li>
            ))
          }
          <li class="link link-hover mobile-language-item">
            <div class="language-mobile-menu">
              <a
                class="language-item"
                href={zhTogglePath}
                onclick="localStorage.setItem('language_preference', 'zh'); sessionStorage.setItem('language_just_switched', 'true');"
                >中文</a
              >
              <a
                class="language-item active"
                href={basePath}
                onclick="localStorage.setItem('language_preference', 'en')"
                >English</a
              >
            </div>
          </li>
        </ul>
      </nav>
      <div class="box-row box-row-btn">
        <Button text="Call for Proposals" link="https://cfp.gosim.org" openInNewTab={true} class="btn light xl btn-hover" />
        <Button text="Buy Tickets" link="https://www.bagevent.com/event/gosimshenzhen2026#website_moduleId_1164696" openInNewTab={true} class="btn primary glass-orange xl btn-hover" />
      </div>
    </div>
  </div>

  <div class="floating-controls">
    <button
      class="hamburger btn-floating"
      aria-label="Open menu"
      data-navigation-toggle="toggle"
      data-has-notification={hasNotificationBar}
    >
      <div class="hamburger-fill"></div>
      <div class="bar bar-top"></div>
      <div class="bar bar-bottom"></div>
    </button>

    <div class="floating-ticket-button">
      <Button
        text="Buy Tickets"
        link="https://www.bagevent.com/event/gosimshenzhen2026#website_moduleId_1164696"
        openInNewTab={true}
        class="btn primary glass-orange btn-floating btn-hover"
      />
    </div>
  </div>

  {hasFilter && (
    <div
      class="btn light btn-filter btn-filter-floating btn-hover"
      data-has-notification={hasNotificationBar}
    >
      <div class="btn-click filter-alpha-animate" data-filter-toggle="toggle">
        <div class="btn-content original">
          <div class="btn-fill"></div>
          <span>Filter</span>
        </div>
        <div class="border-box"></div>
      </div>
    </div>
  )}

  <div
    class="main-nav-bar"
    style="opacity: 1;"
    data-has-notification={hasNotificationBar}
  >
    <div class="overlay nav-fill"></div>
    <div class="row">
      <div class="border-bottom"></div>

      <div class="logo">
        <a href="/" aria-label="Go to homepage" class="logo-click">
          <Logo />
          <Logo />
        </a>
      </div>

      <nav aria-label="Navigation Desktop">
        <ul>
          {
            links.map((loop) => (
              <li
                class={`link link-hover ${loop.subLinks ? "has-sublinks" : ""}`}
                style="position: relative;"
                data-barba-update
                data-link-status={loop.link === slug ? "active" : "not-active"}
                data-has-sublinks={loop.subLinks ? "true" : "false"}
                data-sublinks={
                  loop.subLinks ? JSON.stringify(loop.subLinks) : "[]"
                }
              >
                {loop?.subLinks ? (
                  <button class="link-click">
                    <span>{loop.text}</span>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="ml-2 inline-block"
                    >
                      <path d="m6 9 6 6 6-6" />
                    </svg>
                  </button>
                ) : (
                  <a class="link-click" href={loop.link} target={loop.openInNewTab ? "_blank" : undefined} rel={loop.openInNewTab ? "noopener noreferrer" : undefined}>
                    <span>{loop.text}</span>
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="header-buttons">
        <div class="language-dropdown">
          <button class="language-btn">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path
                d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
              ></path>
            </svg>
          </button>
          <div class="language-dropdown-content">
            <a
              href={zhTogglePath}
              onclick="localStorage.setItem('language_preference', 'zh'); sessionStorage.setItem('language_just_switched', 'true');"
              >中文</a
            >
            <a
              href={basePath}
              class="active"
              onclick="localStorage.setItem('language_preference', 'en')"
              >English</a
            >
          </div>
        </div>
        <Button text="Call for Proposals" link="https://cfp.gosim.org" openInNewTab={true} class="btn light btn-hover" />
        <Button text="Buy Tickets" link="https://www.bagevent.com/event/gosimshenzhen2026#website_moduleId_1164696" openInNewTab={true} class="btn primary glass-orange btn-hover" />
      </div>
      <div class="hamburger outline" data-navigation-toggle="toggle">
        <div class="hamburger-fill"></div>
        <div class="bar bar-top"></div>
        <div class="bar bar-bottom"></div>
      </div>

      {hasFilter && (
        <div class="btn light btn-filter btn-filter-static btn-hover">
          <div class="btn-click filter-alpha-animate" data-filter-toggle="toggle">
            <div class="btn-content original">
              <div class="btn-fill"></div>
              <span>Filter</span>
            </div>
            <div class="border-box"></div>
          </div>
        </div>
      )}
    </div>
  </div>
</header>

<style>
  .floating-ticket-button {
    position: relative;
    z-index: 201;
  }

  .floating-ticket-button :global(.btn-floating) {
    position: relative;
    top: auto;
    right: auto;
  }

  /* Ensure notification bar is clickable */
  :global(.notification-bar) {
    position: relative;
    z-index: 20; /* Higher than other header elements */
    width: 100%;
    pointer-events: auto;
  }

  .main-nav-bar[data-has-notification="true"] {
    padding-top: calc(var(--row-gap) + 45px);
  }

  .hamburger.btn-floating[data-has-notification="true"],
  .btn.btn-filter-floating[data-has-notification="true"] {
    margin-top: 32px;
  }

  /* Language dropdown styles */
  .header-buttons {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: inherit; /* Ensure header buttons inherit text color for icon */
  }

  /* The English labels and two CTAs need more horizontal room than the
     Chinese header. Give the menu its own flexible grid column instead of
     centring it over the CTAs, and keep its spacing compact on laptops. */
  .main-nav-bar .row {
    display: grid;
    grid-template-columns: 7em minmax(0, 1fr) auto;
    column-gap: clamp(1rem, 1.5vw, 1.75rem);
  }

  .main-nav-bar nav {
    position: static;
    width: auto;
    min-width: 0;
    transform: none;
    justify-self: center;
  }

  .main-nav-bar nav ul {
    gap: clamp(0.75rem, 1.35vw, 1.6rem);
    white-space: nowrap;
  }

  .header-buttons :global(.btn .btn-content) {
    padding-inline: 1rem;
  }

  .language-dropdown {
    position: relative;
    display: inline-block;
    color: inherit; /* Inherit text color from parent */
  }

  .language-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    transition: color 0.3s ease;
  }

  /* Ensure the globe icon inherits the text color */
  .language-btn svg {
    color: inherit;
    stroke: currentColor;
    transition: color 0.3s;
  }

  .language-dropdown-content {
    display: none;
    position: absolute;
    background-color: #f9f9f9;
    min-width: 120px;
    box-shadow: 0px 8px 16px 0px rgba(0, 0, 0, 0.2);
    z-index: 1;
    border-radius: 4px;
    right: 0;
  }

  .language-dropdown-content a {
    color: black;
    padding: 12px 16px;
    text-decoration: none;
    display: block;
    text-align: left;
  }

  .language-dropdown-content a:hover {
    background-color: #f1f1f1;
  }

  .language-dropdown-content a.active {
    font-weight: bold;
    background-color: #e9e9e9;
  }

  .language-dropdown:hover .language-dropdown-content {
    display: block;
  }

  /* Mobile language menu */
  .mobile-language-item {
    margin-top: 15px;
  }

  .language-mobile-menu {
    display: flex;
    justify-content: center;
    gap: 15px;
    padding: 10px 0;
  }

  .language-item {
    padding: 5px 10px;
    border-radius: 4px;
    text-decoration: none;
  }

  .language-item.active {
    font-weight: bold;
    background-color: rgba(255, 255, 255, 0.1);
  }

  @media screen and (max-width: 1070px) {
    .language-dropdown {
      position: absolute;
      left: 130px;
    }
  }

  @media screen and (min-width: 1071px) and (max-width: 1250px) {
    .main-nav-bar nav ul {
      gap: 0.7rem;
    }

    .main-nav-bar nav .link-click span {
      font-size: 0.82em;
    }
  }

  @media screen and (max-width: 1070px) {
    .main-nav-bar .row {
      display: flex;
    }
  }
</style>
