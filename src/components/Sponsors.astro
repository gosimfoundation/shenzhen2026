---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

// Import the partners data
import sponsorsData from "json/Sponsors.json";

interface Props {
    lang?: "en" | "zh" | "fr";
}

const { lang = "en" } = Astro.props;

// Sponsor boards use the bilingual labels shown in the event visual system.
const getCategoryNames = (category: any): { zh: string; en: string } => {
    if (typeof category.name === "string") {
        return { zh: category.name, en: category.name };
    }

    return {
        zh: category.name.zh || category.name[lang] || category.name.en,
        en: category.name.en || category.name[lang] || category.name.zh,
    };
};

// Import all images
const images = import.meta.glob<{ default: ImageMetadata }>(
    "images/sponsors/*.{jpeg,jpg,png,gif}",
);

const isRemoteImage = (image?: string): boolean =>
    Boolean(image && /^https?:\/\//.test(image));
---

<section
    class="section section-partners-grid"
    id="grid"
    data-filter-section
    data-theme-section="light"
    data-bg-section="lightgray"
>
    <div class="container">
        <div class="grid-wrap visible" data-filter-grid>
            {
                sponsorsData.categories.map(
                    (category) =>
                        category.id !== "all" &&
                        sponsorsData.partners.some(
                            (partner) => partner.category === category.id,
                        ) && (
                            <div
                                class:list={["grid-group", {
                                    "grid-group-featured": ["host", "co-organizer", "chief"].includes(category.id),
                                }]}
                                data-filter-status="active"
                                data-filter-category={category.id}
                            >
                                <div class="category-heading-row">
                                    <h2 class="h3 category-heading">
                                        <span>{getCategoryNames(category).zh}</span>
                                        <span class="category-heading-en">{getCategoryNames(category).en}</span>
                                    </h2>
                                </div>
                                <div class="row grid">
                                    {sponsorsData.partners
                                        .filter(
                                            (partner) =>
                                                partner.category ===
                                                category.id,
                                        )
                                        .map((partner) => (
                                            <div class="col">
                                                <div class="single-partners-card card-hover">
                                                    {partner.url && (
                                                        <a class="sponsor-link-overlay" href={partner.url} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${partner.name} website`} />
                                                    )}
                                                    <div class="overlay card-fill" />
                                                    <div class={`card-logo boxed-logo${partner.logoClass ? ` ${partner.logoClass}` : ''}`}>
                                                        {partner?.image &&
                                                            (isRemoteImage(partner.image) ? (
                                                                <img
                                                                    class="sponsor-logo-image"
                                                                    src={partner.image}
                                                                    alt={`${partner.name} logo`}
                                                                    loading="lazy"
                                                                    decoding="async"
                                                                />
                                                            ) : (
                                                                images[
                                                                    `/public/images/sponsors/${partner.image}`
                                                                ] && (
                                                                    <Picture
                                                                        src={images[
                                                                            `/public/images/sponsors/${partner.image}`
                                                                        ]()}
                                                                        formats={["png"]}
                                                                        alt={`${partner.name} logo`}
                                                                        widths={[
                                                                            75,
                                                                            150,
                                                                            225,
                                                                            450,
                                                                        ]}
                                                                        sizes={category.id === "chief"
                                                                            ? "(max-width: 600px) 280px, 340px"
                                                                            : "(max-width: 600px) 40vw, 225px"}
                                                                    />
                                                                )
                                                            ))}
                                                    </div>
                                                </div>
                                            </div>
                                        ))}
                                </div>
                            </div>
                        ),
                )
            }
        </div>
    </div>
</section>

<style>
    .section-partners-grid {
        padding-block: clamp(1.5rem, 3vw, 2.5rem);
    }

    .section-partners-grid .container {
        max-width: 1280px;
    }

    .grid-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
    }

    .section-partners-grid .grid-group {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        gap: 0.9rem;
        padding-top: 1.75rem;
    }

    .section-partners-grid .grid-group:first-child {
        padding-top: 0;
    }

    .grid-group h2 {
        margin: 0;
        text-align: center;
        font-size: clamp(1.45rem, 2.25vw, 2.25rem);
        line-height: 1.4;
    }

    .section-partners-grid .category-heading-row {
        display: grid;
        width: 100%;
        place-items: center;
        text-align: center;
    }

    .category-heading {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: baseline;
        gap: 0 0.45em;
    }

    .category-heading-en {
        white-space: nowrap;
    }

    .section-partners-grid .grid-group-featured {
        width: 100%;
    }

    .section-partners-grid .row.grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        width: min(100%, 1120px);
        gap: 0.65rem;
    }

    .section-partners-grid .grid-group-featured .row.grid {
        width: min(100%, 240px);
    }

    .section-partners-grid .row.grid > .col {
        flex: 0 0 calc((100% - 2.6rem) / 5);
        width: calc((100% - 2.6rem) / 5);
        min-width: 0;
    }

    .section-partners-grid .grid-group-featured .row.grid > .col {
        flex-basis: 100%;
        width: 100%;
    }

    .single-partners-card {
        height: 88px;
        border-radius: 12px;
    }

    .single-partners-card::before {
        display: none;
    }

    .grid-group-featured .single-partners-card {
        height: 104px;
    }

    .single-partners-card .card-fill {
        background-color: #fff;
        border-radius: inherit;
    }

    .single-partners-card .boxed-logo,
    .single-partners-card .boxed-logo.community-logo-large,
    .single-partners-card .boxed-logo.partner-logo-wide {
        width: 100%;
        height: 100%;
        padding: 14px;
    }

    .single-partners-card .boxed-logo > * {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        max-width: 100%;
    }

    .single-partners-card .boxed-logo :global(img) {
        display: block;
        width: 100%;
        height: 100%;
        max-width: 200px;
        object-fit: contain;
        border-radius: 0;
    }

    .section-partners-grid .grid-group-featured[data-filter-category="chief"] {
        width: 100%;
    }

    .section-partners-grid .grid-group-featured[data-filter-category="chief"] .row.grid {
        width: min(100%, 380px);
    }

    [data-filter-category="chief"] .single-partners-card {
        height: 124px;
    }

    [data-filter-category="chief"] .boxed-logo :global(img) {
        max-width: 340px;
    }

    /* Large: chief; medium: gold; small: silver and supporting organizations. */
    .section-partners-grid [data-filter-category="gold"] .row.grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        width: min(100%, 970px);
    }

    .section-partners-grid [data-filter-category="gold"] .row.grid > .col {
        width: auto;
        grid-column: span 3;
    }

    /* The first row has three centered cards; the second row has four cards. */
    .section-partners-grid [data-filter-category="gold"] .row.grid > .col:nth-child(1) {
        grid-column: 2 / span 3;
    }

    .section-partners-grid [data-filter-category="gold"] .row.grid > .col:nth-child(2) {
        grid-column: 5 / span 3;
    }

    .section-partners-grid [data-filter-category="gold"] .row.grid > .col:nth-child(3) {
        grid-column: 8 / span 3;
    }

    .section-partners-grid [data-filter-category="gold"] .row.grid > .col:nth-child(4) {
        grid-column: 1 / span 3;
        grid-row: 2;
    }

    .section-partners-grid [data-filter-category="gold"] .row.grid > .col:nth-child(5) {
        grid-column: 4 / span 3;
        grid-row: 2;
    }

    .section-partners-grid [data-filter-category="gold"] .row.grid > .col:nth-child(6) {
        grid-column: 7 / span 3;
        grid-row: 2;
    }

    .section-partners-grid [data-filter-category="gold"] .row.grid > .col:nth-child(7) {
        grid-column: 10 / span 3;
        grid-row: 2;
    }

    [data-filter-category="gold"] .single-partners-card {
        height: 104px;
    }

    [data-filter-category="gold"] .boxed-logo :global(img) {
        max-width: 240px;
    }

    .sponsor-link-overlay {
        position: absolute;
        inset: 0;
        z-index: 3;
        border-radius: inherit;
    }

    .sponsor-link-overlay:focus-visible {
        outline: 2px solid var(--color-light);
        outline-offset: 4px;
    }

    @media (max-width: 1000px) {
        .section-partners-grid .row.grid {
            width: 100%;
        }

        .section-partners-grid .row.grid > .col {
            flex-basis: calc((100% - 1.3rem) / 3);
            width: calc((100% - 1.3rem) / 3);
        }

        .section-partners-grid [data-filter-category="gold"] .row.grid {
            display: flex;
            width: 100%;
        }

        .section-partners-grid [data-filter-category="gold"] .row.grid > .col {
            flex-basis: calc((100% - 0.65rem) / 2);
            width: calc((100% - 0.65rem) / 2);
            grid-column: auto;
            grid-row: auto;
        }

        .section-partners-grid .grid-group {
            gap: 0.65rem;
        }
    }

    @media (max-width: 600px) {
        .grid-wrap {
            gap: 1rem;
        }

        .section-partners-grid .row.grid > .col {
            flex-basis: calc((100% - 0.65rem) / 2);
            width: calc((100% - 0.65rem) / 2);
        }

        .section-partners-grid .grid-group-featured .row.grid > .col {
            flex-basis: 100%;
            width: 100%;
        }

        .single-partners-card,
        .grid-group-featured .single-partners-card {
            height: 88px;
        }

        [data-filter-category="gold"] .single-partners-card {
            height: 104px;
        }

        [data-filter-category="chief"] .single-partners-card {
            height: 120px;
        }

        [data-filter-category="chief"] .boxed-logo :global(img) {
            max-width: 280px;
        }

        .single-partners-card .boxed-logo,
        .single-partners-card .boxed-logo.community-logo-large,
        .single-partners-card .boxed-logo.partner-logo-wide {
            padding: 12px;
        }
    }
</style>
