---
interface Props { lang: "en" | "zh" }
const sources = [
  { name: "GitCode", url: "https://gitcode.com/gosimfoundation/shenzhen2026" },
  { name: "GitHub", url: "https://github.com/gosimfoundation/shenzhen2026-presentations" },
];
---

<div class="download-options">
  {sources.map((source) => (
    <a class="download-option" href={source.url} target="_blank" rel="noopener noreferrer" data-slides-source>
      {source.name}
    </a>
  ))}
</div>

<style>
  .download-options { display: grid; gap: 0.75rem; }
  .download-option { display: flex; align-items: center; justify-content: center; min-height: 3rem; padding: 0.75rem 1rem; border: 1px solid #d9d6cb; border-radius: 0.65rem; background: #fff; color: #24241f; font-size: 1.05rem; line-height: 1.4; font-weight: 600; text-decoration: none; transition: border-color 150ms ease, background 150ms ease; }
  .download-option:hover { border-color: #c94513; background: #fff0e5; }
  .download-option:focus-visible { outline: 3px solid #c94513; outline-offset: 4px; }
  @media (prefers-reduced-motion: reduce) { .download-option { transition: none; } }
</style>
