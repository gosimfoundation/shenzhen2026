---
import { eventSlidesDownloadUrl, eventSlidesGitCodeDownloadUrl, slidesDownloadCopy } from "utils/event-summary";

interface Props { lang: "en" | "zh" }
const { lang } = Astro.props;
const copy = slidesDownloadCopy[lang];
const sources = [
  { name: "GitCode", url: eventSlidesGitCodeDownloadUrl, note: copy.gitcodeNote },
  { name: "GitHub", url: eventSlidesDownloadUrl, note: copy.githubNote },
];
---

<p class="download-description">{copy.description}</p>
<div class="download-options">
  {sources.map((source) => (
    <a class="download-option" href={source.url} target="_blank" rel="noopener noreferrer" type="application/zip" data-slides-source>
      <strong>{source.name}</strong>
      <span class="download-note">{source.note}</span>
      <span class="download-action">{copy.downloadLabel}<span aria-hidden="true">↓</span></span>
    </a>
  ))}
</div>
<p class="download-file-info">{copy.fileInfo}</p>

<style>
  .download-description { margin: 0 0 1.5rem; color: #57564e; font-size: 1rem; line-height: 1.65; }
  .download-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .download-option { display: flex; flex-direction: column; gap: 0.65rem; padding: 1.5rem; border: 1px solid #d9d6cb; border-radius: 1rem; background: #fff; color: #24241f; text-decoration: none; transition: border-color 150ms ease, background 150ms ease; }
  .download-option:first-child { background: #fff3eb; border-color: #ef9568; }
  .download-option:hover { border-color: #c94513; background: #fff0e5; }
  .download-option:focus-visible { outline: 3px solid #c94513; outline-offset: 4px; }
  .download-option strong { color: #24241f; font-size: 1.5rem; line-height: 1.2; font-weight: 700; }
  .download-note { flex: 1; font-size: 0.9rem; line-height: 1.5; color: #57564e; }
  .download-action { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-top: 1rem; font-size: 0.95rem; font-weight: 600; color: #b63c11; }
  .download-action > span { font-size: 1.4rem; line-height: 1; }
  .download-file-info { margin: 1.25rem 0 0; font-size: 0.85rem; line-height: 1.6; color: #68665e; }
  @media (max-width: 520px) {
    .download-options { grid-template-columns: 1fr; gap: 0.75rem; }
    .download-option { padding: 1.15rem; gap: 0.45rem; }
    .download-action { padding-top: 0.5rem; }
  }
  @media (prefers-reduced-motion: reduce) { .download-option { transition: none; } }
</style>
