---
interface DeepDive {
  title: string;
  subtitle: string;
  format: string;
  description: string;
  projects: string[];
  accentFrom: string;
  accentTo: string;
}

interface Props {
  label?: string;
  title: string;
  subtitle?: string;
  dives: DeepDive[];
}

const { label = "Hands-On Experience", title, subtitle, dives } = Astro.props;

const iconSvgs = [
  // Code / App — Building an Agentic App
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
  // Bolt / Edge — Agentic AI on Edge
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
  // Chip / Hardware — Agentic Hardware
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="5" width="14" height="14" rx="2"/><path d="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3"/></svg>`,
  // Layout / UI — Agentic App UI
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>`,
];
---

<section class="section section-deep-dives" data-scroll-section>
  <div class="deep-dives-bg">
    <div class="grid-pattern"></div>
    <div class="glow glow-1"></div>
    <div class="glow glow-2"></div>
    <div class="glow glow-3"></div>
  </div>

  <div class="container">
    <div class="dd-header">
      <span class="dd-label animate-dd-fade">{label}</span>
      <h2 class="dd-title animate-dd-fade animate-dd-delay-1">{title}</h2>
      {subtitle && <p class="dd-subtitle animate-dd-fade animate-dd-delay-2">{subtitle}</p>}
    </div>

    <div class="dd-grid">
      {dives.map((dive, i) => (
        <div
          class="dd-card animate-dd-slide"
          style={`--dd-from: ${dive.accentFrom}; --dd-to: ${dive.accentTo}; --dd-stagger: ${i};`}
        >
          <div class="dd-card-glow"></div>
          <div class="dd-card-border"></div>
          <div class="dd-card-inner">
            <div class="dd-card-icon" set:html={iconSvgs[i % iconSvgs.length]} />
            <h3 class="dd-card-title">{dive.title}</h3>
            <span class="dd-card-format">{dive.format}</span>
            <p class="dd-card-subtitle">{dive.subtitle}</p>
            <p class="dd-card-desc">{dive.description}</p>
            <div class="dd-card-projects">
              {dive.projects.map((proj) => (
                <span class="dd-project-tag">{proj}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function initDeepDiveAnimations() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
    );

    document
      .querySelectorAll(".section-deep-dives .animate-dd-fade, .section-deep-dives .animate-dd-slide")
      .forEach((el) => observer.observe(el));
  }

  initDeepDiveAnimations();
  document.addEventListener("astro:page-load", initDeepDiveAnimations);
</script>

<style>
  .section-deep-dives {
    position: relative;
    padding-top: var(--section-padding);
    padding-bottom: var(--section-padding);
    overflow: hidden;
    background: var(--color-lightgray, #E8EEF4);
    color: var(--color-dark, #1c1d24);
  }

  /* Animated background */
  .deep-dives-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .grid-pattern {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(45, 78, 156, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(45, 78, 156, 0.06) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 30%, transparent 80%);
  }

  .glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.08;
    animation: glow-pulse 8s ease-in-out infinite alternate;
  }

  .glow-1 {
    width: 400px;
    height: 400px;
    background: #6366f1;
    top: -100px;
    left: 10%;
  }

  .glow-2 {
    width: 350px;
    height: 350px;
    background: #22d3ee;
    bottom: -80px;
    right: 15%;
    animation-delay: -3s;
  }

  .glow-3 {
    width: 300px;
    height: 300px;
    background: #f472b6;
    top: 40%;
    left: 50%;
    transform: translateX(-50%);
    animation-delay: -5s;
    opacity: 0.08;
  }

  @keyframes glow-pulse {
    0% { opacity: 0.05; transform: scale(1); }
    100% { opacity: 0.1; transform: scale(1.15); }
  }

  .container {
    position: relative;
    z-index: 1;
  }

  /* Header */
  .dd-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .dd-label {
    display: inline-block;
    font-size: 0.75em;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-primary, #2D4E9C);
    margin-bottom: 0.75rem;
  }

  .dd-title {
    margin: 0;
    font-size: calc(var(--title-size, 5em) * 0.4);
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-dark, #1c1d24);
  }

  .dd-subtitle {
    margin: 1rem auto 0;
    max-width: 600px;
    font-size: 1.05em;
    line-height: 1.6;
    color: rgba(28, 29, 36, 0.55);
  }

  /* Grid */
  .dd-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  /* Card */
  .dd-card {
    position: relative;
    border-radius: 16px;
    transition: transform 0.4s cubic-bezier(0.5, 0, 0.25, 1);
  }

  .dd-card:hover {
    transform: translateY(-6px);
  }

  .dd-card-glow {
    position: absolute;
    inset: -1px;
    border-radius: 17px;
    background: linear-gradient(135deg, var(--dd-from), var(--dd-to));
    opacity: 0;
    filter: blur(20px);
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .dd-card:hover .dd-card-glow {
    opacity: 0.25;
  }

  .dd-card-border {
    position: absolute;
    inset: 0;
    border-radius: 16px;
    padding: 1px;
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--dd-from) 50%, transparent),
      transparent 40%,
      transparent 60%,
      color-mix(in srgb, var(--dd-to) 30%, transparent)
    );
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
    -webkit-mask-composite: xor;
    pointer-events: none;
    transition: opacity 0.3s ease;
    opacity: 0.5;
  }

  .dd-card:hover .dd-card-border {
    opacity: 1;
  }

  .dd-card-inner {
    position: relative;
    padding: 2rem 1.75rem;
    border-radius: 16px;
    background: #1c1d24;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.06);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  /* Icon */
  .dd-card-icon {
    width: 2.5rem;
    height: 2.5rem;
    padding: 0.5rem;
    border-radius: 10px;
    background: linear-gradient(135deg, var(--dd-from), var(--dd-to));
    color: #fff;
    margin-bottom: 1.25rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .dd-card:hover .dd-card-icon {
    transform: scale(1.08);
    box-shadow: 0 4px 20px color-mix(in srgb, var(--dd-from) 40%, transparent);
  }

  .dd-card-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  /* Title */
  .dd-card-title {
    margin: 0 0 0.5rem;
    font-size: 1.3em;
    font-weight: 700;
    line-height: 1.25;
    color: #fff;
  }

  /* Format badge */
  .dd-card-format {
    display: inline-block;
    width: fit-content;
    font-size: 0.7em;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.25em 0.75em;
    border-radius: 100px;
    background: linear-gradient(135deg, var(--dd-from), var(--dd-to));
    color: #fff;
    opacity: 0.85;
    margin-bottom: 0.85rem;
  }

  /* Subtitle */
  .dd-card-subtitle {
    margin: 0 0 0.75rem;
    font-size: 0.95em;
    font-weight: 500;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.8);
  }

  /* Description */
  .dd-card-desc {
    margin: 0;
    font-size: 0.85em;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.5);
    flex: 1;
  }

  /* Project tags */
  .dd-card-projects {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .dd-project-tag {
    font-size: 0.72em;
    font-weight: 500;
    padding: 0.3em 0.7em;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.07);
    color: rgba(255, 255, 255, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: background 0.2s ease, color 0.2s ease;
  }

  .dd-card:hover .dd-project-tag {
    background: rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.85);
  }

  /* Animations */
  .animate-dd-fade {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s cubic-bezier(0.5, 0, 0.25, 1), transform 0.6s cubic-bezier(0.5, 0, 0.25, 1);
  }

  .animate-dd-fade.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .animate-dd-delay-1 { transition-delay: 0.12s; }
  .animate-dd-delay-2 { transition-delay: 0.24s; }

  .animate-dd-slide {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.6s cubic-bezier(0.5, 0, 0.25, 1), transform 0.6s cubic-bezier(0.5, 0, 0.25, 1);
    transition-delay: calc(0.12s * var(--dd-stagger, 0));
  }

  .animate-dd-slide.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Responsive */
  @media (max-width: 860px) {
    .dd-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .dd-card-inner {
      padding: 1.5rem 1.25rem;
    }

    .dd-title {
      font-size: calc(var(--title-size, 5em) * 0.32);
    }
  }
</style>
