---
interface Props {
  text?: string;
  link?: string;
  lang?: "en" | "zh" | "fr";
}

const { lang = "en" } = Astro.props;

const content = {
  en: {
    badge: "EVENT CONCLUDED",
    textBefore: "GOSIM Paris 2026 has ended — slides & photos now available!",
    price: "",
    xLink: "https://x.com/gosimfoundation",
    linkedinLink: "https://www.linkedin.com/company/gosim-foundation",
    slidesLink: "https://drive.google.com/drive/folders/1T5omH6OCFNIDaEgFtzS5Nt-e0SMU1I6g?usp=sharing",
    photosLink: "https://drive.google.com/drive/folders/1iJQHKHc1NJu06izjBK36EDncqK_JyFIp?usp=sharing",
    slidesLabel: "Slides",
    photosLabel: "Photos",
  },
  zh: {
    badge: "活动已结束",
    textBefore: "GOSIM Paris 2026 已圆满结束 — 幻灯片和照片现已发布！",
    price: "",
    xLink: "https://x.com/gosimfoundation",
    linkedinLink: "https://www.linkedin.com/company/gosim-foundation",
    slidesLink: "https://drive.google.com/drive/folders/1T5omH6OCFNIDaEgFtzS5Nt-e0SMU1I6g?usp=sharing",
    photosLink: "https://drive.google.com/drive/folders/1iJQHKHc1NJu06izjBK36EDncqK_JyFIp?usp=sharing",
    slidesLabel: "幻灯片",
    photosLabel: "照片",
  },
  fr: {
    badge: "ÉVÉNEMENT TERMINÉ",
    textBefore: "GOSIM Paris 2026 est terminé — diapositives et photos disponibles !",
    price: "",
    xLink: "https://x.com/gosimfoundation",
    linkedinLink: "https://www.linkedin.com/company/gosim-foundation",
    slidesLink: "https://drive.google.com/drive/folders/1T5omH6OCFNIDaEgFtzS5Nt-e0SMU1I6g?usp=sharing",
    photosLink: "https://drive.google.com/drive/folders/1iJQHKHc1NJu06izjBK36EDncqK_JyFIp?usp=sharing",
    slidesLabel: "Diapositives",
    photosLabel: "Photos",
  },
};

const { badge, textBefore, price, textAfter, xLink, linkedinLink, slidesLink, photosLink, slidesLabel, photosLabel } = content[lang];
---

<div class="announcement-bar">
  <div class="announcement-bar__inner">
    <span class="announcement-bar__badge">{badge}</span>
    <span class="announcement-bar__text">{textBefore} <span class="announcement-bar__price">{price}</span>{textAfter ? ` ${textAfter}` : ""}</span>
    <span class="announcement-bar__divider">·</span>
    <a href={slidesLink} target="_blank" rel="noopener noreferrer" class="announcement-bar__resource-btn">{slidesLabel}</a>
    <a href={photosLink} target="_blank" rel="noopener noreferrer" class="announcement-bar__resource-btn">{photosLabel}</a>
    <span class="announcement-bar__divider">·</span>
    <a href={xLink} target="_blank" rel="noopener noreferrer" class="announcement-bar__social-btn" aria-label="Join lucky draw on X">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.253 5.622 5.911-5.622Zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
    </a>
    <a href={linkedinLink} target="_blank" rel="noopener noreferrer" class="announcement-bar__social-btn" aria-label="Join lucky draw on LinkedIn">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
    </a>
  </div>
</div>

<style>
  .announcement-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10000;
    background: linear-gradient(90deg, #2d4e9c 0%, #6c63ff 50%, #2d4e9c 100%);
    background-size: 200% 100%;
    animation: gradient-shift 6s ease infinite;
    text-align: center;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  @keyframes gradient-shift {
    0%   { background-position: 0% 50%; }
    50%  { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  /* Rainbow bar at bottom */
  .announcement-bar::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(
      90deg,
      #ff0000,
      #ff7700,
      #ffdd00,
      #00cc44,
      #0088ff,
      #7744ff,
      #ff00cc,
      #ff0000
    );
    background-size: 200% 100%;
    animation: rainbow-slide 4s linear infinite;
  }

  @keyframes rainbow-slide {
    0%   { background-position: 0% 0%; }
    100% { background-position: 200% 0%; }
  }

  /* Subtle shimmer sweep */
  .announcement-bar::before {
    content: "";
    position: absolute;
    top: 0;
    left: -60%;
    width: 40%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
    animation: shimmer 3.5s infinite;
  }

  @keyframes shimmer {
    0%   { left: -60%; }
    100% { left: 120%; }
  }

  .announcement-bar__inner {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: #fff;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 0 1rem;
    position: relative;
  }

  .announcement-bar__badge {
    background: #f59e0b;
    color: #000;
    font-size: 0.6rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.18rem 0.5rem;
    border-radius: 3px;
    flex-shrink: 0;
  }

  .announcement-bar__text {
    color: #fff;
  }

  .announcement-bar__price {
    color: #ffe000;
    font-weight: 900;
    font-size: 1rem;
    letter-spacing: 0.02em;
    text-shadow: 0 0 8px rgba(255, 224, 0, 0.6);
  }

  .announcement-bar__divider {
    color: rgba(255,255,255,0.3);
    font-size: 1rem;
    line-height: 1;
  }

  .announcement-bar__resource-btn {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: #fff;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.35);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    padding: 0.22rem 0.5rem;
    border-radius: 4px;
    flex-shrink: 0;
    transition: background 0.15s, border-color 0.15s;
  }

  .announcement-bar__resource-btn:hover {
    background: rgba(255,255,255,0.28);
    border-color: rgba(255,255,255,0.6);
  }

  .announcement-bar__social-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    color: #fff;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.35);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    padding: 0.28rem 0.45rem;
    border-radius: 4px;
    flex-shrink: 0;
    transition: background 0.15s, border-color 0.15s;
    margin-left: 0.25rem;
  }

  .announcement-bar__social-btn:hover {
    background: rgba(255,255,255,0.28);
    border-color: rgba(255,255,255,0.6);
  }

  @media (max-width: 640px) {
    .announcement-bar__text,
    .announcement-bar__divider {
      display: none;
    }
  }

  /* Push nav bar content down enough to clear the 40px announcement bar */
  :global(.main-nav-bar) {
    padding-top: calc(var(--row-gap) + 25px) !important;
  }
</style>
