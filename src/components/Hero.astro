---
// Components
import Button from "components/Button.astro"

interface Props {
  date?: string
  location?: string
  subtitle?: string
  description?: string
  video?: string
  poster?: string
  image?: string
  imageAlt?: string
  links?: Array<{
    text: string
    link: string
    openInNewTab: boolean
    class?: string
  }>
  note?: string
}

const { date, location, subtitle, description, video, poster, image, imageAlt, links, note } = Astro.props
---

<section
  class="section section-home-header full-height"
  data-theme-section="dark"
  data-bg-section="header-home"
>
  <div class="overlay overlay-background overlay-background-video">
    {video ? (
      <div class="styled-video playpause overlay">
        <video
          class="overlay hero-video"
          preload="auto"
          autoplay
          loop
          muted
          webkit-playsinline
          playsinline
          poster={poster}
        >
          <source src={video} type="video/mp4" />
        </video>
      </div>
    ) : (
      image && <img class="overlay hero-image" src={image} alt={imageAlt || ""} />
    )}
    <div class="overlay overlay-gradient-v2"></div>
  </div>

  <div class="container">
    <div class="row">
      <div class="col">
        <div class="logo-gosim-scroll">
        <div class="hero-wordmark">
          <span class="hero-gosim" role="img" aria-label="GOSIM"></span>
          <span class="hero-city-cn">深圳</span>
          <span class="hero-city-en">Shenzhen</span>
        </div>

          {(links && links.length > 0) || note ? (
            <div class="hero-cta">
              {links?.map((loop) => (
                <Button
                  text={loop.text}
                  link={loop.link}
                  openInNewTab={loop?.openInNewTab}
                  class={loop.class || "btn outline xl btn-hover"}
                />
              ))}
              {note && <span class="hero-note" aria-disabled="true">{note}</span>}
            </div>
          ) : null}
        </div>
      </div>
    </div>
  </div>

  <div class="hero-bottom-box">
    <div class="container">
      <div class="hero-content-row">
        <div class="hero-text-left">
          {subtitle && <p class="hero-subtitle">{subtitle}</p>}
          {description && <p class="hero-description">{description}</p>}
        </div>

        {(date || location) && (
          <div class="hero-date-block">
            {date && <p class="hero-date">{date}</p>}
            {location && <p class="hero-location">{location}</p>}
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .overlay-background-video {
    opacity: 0.9;
    z-index: 0;
  }

  .section-home-header .logo-gosim-scroll {
    z-index: 5;
  }

  .hero-wordmark {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
    text-align: center;
    width: 100%;
  }

  /* GOSIM — the official logo wordmark masked over the animated orange-glow
     gradient, so the gradient shimmers through the real brand mark. */
  .hero-gosim {
    display: block;
    width: clamp(15rem, 62vw, 34rem);
    aspect-ratio: 85 / 24;
    background: linear-gradient(95deg, #FFFFFF 0%, #FF7A3C 36%, #C23A0C 64%, #EAE6D2 100%);
    background-size: 220% auto;
    animation: hero-gosim-shimmer 6s ease-in-out infinite;
    -webkit-mask: url('/images/gosim-logo.svg') no-repeat center / contain;
    mask: url('/images/gosim-logo.svg') no-repeat center / contain;
  }

  @keyframes hero-gosim-shimmer {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  /* 深圳 — Ma Shan Zheng (楷体) brush calligraphy */
  .hero-city-cn {
    font-family: 'Ma Shan Zheng', cursive;
    font-weight: 400;
    font-size: clamp(2.8rem, 12vw, 11rem);
    line-height: 1.05;
    color: #fff;
    margin-top: 0.04em;
  }

  /* Shenzhen — romanisation under the Chinese name */
  .hero-city-en {
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: clamp(1rem, 3.1vw, 2.3rem);
    letter-spacing: 0.34em;
    /* compensate trailing letter-spacing so the word stays optically centred */
    padding-left: 0.34em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.92);
    margin-top: 0.55em;
  }

  .hero-bottom-box {
    position: absolute;
    bottom: 2rem;
    left: 0;
    right: 0;
    z-index: 2;
    pointer-events: none;
  }

  .hero-subtitle {
    font-size: clamp(1.55rem, 1.2rem + 0.7vw, 2rem);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.18;
    opacity: 0.98;
    color: rgba(255, 255, 255, 0.98);
    margin: 0 0 0.5rem;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.7);
  }

  .hero-description {
    max-width: 54rem;
    margin: 0;
    font-size: clamp(1.18rem, 0.98rem + 0.45vw, 1.45rem);
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0.01em;
    opacity: 0.96;
    color: rgba(255, 255, 255, 0.94);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.65);
  }

  .hero-content-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 0;
  }

  .hero-text-left {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hero-date-block {
    flex-shrink: 0;
    text-align: right;
  }

  .hero-date {
    font-size: clamp(1.55rem, 1.3rem + 0.9vw, 2.2rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #fff;
    margin: 0;
    line-height: 1.1;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.7);
  }

  .hero-location {
    font-size: clamp(0.88rem, 0.78rem + 0.35vw, 1.05rem);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    margin: 0.4rem 0 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.65);
  }

  .section-home-header .logo-gosim-scroll .hero-wordmark {
    will-change: transform;
    filter: drop-shadow(0 3px 18px rgba(0, 0, 0, 0.6));
  }

  .hero-cta {
    position: relative;
    z-index: 6;
    margin-top: 1.6rem;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  /* Informational, non-clickable "more coming" pill next to the CFP button.
     Liquid glass: lightly blurred + clearly translucent (the bg shows through
     with a tint), a bright specular rim, and an orange reflection on the LEFT
     edge picked up from the CFP pill sitting beside it. */
  /* "More info soon" — clean neutral liquid glass: translucent, a bright even
     rim and a soft sheen. (No coloured edge reflection — it looked artificial.) */
  .hero-note {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.78rem 1.4rem;
    border-radius: 999px;
    border: 0;
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.97);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
    cursor: default;
    pointer-events: none;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.55);
    -webkit-backdrop-filter: blur(8px) saturate(150%) brightness(1.06);
    backdrop-filter: blur(8px) saturate(150%) brightness(1.06);
    box-shadow:
      inset 0 2px 1.5px rgba(255, 255, 255, 0.6),
      inset 0 -4px 8px rgba(0, 0, 0, 0.16),
      0 8px 24px rgba(0, 0, 0, 0.24);
  }
  .hero-note::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1.4px;
    background: linear-gradient(135deg,
      rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0.18) 45%, rgba(255, 255, 255, 0.45));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    pointer-events: none;
    z-index: 5;
  }

  /* CFP: vivid AND see-through. A translucent but strongly-saturated orange,
     over a backdrop filter that re-saturates + brightens whatever shows through,
     so it reads as bright glass orange rather than muddy/greyed. */
  .hero-cta :global(.btn .btn-click) {
    -webkit-backdrop-filter: blur(6px) saturate(210%) brightness(1.12);
    backdrop-filter: blur(6px) saturate(210%) brightness(1.12);
  }
  /* Orange glass on the primary (ticket) button. */
  .hero-cta :global(.btn.primary .btn-fill) {
    background: linear-gradient(180deg, rgba(255, 122, 48, 0.72), rgba(240, 78, 22, 0.78)) !important;
  }
  /* Secondary CFP button (.light): translucent frosted white glass — the same
     see-through liquid-glass look as the bottom "Submit a Proposal" button,
     instead of a flat solid pill. Dark text stays readable on the frosted fill. */
  .hero-cta :global(.btn.light .btn-fill) {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.78), rgba(255, 255, 255, 0.72)) !important;
  }
  .hero-cta :global(.btn.light .btn-click) {
    -webkit-backdrop-filter: blur(10px) saturate(135%) brightness(1.18);
    backdrop-filter: blur(10px) saturate(135%) brightness(1.18);
  }

  .hero-image,
  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Warm tint removed (was reading too red). To restore or tune the warmth,
       uncomment and adjust the sepia/saturate values below:
    filter: saturate(0.42) sepia(0.34) contrast(1.05) brightness(0.97); */
  }

  @media (max-width: 768px) {
    .section-home-header .logo-gosim-scroll {
      width: 100vw;
      max-width: none;
    }

    /* Romanisation: tighter tracking so it reads as a tidy caption under 深圳 */
    .hero-city-en {
      font-size: clamp(0.85rem, 3.4vw, 1.1rem);
      letter-spacing: 0.24em;
      padding-left: 0.24em;
      margin-top: 0.45em;
    }

    /* Two CTAs as an equal 2-column grid (1fr 1fr) so the pills are exactly the
       same width — flex distribution skewed them because of the note's text. */
    .hero-cta {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
      width: 100%;
      max-width: 26rem;
      box-sizing: border-box;
      padding: 0 1rem;
      margin: 1.2rem auto 0;
    }

    /* :global — .btn is rendered by the Button component, so it lacks this
       component's scope attribute; a plain `.hero-cta .btn` selector wouldn't
       match it. Each pill fills its grid column. */
    .hero-cta :global(.btn),
    .hero-cta .hero-note {
      width: 100%;
      min-width: 0;
    }

    .hero-cta :global(.btn .btn-click) {
      width: 100%;
      justify-content: center;
    }

    /* Stretch the inner fill to the full pill width too, otherwise the orange
       fill stays at its text width while the outline border-box fills the pill,
       showing as a ring around the button. */
    .hero-cta :global(.btn .btn-content) {
      width: 100%;
    }

    /* Match the note's text size to the CFP button so the two pills look equal */
    .hero-cta .hero-note {
      justify-content: center;
      padding: 0.82rem 0.5rem;
      font-size: 0.85rem;
      letter-spacing: 0;
      white-space: nowrap;
    }

    .hero-bottom-box {
      bottom: 1.5rem;
    }

    /* Smaller bottom block so it doesn't eat a third of the screen */
    .hero-subtitle {
      font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.25rem);
      line-height: 1.25;
    }

    .hero-description {
      max-width: 100%;
      font-size: 0.96rem;
      line-height: 1.45;
    }

    .hero-date {
      font-size: 1.45rem;
    }

    .hero-location {
      font-size: 0.8rem;
    }

    .hero-content-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.95rem;
    }

    .hero-date-block {
      text-align: left;
    }
  }

  @media (max-height: 760px) {
    .section-home-header .logo-gosim-scroll {
      top: 40%;
      gap: 0.75rem;
    }

    .hero-cta {
      margin-top: 1rem;
    }

    .hero-gosim {
      width: clamp(13rem, 52vw, 28rem);
    }

    .hero-city-cn {
      font-size: clamp(2.4rem, 13vh, 7.5rem);
    }

    .hero-city-en {
      margin-top: 0.4em;
    }

    .hero-bottom-box {
      bottom: 1.25rem;
    }
  }

  @media (max-height: 640px) {
    .section-home-header .logo-gosim-scroll {
      top: 37%;
    }
  }

  @media (max-width: 768px) and (max-height: 680px) {
    .hero-description {
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }

    .hero-content-row {
      gap: 0.65rem;
    }
  }
</style>
