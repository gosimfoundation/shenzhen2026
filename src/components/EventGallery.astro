---
interface Props {
  title: string;
  images: { src: string; alt: string }[];
}

const { title, images } = Astro.props;
---

<section class="section section-event-gallery" data-theme-section="light" data-bg-section="lightgray">
  <div class="container wide">
    <div class="exp-header">
      <h2>{title}</h2>
    </div>

    <div class="exp-grid">
      {images.map((img) => (
        <figure class="exp-item">
          <img src={img.src} alt={img.alt} loading="lazy" decoding="async" />
        </figure>
      ))}
    </div>
  </div>

  <div class="gallery-lightbox" data-gallery-lightbox>
    <button class="gallery-lightbox-close" aria-label="Close">&#215;</button>
    <button class="gallery-lightbox-nav gallery-lightbox-prev" aria-label="Previous photo">&#8249;</button>
    <img class="gallery-lightbox-img" src="" alt="" />
    <button class="gallery-lightbox-nav gallery-lightbox-next" aria-label="Next photo">&#8250;</button>
  </div>
</section>

<style>
  .section-event-gallery {
    padding-top: calc(var(--section-padding) * 0.6);
    padding-bottom: calc(var(--section-padding) * 0.6);
  }

  .exp-header {
    text-align: center;
    margin-bottom: 1.6rem;
  }
  .exp-header h2 {
    margin: 0;
  }

  /* Mosaic / bento grid — clicking a tile opens the lightbox */
  .exp-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 12rem;
    grid-auto-flow: dense;
    gap: 0.7rem;
  }
  .exp-item {
    margin: 0;
    overflow: hidden;
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.18);
  }
  .exp-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    cursor: zoom-in;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .exp-item:hover img {
    transform: scale(1.06);
  }

  /* feature tiles repeat every 8 so the mosaic keeps its rhythm at any count */
  .exp-item:nth-child(8n + 1) {
    grid-column: span 2;
    grid-row: span 2;
  }
  .exp-item:nth-child(8n + 5) {
    grid-column: span 2;
  }

  @media (max-width: 900px) {
    .exp-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 9rem;
    }
  }
  @media (max-width: 520px) {
    .exp-grid {
      grid-auto-rows: 7rem;
    }
  }

  /* Lightbox — click a photo to enlarge; fades + zooms in, arrows to browse */
  .gallery-lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4vh 6vw;
    background: rgba(8, 7, 5, 0.9);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    cursor: zoom-out;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .gallery-lightbox.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .gallery-lightbox-img {
    max-width: 90vw;
    max-height: 88vh;
    border-radius: 14px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
    cursor: default;
    transform: scale(0.92);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.22s ease;
  }
  .gallery-lightbox.is-open .gallery-lightbox-img {
    transform: scale(1);
  }
  .gallery-lightbox-close,
  .gallery-lightbox-nav {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
  }
  .gallery-lightbox-close:hover,
  .gallery-lightbox-nav:hover {
    background: rgba(255, 255, 255, 0.25);
  }
  .gallery-lightbox-close {
    top: 1.4rem;
    right: 1.6rem;
    width: 3rem;
    height: 3rem;
    font-size: 1.6rem;
  }
  .gallery-lightbox-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 3.4rem;
    height: 3.4rem;
    font-size: 2.2rem;
    padding-bottom: 0.2rem;
  }
  .gallery-lightbox-prev {
    left: 1.6rem;
  }
  .gallery-lightbox-next {
    right: 1.6rem;
  }
  @media (max-width: 600px) {
    .gallery-lightbox-nav {
      width: 2.6rem;
      height: 2.6rem;
      font-size: 1.7rem;
    }
    .gallery-lightbox-prev {
      left: 0.6rem;
    }
    .gallery-lightbox-next {
      right: 0.6rem;
    }
  }
</style>

<script>
  document.querySelectorAll('.section-event-gallery').forEach((section) => {
    const lightbox = section.querySelector('[data-gallery-lightbox]') as HTMLElement | null;
    if (!lightbox) return;
    const lbImg = lightbox.querySelector('.gallery-lightbox-img') as HTMLImageElement;
    const closeBtn = lightbox.querySelector('.gallery-lightbox-close');
    const prevBtn = lightbox.querySelector('.gallery-lightbox-prev');
    const nextBtn = lightbox.querySelector('.gallery-lightbox-next');

    // Build the ordered photo list once.
    const thumbs = Array.from(
      section.querySelectorAll('.exp-item img'),
    ) as HTMLImageElement[];
    const items = thumbs.map((img) => ({ src: img.src, alt: img.alt }));
    if (!items.length) return;
    let index = 0;

    // Move to <body> so no transformed/overflow ancestor can clip the overlay.
    document.querySelectorAll('body > [data-gallery-lightbox]').forEach((el) => el.remove());
    document.body.appendChild(lightbox);

    const isOpen = () => lightbox.classList.contains('is-open');

    const openAt = (i: number) => {
      index = (i + items.length) % items.length;
      lbImg.src = items[index].src;
      lbImg.alt = items[index].alt || '';
      lbImg.style.opacity = '1';
      lightbox.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      lightbox.classList.remove('is-open');
      document.body.style.overflow = '';
    };
    // crossfade to the next/previous photo
    const go = (delta: number) => {
      index = (index + delta + items.length) % items.length;
      const next = items[index];
      lbImg.style.opacity = '0';
      const pre = new Image();
      pre.onload = () => {
        lbImg.src = pre.src;
        lbImg.alt = next.alt || '';
        lbImg.style.opacity = '1';
      };
      pre.src = next.src;
    };

    thumbs.forEach((img, i) => img.addEventListener('click', () => openAt(i)));
    closeBtn?.addEventListener('click', (e) => { e.stopPropagation(); close(); });
    prevBtn?.addEventListener('click', (e) => { e.stopPropagation(); go(-1); });
    nextBtn?.addEventListener('click', (e) => { e.stopPropagation(); go(1); });
    lbImg.addEventListener('click', (e) => e.stopPropagation());
    lightbox.addEventListener('click', close); // click the backdrop to close

    document.addEventListener('keydown', (e) => {
      if (!isOpen()) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') go(-1);
      else if (e.key === 'ArrowRight') go(1);
    });
  });
</script>
