---
interface Props {
  title: string;
  images: { src: string; alt: string }[];
}

const { title, images } = Astro.props;
---

<section class="section section-event-gallery" data-theme-section="light" data-bg-section="lightgray" data-scroll-section>
  <div class="container wide">
    <div class="gallery-header">
      <h2>{title}</h2>
    </div>
  </div>
  <div class="gallery-marquee-container">
    <div class="gallery-track">
      {images.map((img) => (
        <figure class="gallery-item">
          <img src={img.src} alt={img.alt} loading="lazy" decoding="async" />
        </figure>
      ))}
      {images.map((img) => (
        <figure class="gallery-item" aria-hidden="true">
          <img src={img.src} alt="" loading="lazy" decoding="async" />
        </figure>
      ))}
    </div>
    <button class="gallery-nav-btn gallery-prev" aria-label="Previous photos">&#8592;</button>
    <button class="gallery-nav-btn gallery-next" aria-label="Next photos">&#8594;</button>
  </div>
</section>

<style>
  .section-event-gallery {
    padding-top: calc(var(--section-padding) * 0.5);
    padding-bottom: calc(var(--section-padding) * 0.5);
  }

  .gallery-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .gallery-marquee-container {
    overflow: hidden;
    width: 100%;
    position: relative;
  }

  .gallery-track {
    display: flex;
    width: fit-content;
    will-change: transform;
  }

  .gallery-item {
    flex: 0 0 auto;
    margin: 0 1rem 0 0;
  }

  .gallery-item img {
    height: 320px;
    width: auto;
    display: block;
    border-radius: 12px;
  }

  .gallery-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.2);
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(4px);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    font-size: 1.2rem;
    color: var(--color-dark, #1a1a1a);
  }

  .gallery-nav-btn:hover {
    background: var(--color-dark, #1a1a1a);
    color: #fff;
    border-color: var(--color-dark, #1a1a1a);
  }

  .gallery-prev {
    left: 1rem;
  }

  .gallery-next {
    right: 1rem;
  }

  @media (max-width: 768px) {
    .gallery-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .gallery-item img {
      height: 220px;
    }

    .gallery-nav-btn {
      width: 2.5rem;
      height: 2.5rem;
      font-size: 1rem;
    }

    .gallery-prev {
      left: 0.5rem;
    }

    .gallery-next {
      right: 0.5rem;
    }
  }
</style>

<script>
  document.querySelectorAll('.gallery-marquee-container').forEach((container) => {
    const track = container.querySelector('.gallery-track') as HTMLElement;
    const prevBtn = container.querySelector('.gallery-prev');
    const nextBtn = container.querySelector('.gallery-next');
    if (!track || !prevBtn || !nextBtn) return;

    const speed = window.innerWidth <= 720 ? 1.2 : 0.8; // px per frame
    let position = 0;
    let paused = false;
    let nudgeVelocity = 0;

    function tick() {
      // Seam re-measured each frame (images load lazily, so the track grows).
      // Measured from the duplicate set's first item — scrollWidth/2 is off by
      // the last item's trailing margin, which scrollWidth doesn't count.
      const items = track.children;
      const mid = items[items.length / 2] as HTMLElement;
      const halfWidth = mid.offsetLeft - (items[0] as HTMLElement).offsetLeft;

      if (!paused) {
        position -= speed;
      }

      // Apply nudge velocity (smooth deceleration)
      if (Math.abs(nudgeVelocity) > 0.1) {
        position += nudgeVelocity;
        nudgeVelocity *= 0.92; // friction
      } else {
        nudgeVelocity = 0;
      }

      // Seamless loop: wrap around when past halfway
      if (position <= -halfWidth) {
        position += halfWidth;
      } else if (position > 0) {
        position -= halfWidth;
      }

      track.style.transform = `translateX(${position}px)`;
      requestAnimationFrame(tick);
    }

    requestAnimationFrame(tick);

    // Pause on hover
    container.addEventListener('mouseenter', () => { paused = true; });
    container.addEventListener('mouseleave', () => { paused = false; });

    // Arrow clicks apply a smooth nudge impulse
    prevBtn.addEventListener('click', () => { nudgeVelocity += 40; });
    nextBtn.addEventListener('click', () => { nudgeVelocity -= 40; });
  });
</script>
