---
// Past Sponsors showcase. Renders the curated partner list from Sponsors.json
// (logos live in public/images/sponsors/), deduped by logo, each linked to its
// site. Ends with a contact line + email link.
import sponsorsData from "json/PastSponsors.json";

interface Props {
  title?: string;
  intro?: string;
  contactText?: string;
  email?: string;
  /** partner categories to skip (e.g. ["host"]) */
  excludeCategories?: string[];
  /** individual logos to skip when they are featured elsewhere on the page */
  excludeImages?: string[];
}

const {
  title = "Past Sponsors",
  intro = "The organizations who've powered GOSIM events around the world.",
  contactText = "Interested in sponsoring GOSIM Shenzhen 2026? We'd love to hear from you.",
  email = "support@gosim.org",
  excludeCategories = ["host"],
  excludeImages = [],
} = Astro.props;

// Rough prominence ranking — better-known sponsors sort to the front, everyone
// else keeps their original order. Same tile size for all; no labels shown.
const PRIORITY = [
  "huawei.png", "amazon.png", "google.png", "nvidia.png", "intel.png",
  "arm.png", "redhat.png", "huggingface.png", "bytedance.png",
  "csdn.png", "minimax.png", "kimi.png", "z-ai.png", "baai.png",
  "sgl.png", "second-state.png", "futurewei.png",
];
const rankOf = (img: string): number => {
  const i = PRIORITY.indexOf(img);
  return i === -1 ? PRIORITY.length : i;
};

const isRemote = (s?: string): boolean => Boolean(s && /^https?:\/\//.test(s));

// Flatten partners, drop excluded categories, dedupe by logo, sort by prominence.
const seen = new Set<string>();
const logos = (sponsorsData.partners ?? [])
  .filter(
    (p: any) =>
      p.image &&
      !excludeCategories.includes(p.category) &&
      !excludeImages.includes(p.image),
  )
  .filter((p: any) => {
    if (seen.has(p.image)) return false;
    seen.add(p.image);
    return true;
  })
  .map((p: any, i: number) => ({
    image: p.image as string,
    // This page renders logos at a small, fixed size. Use the dedicated
    // thumbnails so scrolling never has to decode multi-thousand-pixel PNGs.
    src: isRemote(p.image) ? p.image : `/images/sponsors/optimized/${p.image}`,
    url: p.url || "",
    order: i,
  }))
  .sort((a, b) => rankOf(a.image) - rankOf(b.image) || a.order - b.order);
---

<section class="psp" data-theme-section="dark" data-bg-section="lightgray">
  <div class="psp-inner">
    {(title || intro) && (
      <div class="psp-head">
        {title && <h2 class="psp-title">{title}</h2>}
        {intro && <p class="psp-intro">{intro}</p>}
      </div>
    )}

    {logos.length > 0 && (
      <div class="psp-grid">
        {logos.map((logo) =>
          logo.url ? (
            <a class="psp-tile" href={logo.url} target="_blank" rel="noopener noreferrer">
              <img
                src={logo.src}
                alt="Sponsor logo"
                width="360"
                height="180"
                loading="lazy"
                decoding="async"
              />
            </a>
          ) : (
            <div class="psp-tile">
              <img
                src={logo.src}
                alt="Sponsor logo"
                width="360"
                height="180"
                loading="lazy"
                decoding="async"
              />
            </div>
          )
        )}
      </div>
    )}

    <div class="psp-contact">
      <p class="psp-contact-text">{contactText}</p>
      <a class="psp-contact-link" href={`mailto:${email}`}>{email}</a>
    </div>
  </div>
</section>

<style>
  .psp {
    --orange: #f84a10;
    --glow: #ff7a3c;
    --cream: #eae6d2;
    position: relative;
    padding: clamp(3.5rem, 7vw, 6.5rem) 0;
    background: linear-gradient(180deg, #161410 0%, #100e09 100%);
  }
  .psp-inner {
    width: min(100% - 3rem, 72rem);
    margin-inline: auto;
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .psp-head {
    display: grid;
    gap: 0.9rem;
    max-width: 46rem;
  }
  .psp-title {
    margin: 0;
    font-size: clamp(2rem, 1.2rem + 3vw, 3.4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--cream);
  }
  .psp-intro {
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.65;
    color: rgba(234, 230, 210, 0.66);
  }

  .psp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(10.5rem, 100%), 1fr));
    gap: 1rem;
  }
  .psp-tile {
    display: grid;
    place-items: center;
    min-height: 6.5rem;
    padding: 1.3rem 1.5rem;
    border-radius: 1rem;
    border: 1px solid rgba(234, 230, 210, 0.1);
    background: #ffffff;
    text-decoration: none;
    contain: layout paint style;
    content-visibility: auto;
    contain-intrinsic-size: auto 6.5rem;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
  }
  .psp-tile:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.35);
  }
  .psp-tile img {
    display: block;
    width: 100%;
    height: 3.4rem;
    object-fit: contain;
  }

  .psp-contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    border-top: 1px solid rgba(234, 230, 210, 0.12);
  }
  .psp-contact-text {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.6;
    color: rgba(234, 230, 210, 0.78);
  }
  .psp-contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.3rem;
    border-radius: 999px;
    background: linear-gradient(95deg, var(--orange), var(--glow));
    color: #fff;
    font-weight: 700;
    font-size: 0.98rem;
    letter-spacing: 0.01em;
    text-decoration: none;
    box-shadow: 0 8px 22px rgba(248, 74, 16, 0.28);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .psp-contact-link::before {
    content: "✉";
    font-size: 0.95em;
  }
  .psp-contact-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(248, 74, 16, 0.38);
  }

  @media (max-width: 520px) {
    .psp-grid {
      grid-template-columns: repeat(auto-fill, minmax(min(8rem, 100%), 1fr));
    }
  }
</style>
