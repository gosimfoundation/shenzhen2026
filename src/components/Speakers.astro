---
// Import the speakers data
import speakersData from "json/SpeakersCleaned.json";
import {
  getSpeakerImagePath,
  SPEAKER_IMAGE_FALLBACK_HANDLER,
} from "utils/speaker-images";
import { compareSpeakersBySurname } from "utils/speaker-sorting";

const getSpeakerNameFontSize = (name: string) => {
  const length = [...name].length;
  if (length >= 22) return "0.8rem";
  if (length >= 18) return "0.92rem";
  return "1.05rem";
};

// Compact labels are only used on speaker cards. Detail pages retain the
// speakers' full submitted titles and organization names.
const speakerCardText: Record<string, { role?: string; company?: string }> = {
  "anni-lai": { role: "GenAI Commons Co-Chair" },
  "bardia-moshiri": { role: "Embedded Software Eng." },
  "bo-tang": { role: "Applied Algorithms Lead", company: "MemTensor" },
  "che-jiang": { role: "Ph.D. Candidate & AI Researcher", company: "Tsinghua / Frontis.AI" },
  "codingma": { role: "Training Software Expert" },
  "chenghao-rong": { role: "Senior Software Eng." },
  "hsuan-han-lai": { role: "Developer Ecosystem Lead", company: "Tuya Smart" },
  "katarzyna-starosławska": { company: "LUMI AI / CYFRONET / EC" },
  "kelly-policarpo": { company: "Lumo AI Advisory" },
  "liuwang-kang": { company: "Shenzhen AIRS" },
  "hongjun-zhou": { company: "Shenzhen AIRS" },
  "martino-russi": { role: "Embodied Robotics Eng." },
  "markus-tavenrath": { role: "Principal DevTech Eng." },
  "ning-liu": { company: "Beijing Humanoid Center" },
  "peilin-li": { company: "Tsinghua / Approaching AI" },
  "qinying-liao": { role: "Principal Program Mgr." },
  "quanshi-zhang": { company: "Shanghai Jiao Tong Univ." },
  "shiwei-liu": { company: "Max Planck IS / ELLIS" },
  "sean-dong": { role: "Product Management Director", company: "Huawei Cangjie" },
  "tianyi-han": { role: "Solution Architect" },
  "tong-ling": { role: "IoT Commercialization Lead", company: "Espressif" },
  "xuewen-gao": { role: "Deputy Chief Engineer", company: "QI-ANXIN" },
  "yuu": { role: "Agent Performance Intern", company: "Dify" },
  "zhichao-jiao": { role: "Developer Experience PM" },
  "zhihong-mo": { role: "Ecosystem & University Lead", company: "JLC Technology Group" },
  "joaquin-salvachua": { company: "Polytechnic Univ. Madrid" },
};

// Filter speakers to only include those where draft is false and id is not "tbd"
const filteredSpeakers = speakersData.speakers
  .filter((speaker) => speaker.draft !== true && speaker.id !== "tbd")
  .sort((a, b) => compareSpeakersBySurname(a, b));

const eventCategoryIds = new Set([
  "open-for-sdg",
  "forum-aivision",
  "rustchinaconf",
]);

const categoryGroup = (category) => {
  const explicitGroup = String(category.group || "").toLowerCase();
  if (["workshop", "workshops"].includes(explicitGroup)) return "workshops";
  if (["event", "events", "co-located", "colocated"].includes(explicitGroup)) return "events";
  if (category.id.startsWith("ws-")) return "workshops";
  if (
    eventCategoryIds.has(category.id) ||
    category.id.startsWith("event-") ||
    category.id.startsWith("forum-")
  ) return "events";
  return "tracks";
};

const programCategories = speakersData.categories.filter((category) => category.id !== "all");

// Explicit `group` values are preferred; ID prefixes keep older data compatible.
const groupedCategories = {
  tracks: programCategories.filter((category) => categoryGroup(category) === "tracks"),
  workshops: programCategories.filter((category) => categoryGroup(category) === "workshops"),
  events: programCategories.filter((category) => categoryGroup(category) === "events"),
};

// For images in public directory, we can reference them directly
---

<div
  class="filter-container filter-alpha-animate"
  role="region"
  aria-label="Speaker filters"
>
  <div class="overlay overlay-dark" data-filter-toggle="close">
    <div
      class="close"
      data-filter-toggle="close"
      role="button"
      aria-label="Close filters"
      tabindex="0"
    >
      <div class="close-fill"></div>
      <div class="bar bar-top"></div>
      <div class="bar bar-bottom"></div>
    </div>
  </div>
  <div class="filter-box">
    <p>Filter:</p>
    <div
      class="filter-group"
      data-filter-group
      role="group"
      aria-label="Speaker category filters"
    >
      <!-- All Speakers Button -->
      <div class="all-speakers-section">
        <button
          type="button"
          class="single-filter all-button filter-all"
          data-speaker-filter-control
          data-filter-status="active"
          data-filter-category="all"
          aria-pressed="true"
          aria-label="Show all speakers"
        >
          <span>All Speakers</span>
        </button>
      </div>

      <!-- Plenary & Tracks Group -->
      <div class="filter-group-section">
        <div class="filter-group-header">
          <h4 class="filter-group-title">TRACKS</h4>
        </div>
        <div class="filter-group-tags">
          {
            groupedCategories.tracks.map((category) => (
              <button
                type="button"
                class="single-filter"
                data-speaker-filter-control
                data-filter-status="not-active"
                data-filter-category={category.id}
                aria-pressed="false"
                aria-label={`Filter by ${category.name}`}
              >
                <span>{category.name}</span>
              </button>
            ))
          }
        </div>
      </div>

      {
        groupedCategories.workshops.length > 0 && (
          <div class="filter-group-section filter-group-section-full">
            <div class="filter-group-header">
              <h4 class="filter-group-title">WORKSHOPS</h4>
            </div>
            <div class="filter-group-tags">
              {
            groupedCategories.workshops.map((category) => (
              <button
                type="button"
                class="single-filter"
                data-speaker-filter-control
                data-filter-status="not-active"
                data-filter-category={category.id}
                aria-pressed="false"
                aria-label={`Filter by ${category.name}`}
              >
                <span>{category.name}</span>
              </button>
            ))
              }
            </div>
          </div>
        )
      }

      {
        groupedCategories.events.length > 0 && (
          <div class="filter-group-section filter-group-section-full">
            <div class="filter-group-header">
              <h4 class="filter-group-title">EVENTS</h4>
            </div>
            <div class="filter-group-tags">
              {
                groupedCategories.events.map((category) => (
                  <button
                    type="button"
                    class="single-filter"
                    data-speaker-filter-control
                    data-filter-status="not-active"
                    data-filter-category={category.id}
                    aria-pressed="false"
                    aria-label={`Filter by ${category.name}`}
                  >
                    <span>{category.name}</span>
                  </button>
                ))
              }
            </div>
          </div>
        )
      }

    </div>
  </div>
</div>

<section
  class="section section-speakers-grid"
  id="grid"
  data-filter-section
  data-speaker-filter-state
  data-summary-all="{visible} speakers · All"
  data-summary-selected="{visible} speakers · {selected} selected"
  data-theme-section="light"
  data-bg-section="lightgray"
  data-scroll-section
>
  <div class="container">
    <div class="speaker-browser">
      <aside class="speaker-filter-sidebar" aria-label="Filter speakers">
        <div class="filter-panel">
          <div class="filter-heading">
            <p class="filter-kicker">Filter speakers</p>
            <output class="filter-summary" data-speaker-filter-summary aria-live="polite">
              {filteredSpeakers.length} speakers · All
            </output>
          </div>
          <div class="filter-group" data-filter-group aria-label="Speaker filters">
            <div class="filter-layout">
              <button
                type="button"
                class="single-filter filter-all"
                data-speaker-filter-control
                data-filter-status="active"
                data-filter-category="all"
                aria-pressed="true"
              >
                <span>All Speakers</span>
              </button>
              <div class="filter-section filter-section-tracks">
                <span class="filter-group-label">Tracks</span>
                <div class="filter-options">
                  {
                    groupedCategories.tracks.map((category) => (
                      <button
                        type="button"
                        class="single-filter"
                        data-speaker-filter-control
                        data-filter-status="not-active"
                        data-filter-category={category.id}
                        aria-pressed="false"
                      >
                        <span>{category.name}</span>
                      </button>
                    ))
                  }
                </div>
              </div>
              {
                groupedCategories.workshops.length > 0 && (
                  <div class="filter-section">
                    <span class="filter-group-label">Workshops</span>
                    <div class="filter-options">
                      {
                        groupedCategories.workshops.map((category) => (
                          <button
                            type="button"
                            class="single-filter"
                            data-speaker-filter-control
                            data-filter-status="not-active"
                            data-filter-category={category.id}
                            aria-pressed="false"
                          >
                            <span>{category.name}</span>
                          </button>
                        ))
                      }
                    </div>
                  </div>
                )
              }
              {
                groupedCategories.events.length > 0 && (
                  <div class="filter-section">
                    <span class="filter-group-label">Events</span>
                    <div class="filter-options">
                      {
                        groupedCategories.events.map((category) => (
                          <button
                            type="button"
                            class="single-filter"
                            data-speaker-filter-control
                            data-filter-status="not-active"
                            data-filter-category={category.id}
                            aria-pressed="false"
                          >
                            <span>{category.name}</span>
                          </button>
                        ))
                      }
                    </div>
                  </div>
                )
              }
            </div>
          </div>
        </div>
      </aside>

      <div class="speaker-results">

    <div class="row grid visible speakers-grid" data-filter-grid data-modal-grid>
      {
        filteredSpeakers.map((speaker, index) => (
          <div
            class="col"
            data-speaker-filter-card
            data-filter-status="active"
            data-filter-index={index}
            data-filter-index-even={index % 2 === 0}
            data-filter-category={speaker.tags ? speaker.tags.join(" ") : ""}
          >
            <a
              href={`/speakers/${speaker.id}/`}
              class="single-speakers-card"
              data-modal-card-status="not-active"
              data-modal-card-id={speaker.id}
            >
              <div class="card-row card-row-image">
                <div class="card-image">
                  <img
                    src={getSpeakerImagePath(speaker.id)}
                    onerror={SPEAKER_IMAGE_FALLBACK_HANDLER}
                    alt={speaker.name}
                    class="overlay speaker-img"
                    loading="lazy"
                    style="object-position: center 15% !important;"
                  />
                </div>
              </div>
              <div class="card-row card-row-info">
                <h2 class="h5" title={speaker.name} style={`font-size: ${getSpeakerNameFontSize(speaker.name)}`}>{speaker.name}</h2>
                {(() => {
                  let lastComma = -1, depth = 0;
                  for (let i = 0; i < speaker.roleOrg.length; i++) {
                    if (speaker.roleOrg[i] === '(') depth++;
                    else if (speaker.roleOrg[i] === ')') depth--;
                    else if (speaker.roleOrg[i] === ',' && depth === 0) lastComma = i;
                  }
                  if (lastComma === -1) return <p class="speaker-role" title={speaker.roleOrg}>{speakerCardText[speaker.id]?.role || speaker.roleOrg}</p>;
                  const fullRole = speaker.roleOrg.slice(0, lastComma).trim();
                  const fullCompany = speaker.roleOrg.slice(lastComma + 1).trim();
                  const role = speakerCardText[speaker.id]?.role || fullRole;
                  const company = speakerCardText[speaker.id]?.company || fullCompany;
                  return <><p class="speaker-role" title={fullRole}>{role}</p><p class="speaker-company" title={fullCompany}><strong>{company}</strong></p></>;
                })()}
              </div>
            </a>
          </div>
        ))
      }
    </div>
        <p class="filter-empty" data-speaker-filter-empty hidden>
          No speakers match the current selection. Try choosing fewer tracks.
        </p>
        <p style="text-align: center; width: 100%; margin: 2rem 0 0; color: #888; font-size: 0.9rem;">
          This list is being updated. Speakers are subject to change.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .card-image {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1/1;
    width: 100%;
  }

  .speaker-img {
    object-fit: cover !important;
    height: 100%;
    width: 100%;
  }

  .speaker-placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: white;
    background:
      radial-gradient(circle at 30% 25%, rgba(255, 255, 255, 0.28), transparent 35%),
      linear-gradient(145deg, hsl(var(--speaker-hue) 72% 66%), hsl(calc(var(--speaker-hue) + 45) 68% 45%));
    font-size: clamp(1.5rem, 3vw, 3.25rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    user-select: none;
    transition: transform 0.5s ease;
  }

  .single-speakers-card:hover .speaker-placeholder {
    transform: scale(1.08);
  }

  /* Filter layout */
  .speaker-browser {
    display: grid;
    grid-template-columns: minmax(14rem, 15.5rem) minmax(0, 1fr);
    align-items: start;
    gap: clamp(1.5rem, 2.5vw, 2.5rem);
    padding-top: var(--row-gap);
  }

  .speaker-filter-sidebar {
    position: sticky;
    top: 1.5rem;
    z-index: 2;
    max-height: calc(100vh - 3rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-right: 0.25rem;
    scrollbar-width: thin;
  }

  .speaker-results {
    min-width: 0;
  }

  .speaker-results :global(.speakers-grid) {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(2.25rem, 3vw, 3.25rem) clamp(1.5rem, 2vw, 2.5rem);
  }

  .speaker-results :global(.speakers-grid) > :global(.col) {
    width: auto !important;
    min-width: 0;
  }

  .speaker-results .single-speakers-card {
    gap: 0.8rem;
  }

  .speaker-results .card-row-image {
    width: min(100%, 11.25rem);
    margin-inline: auto;
  }

  .speaker-results .card-row-info {
    display: grid;
    grid-template-rows: 1.3em 1.3em 2.6em;
    gap: 0.15rem;
  }

  .speaker-results .card-row-info .h5 {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 1.3em;
    margin: 0;
    overflow: hidden;
    line-height: 1.2;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .speaker-results .speaker-role,
  .speaker-results .speaker-company {
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .speaker-results .speaker-role {
    color: rgba(246, 243, 231, 0.62);
    font-size: 0.86rem;
    line-height: 1.3;
    white-space: nowrap;
  }

  .speaker-results .speaker-company {
    display: -webkit-box;
    color: rgba(246, 243, 231, 0.86);
    font-size: 0.88rem !important;
    line-height: 1.3;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .filter-panel {
    width: 100%;
    padding: 1rem;
    border: 1px solid rgba(246, 243, 231, 0.18);
    border-radius: 1.25rem;
    background:
      radial-gradient(circle at 90% 0%, rgba(248, 74, 16, 0.12), transparent 34%),
      rgba(246, 243, 231, 0.035);
  }

  .filter-heading {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.35rem;
    padding-bottom: 0.7rem;
    margin-bottom: 0.7rem;
    border-bottom: 1px solid rgba(246, 243, 231, 0.14);
  }

  .filter-kicker {
    margin: 0;
    color: #f6f3e7;
    font-size: 0.96rem;
    font-weight: 650;
  }

  .filter-summary {
    display: block;
    min-height: 1.3em;
    overflow: hidden;
    color: rgba(246, 243, 231, 0.62);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .filter-layout {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    width: 100%;
  }

  .filter-options {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .filter-all {
    width: 100%;
  }

  .filter-panel .single-filter.filter-all {
    justify-content: flex-start;
    min-height: 0;
    margin-bottom: 0;
    border: 0 !important;
    background: transparent !important;
    font-weight: 600;
    text-align: left;
  }

  .filter-panel .single-filter.filter-all span {
    width: auto;
    color: inherit;
    text-align: left;
  }

  .filter-section {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: 0.3rem;
    padding-top: 0.6rem;
    border-top: 1px solid rgba(246, 243, 231, 0.12);
  }

  .filter-panel .single-filter {
    appearance: none;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    min-height: 0;
    gap: 0.65rem;
    padding: 0.65rem;
    border: 0 !important;
    border-radius: 8px;
    color: #f6f3e7;
    background: transparent !important;
    font: inherit;
    font-size: 0.8rem;
    line-height: 1.2;
    text-align: left;
    transition: border-color 160ms ease, background 160ms ease, transform 160ms ease;
  }

  .filter-panel .single-filter::before {
    content: "";
    display: block;
    width: 8px;
    height: 8px;
    flex: 0 0 8px;
    border: 0;
    border-radius: 50%;
    background: rgba(234, 230, 210, 0.2);
    transition: background 150ms ease, transform 150ms ease;
  }

  .filter-panel .single-filter:hover {
    border: 0 !important;
    background: rgba(255, 255, 255, 0.07) !important;
    transform: none;
  }

  .filter-panel .single-filter:focus-visible {
    outline: 2px solid rgba(255, 159, 117, 0.7);
    outline-offset: 2px;
  }

  .filter-panel .single-filter[data-filter-status="active"] {
    background: rgba(255, 255, 255, 0.07) !important;
    border: 0 !important;
    box-shadow: inset 0 0 0 1px rgba(248, 74, 16, 0.68);
  }

  .filter-panel .single-filter[data-filter-status="active"]:focus-visible {
    outline: none;
  }

  .filter-panel .single-filter[data-filter-status="active"] span {
    color: #fff !important;
    font-weight: 650;
  }

  .filter-panel .single-filter[data-filter-status="active"]::before {
    content: "";
    background: var(--color-primary);
    transform: scale(1.2);
  }

  .filter-group-label {
    display: block;
    font-size: 0.68rem;
    font-weight: 600;
    color: rgba(246, 243, 231, 0.72);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    white-space: nowrap;
  }

  .filter-container .single-filter {
    appearance: none;
    font: inherit;
  }

  .filter-container .all-button {
    justify-content: center;
    border: 2px solid var(--color-primary) !important;
    background: rgba(248, 74, 16, 0.09) !important;
    font-weight: 700;
    text-align: center;
  }

  .filter-container .single-filter[data-filter-status="active"] {
    border-color: var(--color-primary) !important;
    background: var(--color-primary) !important;
  }

  .filter-container .single-filter[data-filter-status="active"] span {
    color: #fff !important;
  }

  .filter-empty {
    width: 100%;
    margin: 2rem 0 0;
    padding: 1rem;
    border: 1px dashed rgba(246, 243, 231, 0.25);
    border-radius: 1rem;
    color: rgba(246, 243, 231, 0.7);
    text-align: center;
  }

  @media screen and (max-width: 1070px) {
    .speaker-browser {
      grid-template-columns: minmax(0, 1fr);
    }

    .speaker-filter-sidebar {
      display: none;
    }
  }

  .section-speakers-grid :global(.grid) {
    padding-top: 0;
  }

  @media screen and (max-width: 1280px) {
    .speaker-results :global(.speakers-grid) { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  @media screen and (max-width: 720px) {
    .speaker-results :global(.speakers-grid) { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media screen and (max-width: 480px) {
    .speaker-results :global(.speakers-grid) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* Fix scrolling issues */
  html,
  body {
    overflow-x: hidden !important;
    overflow-y: auto !important;
    height: auto !important;
    min-height: 100vh !important;
  }

  .main {
    overflow: visible !important;
    min-height: 100vh !important;
  }
</style>

<script>
  import { setupSpeakerFilters } from "../scripts/speaker-filters";

  setupSpeakerFilters();
  document.addEventListener("astro:page-load", setupSpeakerFilters);
</script>
