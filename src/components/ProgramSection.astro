---
// Homepage program section: editorial headline + scrolling marquee word cloud
// + a full-content track showcase, with an optional Spotlight highlight below.
import schedulePreview from "json/SchedulePreview.json";
import { programCategoryColor } from "utils/program-colors";

interface Facet {
  title: string;
  keywords?: string[];
}
interface Track {
  title: string;
  text: string;
  link?: string;
}
interface Highlight {
  title: string;
  titleLines?: string[];
  text: string;
  link?: string;
  badge?: string;
  status?: string;
  linkLabel?: string;
}
interface Props {
  lang?: "en" | "zh";
  id?: string;
  eyebrow: string;
  headlineLines: string[];
  accentLine?: number;
  body: string;
  facetsTitle?: string;
  facets?: Facet[];
  tracksTitle: string;
  tracksIntro: string;
  tracks: Track[];
  exploreLabel?: string;
  workshopsTitle?: string;
  workshopsIntro?: string;
  highlightsTitle?: string;
  highlights?: Highlight[];
  enterLabel?: string;
}

const {
  lang = "en",
  id = "tracks",
  eyebrow,
  headlineLines,
  accentLine = 0,
  body,
  facetsTitle = "Across The Program",
  facets = [],
  tracksTitle,
  tracksIntro,
  tracks,
  exploreLabel = "Explore track",
  workshopsTitle = lang === "zh" ? "工作坊" : "Workshops",
  workshopsIntro = lang === "zh"
    ? "通过小规模、深度参与的实践环节，与讲师一起拆解技术、工具与真实项目。"
    : "Join focused, hands-on sessions that unpack the tools, systems, and real projects behind the talks.",
  highlightsTitle,
  highlights = [],
  enterLabel = "Enter",
} = Astro.props;

const compactCopy = lang === "zh"
  ? { workshop: "工作坊", sessions: "场议程", view: "查看日程" }
  : { workshop: "Workshop", sessions: "sessions", view: "View schedule" };
const workshopTracks = schedulePreview.tracks
  .filter((track) => track.id.startsWith("ws-"))
  .map((track) => ({
    id: track.id,
    title: track.name[lang],
    talks: track.talks.map((talk) => talk.title[lang]),
    link: `${lang === "zh" ? "/zh" : ""}/schedule/#${track.id}`,
  }));

// The program preview is live, so each homepage track card links to its section.
const tracksLinked = true;

// Marquee rows: hero term (facet title) → solid orange pill; keywords → outlined.
const allPills: Array<{ text: string; hero: boolean }> = facets.flatMap((f) => [
  { text: f.title, hero: true },
  ...(f.keywords ?? []).map((k) => ({ text: k, hero: false })),
]);
const half = Math.ceil(allPills.length / 2);
const rowA = allPills.slice(0, half);
const rowB = allPills.slice(half);

// One simple line-art glyph per track (index-matched to the fixed track order),
// rendered in one restrained warm-glass treatment. Just a visual cue to what
// the track is about: 01 agentic AI → spark, 02 edge → laptop, 03 OS & apps → app window,
// 04 models → neural net, 05 robotics → robot, 06 agentic device → phone.
const trackIcons = [
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c.7 4.9 1.4 5.6 6.3 6.3C13.4 10 12.7 10.7 12 15.6 11.3 10.7 10.6 10 5.7 9.3 10.6 8.6 11.3 7.9 12 3Z"/><path d="M18.5 14.5c.3 2.2.6 2.5 2.8 2.8-2.2.3-2.5.6-2.8 2.8-.3-2.2-.6-2.5-2.8-2.8 2.2-.3 2.5-.6 2.8-2.8Z"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="5.5" width="14" height="9.5" rx="1.4"/><path d="M2.5 18.5h19l-1.6-2.6H4.1L2.5 18.5Z"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="5" width="17" height="14" rx="2.4"/><path d="M3.5 9.2h17"/><circle cx="6.6" cy="7.1" r=".55" fill="currentColor" stroke="none"/><circle cx="8.8" cy="7.1" r=".55" fill="currentColor" stroke="none"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6.7 6.9 11.3 8.7M6.7 11.4 11.3 9.3M6.7 12.6 11.3 14.7M6.7 17.1 11.3 15.3M14.7 9.3 18.3 11.4M14.7 14.7 18.3 12.6"/><circle cx="5" cy="6" r="1.7"/><circle cx="5" cy="12" r="1.7"/><circle cx="5" cy="18" r="1.7"/><circle cx="13" cy="9" r="1.7"/><circle cx="13" cy="15" r="1.7"/><circle cx="20" cy="12" r="1.7"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4.5" y="8" width="15" height="11" rx="2.5"/><path d="M12 4.5V8"/><circle cx="12" cy="3.6" r="1.1"/><path d="M9.5 13.2v1.4M14.5 13.2v1.4"/><path d="M2.8 12.5v2M21.2 12.5v2"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="6.5" y="2.5" width="11" height="19" rx="2.2"/><path d="M10 5.5h4M10.8 18.5h2.4"/><path d="M12 8c.35 2.45.7 2.8 3.15 3.15C12.7 11.5 12.35 11.85 12 14.3c-.35-2.45-.7-2.8-3.15-3.15C11.3 10.8 11.65 10.45 12 8Z"/></svg>`,
];
---

<section class="ps" data-theme-section="dark" data-bg-section="lightgray">
  <div class="ps-inner">
    <!-- ── Headline ── -->
    <div class="ps-head">
      <p class="ps-eyebrow"><span></span>{eyebrow}</p>
      <h2 class="ps-title">
        {headlineLines.map((line, i) => (
          <span class={i === accentLine ? "is-accent" : ""}>{line}</span>
        ))}
      </h2>
      <p class="ps-body">{body}</p>
    </div>

    <!-- ── Marquee pill cloud ── -->
    {allPills.length > 0 && (
      <div class="ps-marquee" aria-label={facetsTitle}>
        <span class="ps-marquee-label">{facetsTitle}</span>
        <div class="ps-mtrack ps-mtrack--l">
          <div class="ps-mtrack-row">
            {[...rowA, ...rowA].map((p) => (
              <span class={p.hero ? "ps-pill is-hero" : "ps-pill"}>{p.text}</span>
            ))}
          </div>
        </div>
        <div class="ps-mtrack ps-mtrack--r">
          <div class="ps-mtrack-row">
            {[...rowB, ...rowB].map((p) => (
              <span class={p.hero ? "ps-pill is-hero" : "ps-pill"}>{p.text}</span>
            ))}
          </div>
        </div>
      </div>
    )}

    <!-- ── Tracks — every theme stays fully visible ── -->
    <div class="ps-tracks-head" id={id}>
      <div class="ps-tracks-heading">
        <span class="ps-tracks-count">TRACKS</span>
        <h3 class="ps-tracks-title">{tracksTitle}</h3>
      </div>
      <p class="ps-tracks-intro">{tracksIntro}</p>
    </div>

    <div class="ps-track-grid">
      {tracks.map((track, i) => {
        const linked = tracksLinked && track.link;
        const Tag = linked ? "a" : "article";
        return (
          <Tag
            class="ps-track-card"
            href={linked ? track.link : undefined}
            style={`--ink: ${programCategoryColor(track.link?.split("#")[1] || "")}`}
          >
            <div class="ps-track-top">
              <span class="ps-track-num">{String(i + 1).padStart(2, "0")}</span>
              {trackIcons[i] && (
                <span class="ps-track-icon" aria-hidden="true" set:html={trackIcons[i]} />
              )}
            </div>
            <div class="ps-track-content">
              <h4 class="ps-track-title">{track.title}</h4>
              <p class="ps-track-desc">{track.text}</p>
            </div>
            <span class="ps-track-foot" aria-hidden="true">
              <span></span>
              <span>{linked ? exploreLabel : "GOSIM 2026"}</span>
            </span>
          </Tag>
        );
      })}
    </div>

    <!-- ── Compact program cards — generated from the current schedule data ── -->
    {workshopTracks.length > 0 && (
      <div class="ps-workshops ps-compact-section" id="workshops">
        <h3 class="ps-compact-label">{workshopsTitle}</h3>

        <div class="ps-compact-grid ps-workshop-grid">
          {workshopTracks.map((workshop) => (
            <a
              class="ps-compact-card ps-workshop-card"
              href={workshop.link}
              style={`--compact-ink: ${programCategoryColor(workshop.id)}`}
            >
              <div class="ps-compact-meta">
                <span>{compactCopy.workshop}</span>
                <span>{workshop.talks.length} {compactCopy.sessions}</span>
              </div>
              <h4 class="ps-compact-title">{workshop.title}</h4>
              <p class="ps-compact-text">{workshop.talks.join(" · ")}</p>
              <span class="ps-compact-foot" aria-hidden="true">
                <span></span>
                <span>{compactCopy.view}</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- ── Spotlight highlight(s) ── -->
    {highlightsTitle && highlights.length > 0 && (
      <div class="ps-spotlight ps-compact-section">
        <h3 class="ps-compact-label ps-spotlight-label">{highlightsTitle}</h3>
        <div class="ps-compact-grid ps-spotlight-grid">
          {highlights.map((item, index) => {
            const Tag = item.link ? "a" : "article";
            return (
            <Tag
              class="ps-compact-card ps-spot-card"
              href={item.link}
              target={item.link?.startsWith("http") ? "_blank" : undefined}
              rel={item.link?.startsWith("http") ? "noopener noreferrer" : undefined}
              style={`--compact-ink: ${index === 0 ? "#8096B2" : "#F84A10"}`}
            >
              <div class="ps-compact-meta">
                <span class="ps-spot-badge">{item.badge ?? highlightsTitle}</span>
                {item.status && <span class="ps-spot-status">{item.status}</span>}
              </div>
              <h4 class="ps-compact-title ps-spot-title">
                {(item.titleLines ?? [item.title]).map((line) => <span>{line}</span>)}
              </h4>
              <p class="ps-compact-text">{item.text}</p>
              {item.link && (
                <span class="ps-compact-foot" aria-hidden="true">
                  <span></span>
                  <span>{compactCopy.view}</span>
                </span>
              )}
            </Tag>
          )})}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .ps {
    --orange: #f84a10;
    --glow: #ff7a3c;
    --cream: #eae6d2;
    position: relative;
    padding: clamp(4rem, 9vw, 8rem) 0;
    background: radial-gradient(120% 80% at 80% -10%, rgba(248, 74, 16, 0.08), transparent 55%), #141209;
    overflow: hidden;
  }
  .ps-inner {
    width: 100%;
    margin-inline: auto;
    display: grid;
    /* Keep content in a centred 78rem column while allowing selected sections
       (the program marquee) to span the full viewport width. */
    grid-template-columns: minmax(1.5rem, 1fr) minmax(0, 78rem) minmax(1.5rem, 1fr);
    gap: clamp(3rem, 6vw, 5rem);
  }
  .ps-inner > * {
    grid-column: 2;
  }

  /* ── Headline ── */
  .ps-head {
    display: grid;
    gap: 1.6rem;
    max-width: 60rem;
  }
  .ps-eyebrow {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(234, 230, 210, 0.5);
  }
  .ps-eyebrow span {
    width: 2.6rem;
    height: 1px;
    background: linear-gradient(90deg, var(--orange), transparent);
  }
  .ps-title {
    margin: 0;
    font-size: clamp(2.6rem, 1.4rem + 4.6vw, 5.6rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: var(--cream);
  }
  .ps-title span {
    display: block;
  }
  .ps-title .is-accent {
    background: linear-gradient(92deg, var(--orange), var(--glow));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .ps-body {
    margin: 0;
    max-width: 46rem;
    font-size: clamp(1.1rem, 0.96rem + 0.5vw, 1.4rem);
    line-height: 1.6;
    color: rgba(234, 230, 210, 0.74);
  }

  /* ── Marquee pill cloud ── */
  .ps-inner > .ps-marquee {
    position: relative;
    isolation: isolate;
    grid-column: 1 / -1;
    display: grid;
    gap: 0.9rem;
    width: 100%;
    padding: 1.6rem 0 0.4rem;
    border-top: 1px solid rgba(234, 230, 210, 0.12);
  }
  .ps-marquee::before,
  .ps-marquee::after {
    content: "";
    position: absolute;
    z-index: 2;
    top: 1px;
    bottom: -2rem;
    width: clamp(2rem, 7vw, 7rem);
    pointer-events: none;
  }
  .ps-marquee::before {
    left: 0;
    background: linear-gradient(90deg, #141209 12%, rgba(20, 18, 9, 0));
  }
  .ps-marquee::after {
    right: 0;
    background: linear-gradient(270deg, #141209 12%, rgba(20, 18, 9, 0));
  }
  .ps-marquee-label {
    justify-self: center;
    margin-bottom: 0.4rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--orange);
  }
  .ps-mtrack {
    overflow: visible;
  }
  .ps-mtrack-row {
    display: inline-flex;
    gap: 0.7rem;
    white-space: nowrap;
    will-change: transform;
  }
  .ps-mtrack--l .ps-mtrack-row {
    animation: ps-scroll-l 42s linear infinite;
  }
  .ps-mtrack--r .ps-mtrack-row {
    animation: ps-scroll-r 50s linear infinite;
  }
  @keyframes ps-scroll-l {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @keyframes ps-scroll-r {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }
  /* Liquid-glass pills. No backdrop-filter here — there are dozens scrolling,
     so the blur is faked with a translucent fill + specular sheen + glass rim
     to keep the marquee smooth. */
  .ps-pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.3rem;
    border-radius: 999px;
    border: 0;
    background: rgba(234, 230, 210, 0.06);
    font-size: clamp(1rem, 0.92rem + 0.3vw, 1.25rem);
    font-weight: 600;
    color: rgba(234, 230, 210, 0.8);
    box-shadow:
      inset 0 1.5px 1px rgba(255, 255, 255, 0.28),
      inset 0 -3px 6px rgba(0, 0, 0, 0.14),
      0 4px 12px rgba(0, 0, 0, 0.12);
  }
  .ps-pill.is-hero {
    background: linear-gradient(95deg, rgba(248, 74, 16, 0.55), rgba(255, 122, 60, 0.5));
    color: #fff;
    font-weight: 700;
    box-shadow:
      inset 0 1.5px 1px rgba(255, 255, 255, 0.45),
      0 5px 16px rgba(248, 74, 16, 0.22);
  }
  .ps-pill::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(135deg,
      rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.08) 45%, rgba(255, 255, 255, 0.32));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    pointer-events: none;
  }

  /* ── Tracks ── */
  .ps-tracks-head {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(20rem, 1fr);
    align-items: end;
    gap: clamp(2rem, 6vw, 6rem);
    padding: 1.8rem 0 1.5rem;
    border-top: 1px solid rgba(234, 230, 210, 0.14);
    border-bottom: 1px solid rgba(234, 230, 210, 0.08);
    scroll-margin-top: 6rem;
  }
  .ps-tracks-head::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    width: clamp(5rem, 12vw, 10rem);
    height: 2px;
    background: linear-gradient(90deg, var(--orange), var(--glow), transparent);
    box-shadow: 0 0 18px rgba(248, 74, 16, 0.5);
  }
  .ps-tracks-heading {
    display: grid;
    gap: 0.65rem;
  }
  .ps-tracks-count {
    width: fit-content;
    padding-left: 0.8rem;
    border-left: 2px solid var(--orange);
    font-size: 0.64rem;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 0.2em;
    color: var(--glow);
  }
  .ps-tracks-title {
    margin: 0;
    font-size: clamp(2.6rem, 1.5rem + 3.5vw, 4.6rem);
    font-weight: 700;
    line-height: 0.96;
    letter-spacing: -0.03em;
    color: var(--cream);
  }
  .ps-tracks-intro {
    margin: 0;
    max-width: 34rem;
    font-size: 0.96rem;
    line-height: 1.65;
    color: rgba(234, 230, 210, 0.6);
  }

  .ps-track-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid rgba(234, 230, 210, 0.22);
    border-left: 1px solid rgba(234, 230, 210, 0.14);
  }
  /* Desaturated print inks: distinct enough to scan, restrained enough to keep
     the section editorial rather than reading like a neon AI dashboard. */
  .ps-track-card {
    position: relative;
    min-width: 0;
    min-height: 22rem;
    display: flex;
    flex-direction: column;
    gap: clamp(1.8rem, 3vw, 2.6rem);
    padding: clamp(1.4rem, 2.2vw, 2rem);
    border: 0;
    border-right: 1px solid rgba(234, 230, 210, 0.14);
    border-bottom: 1px solid rgba(234, 230, 210, 0.14);
    border-radius: 0;
    background: color-mix(in srgb, var(--ink) 3.5%, transparent);
    text-decoration: none;
    transition: background-color 0.25s ease, color 0.25s ease;
  }
  .ps-track-card::before {
    content: "";
    position: absolute;
    top: -1px;
    left: clamp(1.4rem, 2.2vw, 2rem);
    width: 3.5rem;
    height: 3px;
    background: var(--ink);
    transition: width 0.3s ease;
  }
  .ps-track-card[href] {
    cursor: pointer;
  }
  .ps-track-card:hover {
    background: color-mix(in srgb, var(--ink) 7%, transparent);
  }
  .ps-track-card:hover::before {
    width: calc(100% - clamp(2.8rem, 4.4vw, 4rem));
  }
  .ps-track-card[href]:focus-visible {
    outline: 2px solid var(--glow);
    outline-offset: -2px;
  }
  .ps-track-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .ps-track-num {
    display: block;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.7rem, 1.8rem + 2.4vw, 4rem);
    font-weight: 400;
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .ps-track-icon {
    width: clamp(3rem, 2.3rem + 2vw, 4.5rem);
    color: color-mix(in srgb, var(--ink) 72%, var(--cream));
  }
  .ps-track-icon svg {
    display: block;
    width: 100%;
    height: 100%;
    stroke-width: 1.25;
  }
  .ps-track-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.9rem;
  }
  .ps-track-title {
    margin: 0;
    max-width: none;
    font-size: clamp(1.55rem, 1.2rem + 0.7vw, 2rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.035em;
    text-wrap: balance;
    color: var(--cream);
  }
  .ps-track-desc {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.7;
    color: rgba(234, 230, 210, 0.62);
  }
  .ps-track-foot {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.1rem;
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    color: color-mix(in srgb, var(--ink) 52%, rgba(234, 230, 210, 0.48));
    text-transform: uppercase;
  }
  .ps-track-foot > span:first-child {
    flex: 1;
    height: 1px;
    background: color-mix(in srgb, var(--ink) 30%, rgba(234, 230, 210, 0.08));
  }

  @media (max-width: 980px) {
    .ps-tracks-head {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .ps-track-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .ps-track-grid {
      grid-template-columns: 1fr;
    }
    .ps-track-card {
      min-height: 0;
      gap: 2.5rem;
    }
  }

  /* ── Workshops, Spotlight & Hackathons ── */
  .ps-compact-section {
    display: grid;
    gap: 1rem;
    scroll-margin-top: 6rem;
  }
  .ps-compact-label {
    margin: 0;
    padding: 0.9rem 0 1rem;
    border-top: 1px solid rgba(234, 230, 210, 0.16);
    border-bottom: 1px solid rgba(234, 230, 210, 0.1);
    color: rgba(234, 230, 210, 0.72);
    font-size: clamp(1.05rem, 0.9rem + 0.45vw, 1.35rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.06em;
  }
  .ps-compact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    border-top: 1px solid rgba(234, 230, 210, 0.16);
    border-left: 1px solid rgba(234, 230, 210, 0.12);
  }
  .ps-compact-card {
    position: relative;
    min-width: 0;
    min-height: 13rem;
