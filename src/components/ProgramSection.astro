---
// Homepage program section: editorial headline + scrolling marquee word cloud
// + horizontal "diagonal-label" accordion of tracks, with an optional Spotlight
// highlight below. Replaces the former Intro + ConferenceTracks pair.
interface Facet {
  title: string;
  keywords?: string[];
}
interface Track {
  title: string;
  text: string;
  link?: string;
}
interface Highlight {
  title: string;
  text: string;
  link?: string;
}
interface Props {
  id?: string;
  eyebrow: string;
  headlineLines: string[];
  accentLine?: number;
  body: string;
  facetsTitle?: string;
  facets?: Facet[];
  tracksTitle: string;
  tracksIntro: string;
  tracks: Track[];
  exploreLabel?: string;
  highlightsTitle?: string;
  highlights?: Highlight[];
  enterLabel?: string;
}

const {
  id = "tracks",
  eyebrow,
  headlineLines,
  accentLine = 0,
  body,
  facetsTitle = "Across The Program",
  facets = [],
  tracksTitle,
  tracksIntro,
  tracks,
  exploreLabel = "Explore track",
  highlightsTitle,
  highlights = [],
  enterLabel = "Enter",
} = Astro.props;

// Schedule isn't published yet, so the track cards must NOT link to /schedule/.
// Flip this to true (keeping each track's `link` in the JSON) once the schedule
// is live to re-enable the card hyperlinks.
const tracksLinked = false;

// Marquee rows: hero term (facet title) → solid orange pill; keywords → outlined.
const allPills: Array<{ text: string; hero: boolean }> = facets.flatMap((f) => [
  { text: f.title, hero: true },
  ...(f.keywords ?? []).map((k) => ({ text: k, hero: false })),
]);
const half = Math.ceil(allPills.length / 2);
const rowA = allPills.slice(0, half);
const rowB = allPills.slice(half);

// One distinct hue per track (deeper `from` → brighter `to`). Ordered so no two
// neighbours sit close on the colour wheel — warm/cool/warm/cool spread.
const palette = [
  { from: "#F0531A", to: "#FF8A4C" }, // 01 · orange (brand)
  { from: "#0E9E8E", to: "#4FD6BF" }, // 02 · teal
  { from: "#D63C86", to: "#FF6FB4" }, // 03 · magenta
  { from: "#5BA32C", to: "#9CDE56" }, // 04 · green
  { from: "#3F6BE0", to: "#7E9CFF" }, // 05 · blue
  { from: "#7E5AE0", to: "#A98BFF" }, // 06 · violet (spare)
  { from: "#D89A1E", to: "#FFC94D" }, // 07 · gold (spare)
];

// One simple line-art glyph per track (index-matched to the fixed track order),
// inheriting the track's accent colour. Just a visual cue to what the track is
// about: 01 agentic AI → spark, 02 edge → laptop, 03 OS & apps → app window,
// 04 models → neural net, 05 robotics → robot, 06 agentic device → phone.
const trackIcons = [
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c.7 4.9 1.4 5.6 6.3 6.3C13.4 10 12.7 10.7 12 15.6 11.3 10.7 10.6 10 5.7 9.3 10.6 8.6 11.3 7.9 12 3Z"/><path d="M18.5 14.5c.3 2.2.6 2.5 2.8 2.8-2.2.3-2.5.6-2.8 2.8-.3-2.2-.6-2.5-2.8-2.8 2.2-.3 2.5-.6 2.8-2.8Z"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="5.5" width="14" height="9.5" rx="1.4"/><path d="M2.5 18.5h19l-1.6-2.6H4.1L2.5 18.5Z"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="5" width="17" height="14" rx="2.4"/><path d="M3.5 9.2h17"/><circle cx="6.6" cy="7.1" r=".55" fill="currentColor" stroke="none"/><circle cx="8.8" cy="7.1" r=".55" fill="currentColor" stroke="none"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6.7 6.9 11.3 8.7M6.7 11.4 11.3 9.3M6.7 12.6 11.3 14.7M6.7 17.1 11.3 15.3M14.7 9.3 18.3 11.4M14.7 14.7 18.3 12.6"/><circle cx="5" cy="6" r="1.7"/><circle cx="5" cy="12" r="1.7"/><circle cx="5" cy="18" r="1.7"/><circle cx="13" cy="9" r="1.7"/><circle cx="13" cy="15" r="1.7"/><circle cx="20" cy="12" r="1.7"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4.5" y="8" width="15" height="11" rx="2.5"/><path d="M12 4.5V8"/><circle cx="12" cy="3.6" r="1.1"/><path d="M9.5 13.2v1.4M14.5 13.2v1.4"/><path d="M2.8 12.5v2M21.2 12.5v2"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="6.5" y="2.5" width="11" height="19" rx="2.2"/><path d="M10 5.5h4M10.8 18.5h2.4"/><path d="M12 8c.35 2.45.7 2.8 3.15 3.15C12.7 11.5 12.35 11.85 12 14.3c-.35-2.45-.7-2.8-3.15-3.15C11.3 10.8 11.65 10.45 12 8Z"/></svg>`,
];
---

<section class="ps" data-theme-section="dark" data-bg-section="lightgray">
  <div class="ps-inner">
    <!-- ── Headline ── -->
    <div class="ps-head">
      <p class="ps-eyebrow"><span></span>{eyebrow}</p>
      <h2 class="ps-title">
        {headlineLines.map((line, i) => (
          <span class={i === accentLine ? "is-accent" : ""}>{line}</span>
        ))}
      </h2>
      <p class="ps-body">{body}</p>
    </div>

    <!-- ── Marquee pill cloud ── -->
    {allPills.length > 0 && (
      <div class="ps-marquee" aria-label={facetsTitle}>
        <span class="ps-marquee-label">{facetsTitle}</span>
        <div class="ps-mtrack ps-mtrack--l">
          <div class="ps-mtrack-row">
            {[...rowA, ...rowA].map((p) => (
              <span class={p.hero ? "ps-pill is-hero" : "ps-pill"}>{p.text}</span>
            ))}
          </div>
        </div>
        <div class="ps-mtrack ps-mtrack--r">
          <div class="ps-mtrack-row">
            {[...rowB, ...rowB].map((p) => (
              <span class={p.hero ? "ps-pill is-hero" : "ps-pill"}>{p.text}</span>
            ))}
          </div>
        </div>
      </div>
    )}

    <!-- ── Tracks — bento: big stage + small selectable blocks ── -->
    <div class="ps-tracks-head" id={id}>
      <h3 class="ps-tracks-title">{tracksTitle}</h3>
      <p class="ps-tracks-intro">{tracksIntro}</p>
    </div>

    <div class="ps-accordion">
      {tracks.map((track, i) => {
        const accent = palette[i % palette.length];
        const linked = tracksLinked && track.link;
        const Tag = linked ? "a" : "div";
        return (
          <Tag
            class={`ps-panel${i === 0 ? " is-open" : ""}`}
            href={linked ? track.link : undefined}
            style={`--from:${accent.from};--to:${accent.to}`}
            tabindex="0"
          >
            <span class="ps-panel-num">{String(i + 1).padStart(2, "0")}</span>
            {trackIcons[i] && (
              <span class="ps-panel-icon" aria-hidden="true" set:html={trackIcons[i]} />
            )}
            <span class="ps-panel-mini">{track.title}</span>
            <span class="ps-panel-full">
              <span class="ps-panel-full-title">{track.title}</span>
              <span class="ps-panel-full-desc">{track.text}</span>
            </span>
          </Tag>
        );
      })}
    </div>

    <!-- ── Spotlight highlight(s) ── -->
    {highlightsTitle && highlights.length > 0 && (
      <div class="ps-spotlight">
        <h3 class="ps-spotlight-label">{highlightsTitle}</h3>
        <div class="ps-spotlight-grid">
          {highlights.map((item) => (
            <article class="ps-spot-card">
              <span class="ps-spot-badge">{highlightsTitle}</span>
              <h4 class="ps-spot-title">{item.title}</h4>
              <p class="ps-spot-text">{item.text}</p>
              {item.link && (
                <a
                  class="ps-spot-link"
                  href={item.link}
                  target={item.link.startsWith("http") ? "_blank" : undefined}
                  rel={item.link.startsWith("http") ? "noopener noreferrer" : undefined}
                >{enterLabel} →</a>
              )}
            </article>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .ps {
    --orange: #f84a10;
    --glow: #ff7a3c;
    --cream: #eae6d2;
    position: relative;
    padding: clamp(4rem, 9vw, 8rem) 0;
    background: radial-gradient(120% 80% at 80% -10%, rgba(248, 74, 16, 0.08), transparent 55%), #141209;
    overflow: hidden;
  }
  .ps-inner {
    width: 100%;
    margin-inline: auto;
    display: grid;
    /* Keep content in a centred 78rem column while allowing selected sections
       (the program marquee) to span the full viewport width. */
    grid-template-columns: minmax(1.5rem, 1fr) minmax(0, 78rem) minmax(1.5rem, 1fr);
    gap: clamp(3rem, 6vw, 5rem);
  }
  .ps-inner > * {
    grid-column: 2;
  }

  /* ── Headline ── */
  .ps-head {
    display: grid;
    gap: 1.6rem;
    max-width: 60rem;
  }
  .ps-eyebrow {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(234, 230, 210, 0.5);
  }
  .ps-eyebrow span {
    width: 2.6rem;
    height: 1px;
    background: linear-gradient(90deg, var(--orange), transparent);
  }
  .ps-title {
    margin: 0;
    font-size: clamp(2.6rem, 1.4rem + 4.6vw, 5.6rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: var(--cream);
  }
  .ps-title span {
    display: block;
  }
  .ps-title .is-accent {
    background: linear-gradient(92deg, var(--orange), var(--glow));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .ps-body {
    margin: 0;
    max-width: 46rem;
    font-size: clamp(1.1rem, 0.96rem + 0.5vw, 1.4rem);
    line-height: 1.6;
    color: rgba(234, 230, 210, 0.74);
  }

  /* ── Marquee pill cloud ── */
  .ps-inner > .ps-marquee {
    grid-column: 1 / -1;
    display: grid;
    gap: 0.9rem;
    width: 100%;
    padding: 1.6rem 0 0.4rem;
    border-top: 1px solid rgba(234, 230, 210, 0.12);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
  }
  .ps-marquee-label {
    justify-self: center;
    margin-bottom: 0.4rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--orange);
  }
  .ps-mtrack {
    overflow: hidden;
  }
  .ps-mtrack-row {
    display: inline-flex;
    gap: 0.7rem;
    white-space: nowrap;
    will-change: transform;
  }
  .ps-mtrack--l .ps-mtrack-row {
    animation: ps-scroll-l 42s linear infinite;
  }
  .ps-mtrack--r .ps-mtrack-row {
    animation: ps-scroll-r 50s linear infinite;
  }
  @keyframes ps-scroll-l {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @keyframes ps-scroll-r {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }
  /* Liquid-glass pills. No backdrop-filter here — there are dozens scrolling,
     so the blur is faked with a translucent fill + specular sheen + glass rim
     to keep the marquee smooth. */
  .ps-pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.3rem;
    border-radius: 999px;
    border: 0;
    background: rgba(234, 230, 210, 0.06);
    font-size: clamp(1rem, 0.92rem + 0.3vw, 1.25rem);
    font-weight: 600;
    color: rgba(234, 230, 210, 0.8);
    box-shadow:
      inset 0 1.5px 1px rgba(255, 255, 255, 0.28),
      inset 0 -3px 6px rgba(0, 0, 0, 0.14),
      0 5px 14px rgba(0, 0, 0, 0.16);
  }
  .ps-pill.is-hero {
    background: linear-gradient(95deg, rgba(248, 74, 16, 0.55), rgba(255, 122, 60, 0.5));
    color: #fff;
    font-weight: 700;
    box-shadow:
      inset 0 1.5px 1px rgba(255, 255, 255, 0.45),
      0 6px 20px rgba(248, 74, 16, 0.3);
  }
  .ps-pill::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(135deg,
      rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.08) 45%, rgba(255, 255, 255, 0.32));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    pointer-events: none;
  }

  /* ── Accordion ── */
  .ps-tracks-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    scroll-margin-top: 6rem;
  }
  .ps-tracks-title {
    margin: 0;
    font-size: clamp(2rem, 1.2rem + 3vw, 3.6rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--cream);
  }
  .ps-tracks-intro {
    margin: 0;
    max-width: 34rem;
    font-size: 0.96rem;
    line-height: 1.65;
    color: rgba(234, 230, 210, 0.6);
  }

  /* ── Hover accordion: blocks grow/shrink, text always horizontal ── */
  .ps-accordion {
    display: flex;
    gap: 0.55rem;
    height: 27rem;
    align-items: stretch;
  }
  .ps-panel {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
    border-radius: 1.2rem;
    border: 0;
    background:
      radial-gradient(130% 80% at 50% 120%, color-mix(in srgb, var(--from) 36%, transparent), transparent 60%),
      linear-gradient(180deg, rgba(40, 37, 27, 0.45), rgba(22, 20, 13, 0.64));
    text-decoration: none;
    cursor: pointer;
    transition: flex-grow 0.5s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.35s ease;
  }
  .ps-panel::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: linear-gradient(90deg, var(--from), var(--to));
    opacity: 0.95;
    z-index: 2;
  }
  /* glass: a bright rim glowing in the cell accent + a crisp top edge.
     (No backdrop-filter — these sit over a solid dark section so the blur
     showed nothing, and blurring 5 large cells per frame made scroll laggy.) */
  .ps-panel {
    box-shadow:
      inset 0 1px 0.5px rgba(255, 255, 255, 0.22),
      0 18px 44px rgba(0, 0, 0, 0.3);
  }
  .ps-panel::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1.5px;
    background: linear-gradient(140deg,
      color-mix(in srgb, var(--to) 92%, white),
      rgba(255, 255, 255, 0.1) 38%,
      rgba(255, 255, 255, 0.06) 56%,
      color-mix(in srgb, var(--from) 72%, white) 100%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    pointer-events: none;
    z-index: 2;
  }
  /* the expanded block (default first, then whatever is hovered/focused) */
  .ps-panel.is-open {
    flex-grow: 1.75;
  }
  .ps-accordion:hover .ps-panel.is-open:not(:hover) {
    flex-grow: 1;
  }
  .ps-panel:hover,
  .ps-panel:focus-visible {
    flex-grow: 1.75;
    border-color: color-mix(in srgb, var(--to) 55%, transparent);
    outline: none;
  }

  .ps-panel-num {
    position: absolute;
    top: 1.3rem;
    left: 1.5rem;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--to);
    font-variant-numeric: tabular-nums;
    z-index: 2;
  }

  /* Big track glyph in the cell's accent colour — a clear cue to the topic */
  .ps-panel-icon {
    position: absolute;
    top: 3.4rem;
    left: 1.5rem;
    width: clamp(5rem, 9vw, 8rem);
    height: auto;
    color: var(--to);
    opacity: 0.85;
    pointer-events: none;
    z-index: 1;
    filter: drop-shadow(0 4px 16px color-mix(in srgb, var(--to) 40%, transparent));
  }
  .ps-panel-icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Collapsed label — shows the FULL title, wrapped (never truncated). Its width
     is fixed to the viewport (not the animating panel) so it wraps once and never
     reflows while the panel resizes — no jumping. */
  .ps-panel-mini {
    position: absolute;
    left: 1.25rem;
    bottom: 1.5rem;
    width: calc(100% - 2.5rem);
    font-size: clamp(1rem, 0.9rem + 0.3vw, 1.2rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    overflow-wrap: normal;
    text-wrap: balance;
    color: var(--cream);
    opacity: 1;
    transition: opacity 0.25s ease;
  }

  /* Expanded content — FIXED width (independent of the animating panel width),
     so its line-wrapping is computed once and never reflows. It only fades in,
     arriving already at its final position. */
  .ps-panel-full {
    position: absolute;
    left: 1.25rem;
    bottom: 1.5rem;
    width: calc(100% - 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease 0.12s;
  }
  .ps-panel-full-title {
    font-size: clamp(1.45rem, 1.1rem + 1vw, 2rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--cream);
  }
  .ps-panel-full-desc {
    font-size: 0.97rem;
    line-height: 1.6;
    color: rgba(234, 230, 210, 0.74);
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* crossfade collapsed label → expanded content on the open/hovered block */
  .ps-panel.is-open .ps-panel-mini,
  .ps-panel:hover .ps-panel-mini,
  .ps-panel:focus-visible .ps-panel-mini {
    opacity: 0;
  }
  .ps-panel.is-open .ps-panel-full,
  .ps-panel:hover .ps-panel-full,
  .ps-panel:focus-visible .ps-panel-full {
    opacity: 1;
  }
  .ps-accordion:hover .ps-panel.is-open:not(:hover) .ps-panel-mini {
    opacity: 1;
  }
  .ps-accordion:hover .ps-panel.is-open:not(:hover) .ps-panel-full {
    opacity: 0;
  }

  @media (max-width: 1100px) {
    .ps-accordion {
      flex-direction: column;
      height: auto;
    }
    .ps-panel {
      flex: none;
      min-height: 0;
    }
    .ps-panel-mini {
      display: none;
    }
    /* Stacked cards: park the glyph in the top-right corner (smaller) so it
       reads as a corner accent instead of sitting on top of the left-aligned
       title and body text. */
    .ps-panel-icon {
      top: 1rem;
      left: auto;
      right: 1.25rem;
      width: clamp(2.5rem, 11vw, 3.5rem);
      opacity: 0.7;
    }
    /* on the stacked layout every block shows its full content. The top padding
       clears both the number (top-left) and the glyph (top-right) so nothing
       overlaps the text. */
    .ps-panel-full,
    .ps-accordion:hover .ps-panel.is-open:not(:hover) .ps-panel-full {
      position: relative;
      left: 0;
      bottom: 0;
      width: auto;
      opacity: 1;
      padding: 4.6rem 1.5rem 1.6rem;
    }
    .ps-panel-full-desc {
      -webkit-line-clamp: unset;
    }
  }

  /* ── Spotlight ── */
  .ps-spotlight {
    display: grid;
    gap: 1.4rem;
  }
  .ps-spotlight-label {
    margin: 0;
    padding-bottom: 1rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(234, 230, 210, 0.45);
    border-bottom: 1px solid rgba(234, 230, 210, 0.1);
  }
  .ps-spotlight-grid {
    display: grid;
    /* min(22rem, 100%) keeps the 22rem min on wide screens but lets each column
       shrink to the container on narrow ones, so the grid never overflows the gutter */
    grid-template-columns: repeat(auto-fill, minmax(min(22rem, 100%), 1fr));
    gap: 1.25rem;
  }
  .ps-spot-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 2rem;
    border-radius: 1.25rem;
    border: 0;
    background:
      linear-gradient(135deg, rgba(248, 74, 16, 0.2) 0%, rgba(26, 24, 17, 0.78) 60%);
    box-shadow:
      inset 0 1px 0.5px rgba(255, 255, 255, 0.24),
      0 16px 40px rgba(0, 0, 0, 0.32);
  }
  .ps-spot-card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1.5px;
    background: linear-gradient(140deg,
      rgba(255, 170, 100, 0.95), rgba(255, 255, 255, 0.12) 42%, rgba(255, 255, 255, 0.32));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
