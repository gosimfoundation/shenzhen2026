---
import SlidesDownloadOptions from "components/SlidesDownloadOptions.astro";
import { slidesDownloadCopy } from "utils/event-summary";

interface Props { lang: "en" | "zh" }
const { lang } = Astro.props;
const copy = slidesDownloadCopy[lang];
---

<dialog id="slides-download-dialog" class="slides-download-dialog" aria-labelledby="slides-download-title" data-lenis-prevent>
  <div class="download-dialog-content">
    <div class="download-dialog-header">
      <h2 id="slides-download-title">{copy.title}</h2>
      <button type="button" class="download-dialog-close" aria-label={copy.closeLabel} data-slides-close>×</button>
    </div>
    <SlidesDownloadOptions lang={lang} />
  </div>
</dialog>

<script>
  import { setupSlidesDownloadDialog } from "../scripts/slides-download";
  setupSlidesDownloadDialog();
  document.addEventListener("astro:page-load", setupSlidesDownloadDialog);
</script>

<style>
  .slides-download-dialog { position: fixed; inset: 0; box-sizing: border-box; width: min(320px, calc(100% - 2rem)); max-height: calc(100svh - 2rem); margin: auto; padding: 0; border: 1px solid #dedacf; border-radius: 1rem; background: #f8f6ef; color: #24241f; box-shadow: 0 1.5rem 6rem #0005; overflow: auto; overscroll-behavior: contain; }
  .slides-download-dialog::backdrop { background: #111b; backdrop-filter: blur(5px); }
  .download-dialog-content { padding: 1.25rem; }
  .download-dialog-header { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; margin-bottom: 1rem; }
  .download-dialog-header h2 { margin: 0; color: #24241f; font-size: 1.1rem; line-height: 1.4; }
  .download-dialog-close { display: grid; place-items: center; flex: 0 0 2.25rem; width: 2.25rem; height: 2.25rem; margin-right: -0.25rem; padding: 0; border: 1px solid #d9d6cb; border-radius: 50%; background: transparent; color: #24241f; font-size: 1.5rem; line-height: 1; cursor: pointer; }
  .download-dialog-close:hover { background: #ece8dc; }
  .download-dialog-close:focus-visible { outline: 3px solid #c94513; outline-offset: 3px; }
  :global(body:has(.slides-download-dialog[open])) { overflow: hidden; }
</style>
