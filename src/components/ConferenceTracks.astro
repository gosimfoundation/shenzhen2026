        <rect x="172" y="168" width="376" height="532" rx="40" fill="#ffffff" fill-opacity="0.08" stroke="#ffffff" stroke-opacity="0.26" stroke-width="6" />
        <path d="M236 276H482" stroke="#ffffff" stroke-opacity="0.36" stroke-width="16" stroke-linecap="round" />
