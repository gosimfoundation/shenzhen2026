        <path d="M190 396H528" />
      </g>
      <g fill="#ffffff" fill-opacity="0.12" stroke="#ffffff" stroke-opacity="0.24" stroke-width="6">
        <rect x="194" y="320" width="132" height="112" rx="28" />
        <rect x="360" y="320" width="164" height="112" rx="28" />
        <rect x="242" y="470" width="236" height="90" rx="26" />
      </g>
      <g fill="#ffffff" fill-opacity="0.46">
        <circle cx="136" cy="238" r="16" />
