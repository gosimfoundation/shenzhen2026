---
interface Track {
  title: string;
  text: string;
  link?: string;
}

type WorkshopTheme = "structured-runtime" | "model-serving" | "open-tooling" | "agentic-build" | "open-compute" | "intelligent-os" | "lunch-learn";
type HighlightTheme = "frontier-demo" | "robotics-hackathon" | "agentic-hackathon";

interface CardItem {
  title: string;
  text: string;
  image?: string;
  link?: string;
  theme?: WorkshopTheme;
}

interface Props {
  id?: string;
  kicker?: string;
  title: string;
  intro?: string;
  tracksTitle?: string;
  tracks: Track[];
  workshopsTitle?: string;
  workshops?: CardItem[];
  highlightsTitle?: string;
  highlights?: CardItem[];
  viewRouteLabel?: string;
  labLabel?: string;
  openLabel?: string;
  enterLabel?: string;
  titleLink?: string;
  titleLinkLabel?: string;
}

const {
  id = "tracks",
  kicker = "Track Atlas",
  title,
  intro = "A route map for the agentic stack: each line carries a different signal, from embodied systems and open models to edge deployment and new agent runtimes.",
  tracksTitle,
  tracks,
  workshopsTitle,
  workshops,
  highlightsTitle,
  highlights,
  viewRouteLabel = "View Schedule",
  labLabel = "Lab",
  openLabel = "View Schedule",
  enterLabel = "Enter",
  titleLink,
  titleLinkLabel = "View Schedule",
} = Astro.props;

const routePalette = [
  { from: "#8A7F5C", to: "#A89968" },
  { from: "#C23A0C", to: "#FF7A3C" },
  { from: "#6B6450", to: "#B3A878" },
  { from: "#7C7050", to: "#C9BD8F" },
  { from: "#8F8259", to: "#FF7A3C" },
  { from: "#74694C", to: "#D0C49A" },
  { from: "#A89968", to: "#D0C49A" },
];

const signalSets = [
  ["MCP", "A2A", "Sovereign"],
  ["Embodied", "Hardware", "OpenArm"],
  ["Multimodal", "Agents", "Creative"],
  ["On-device", "Realtime", "Compression"],
  ["Runtime", "Coordination", "Trust"],
  ["LLM", "Audio", "Vision"],
  ["Systems", "Tooling", "Builders"],
];

const teaserFromText = (text: string) => {
  const cleaned = text.replace(/\s+/g, " ").trim();
  if (!cleaned) {
    return "";
  }

  const firstSentence = cleaned
    .split(/(?<=[.!?。])/)
    .map((part) => part.trim())
    .filter(Boolean)[0] || cleaned;

  if (firstSentence.length <= 170) {
    return firstSentence;
  }
  return `${firstSentence.slice(0, 167).trim()}...`;
};

const routeCodeFromTitle = (title: string, index: number) => {
  const letters = title
    .replace(/\(.*?\)/g, "")
    .split(/[^A-Za-z0-9\u4e00-\u9fff]+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => {
      const ascii = word.match(/[A-Za-z]/);
      return ascii ? ascii[0].toUpperCase() : word[0];
    })
    .join("");

  return `${letters || "R"}${String(index + 1).padStart(2, "0")}`;
};

const svgToDataUri = (svg: string) =>
  `data:image/svg+xml,${encodeURIComponent(svg)
    .replace(/%0A/g, "")
    .replace(/%20/g, " ")}`;

