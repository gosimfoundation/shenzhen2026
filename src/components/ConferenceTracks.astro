const trackCards = tracks.map((track, index) => {
  const accent = routePalette[index % routePalette.length];
  const signals = signalSets[index % signalSets.length];

  return {
    ...track,
    accent,
    signals,
    teaser: teaserFromText(track.text),
    code: routeCodeFromTitle(track.title, index),
    anchor: `track-route-${index + 1}`,
  };
});

const workshopThemeMeta: Record<
  WorkshopTheme,
  { accent: { from: string; to: string } }
> = {
  "structured-runtime": {
    accent: { from: "#8A7F5C", to: "#A89968" },
  },
  "model-serving": {
    accent: { from: "#C23A0C", to: "#FF7A3C" },
  },
  "open-tooling": {
    accent: { from: "#7C7050", to: "#C9BD8F" },
  },
  "agentic-build": {
    accent: { from: "#8A7F5C", to: "#A89968" },
  },
  "open-compute": {
    accent: { from: "#6B6450", to: "#B3A878" },
  },
  "intelligent-os": {
    accent: { from: "#8F8259", to: "#FF7A3C" },
  },
  "lunch-learn": {
    accent: { from: "#A89968", to: "#D0C49A" },
  },
};

const inferWorkshopTheme = (item: CardItem): WorkshopTheme => {
  if (item.theme) {
    return item.theme;
  }

  const text = `${item.title} ${item.text}`.toLowerCase();
  if (text.includes("sglang")) return "structured-runtime";
  if (text.includes("vllm")) return "model-serving";
  if (text.includes("agentic app")) return "agentic-build";
  if (text.includes("open compute") || text.includes("flagos")) return "open-compute";
  if (text.includes("openharmony")) return "intelligent-os";
  if (text.includes("lunch") || text.includes("fundamental")) return "lunch-learn";
  return "open-tooling";
};

const workshopCards = (workshops || []).map((item, index) => {
  const theme = inferWorkshopTheme(item);
  const themeMeta = workshopThemeMeta[theme];
  return {
    ...item,
    theme,
    accent: themeMeta.accent,
    background: workshopBackgroundSvg(theme, themeMeta.accent.from, themeMeta.accent.to),
    code: `WS-${String(index + 1).padStart(2, "0")}`,
  };
});

const highlightThemeMeta: Record<
  HighlightTheme,
  { accent: { from: string; to: string }; label: string; codePrefix: string }
> = {
  "frontier-demo": {
    accent: { from: "#C23A0C", to: "#FF7A3C" },
    label: "Spotlight",
    codePrefix: "SP",
  },
  "robotics-hackathon": {
    accent: { from: "#8A7F5C", to: "#A89968" },
    label: "Hackathon",
    codePrefix: "RB",
  },
  "agentic-hackathon": {
    accent: { from: "#7C7050", to: "#C9BD8F" },
    label: "Hackathon",
    codePrefix: "AG",
  },
};

const inferHighlightTheme = (item: CardItem): HighlightTheme => {
  const text = `${item.title} ${item.text}`.toLowerCase();
  if (text.includes("robot") || text.includes("openarm")) {
    return "robotics-hackathon";
  }
  if (text.includes("agent")) {
    return "agentic-hackathon";
  }
  return "frontier-demo";
};

const highlightCards = (highlights || []).map((item, index) => {
  const theme = inferHighlightTheme(item);
  const themeMeta = highlightThemeMeta[theme];
  return {
    ...item,
    theme,
    accent: themeMeta.accent,
    badge: themeMeta.label,
    code: `${themeMeta.codePrefix}-${String(index + 1).padStart(2, "0")}`,
    background: highlightBackgroundSvg(theme, themeMeta.accent.from, themeMeta.accent.to),
  };
});
---

<section
  class="section section-track-atlas"
  id={id}
  data-theme-section="light"
  data-bg-section="lightgray"
  data-scroll-section
>
  <div class="track-atlas-noise"></div>
  <div class="container">
    <div class="track-atlas-header">
      <span class="track-atlas-kicker animate-fade-in">{kicker}</span>
      <div class="track-atlas-title-row animate-fade-in animate-delay-1">
        <h2 class="track-atlas-title">{title}</h2>
        {titleLink && (
          <a href={titleLink} class="track-atlas-title-link">{titleLinkLabel} →</a>
        )}
      </div>
      <p class="track-atlas-intro animate-fade-in animate-delay-2">
        {intro}
      </p>
    </div>

    {tracksTitle && <h3 class="track-section-title animate-fade-in">{tracksTitle}</h3>}

    <div class="track-route-strip animate-fade-in animate-delay-1">
      {
        trackCards.map((track) => (
          <a
            href={`#${track.anchor}`}
            class="route-chip"
            style={`--accent-from:${track.accent.from}; --accent-to:${track.accent.to};`}
          >
            <span class="route-chip-code">{track.code}</span>
            <span class="route-chip-title">{track.title}</span>
          </a>
        ))
      }
    </div>

    <div class="track-route-board">
      <div class="track-route-spine"></div>
      {
        trackCards.map((track, index) => (
          <article
            id={track.anchor}
            class={`track-station animate-slide-up ${index % 2 === 0 ? "is-left" : "is-right"}`}
            style={`--accent-from:${track.accent.from}; --accent-to:${track.accent.to}; --stagger:${index};`}
            data-href={track.link || undefined}
          >
            <div class="track-stop">
              <span class="track-stop-dot"></span>
              <span class="track-stop-code">{track.code}</span>
            </div>

            <div class="track-panel">
              <div class="track-panel-top">
                <span class="track-panel-index">{String(index + 1).padStart(2, "0")}</span>
                {track.link && <a href={track.link} class="track-visit-link">{viewRouteLabel} &rarr;</a>}
              </div>

              <h4>{track.title}</h4>
              <p class="track-teaser">{track.teaser}</p>

              <div class="track-signal-row">
                {
                  track.signals.map((signal) => (
                    <span class="track-signal-pill">{signal}</span>
                  ))
                }
              </div>

              <div class="track-desc-wrap">
                <p class="track-desc">{track.text}</p>
              </div>

              <div class="track-panel-footer">
                <span class="track-scanline"></span>
                <span class="track-chevron"></span>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    {workshopsTitle && workshopCards.length > 0 && (
      <>
        <h3 class="track-section-title animate-fade-in">{workshopsTitle}</h3>
        <div class="support-grid">
          {
            workshopCards.map((item, index) => (
              <article
                class="support-card support-card-workshop animate-slide-up"
                data-workshop-theme={item.theme}
                data-href={item.link || undefined}
                style={`--accent-from:${item.accent.from}; --accent-to:${item.accent.to}; --stagger:${index}; --workshop-bg:url('${item.background}');`}
              >
                <div class="support-workshop-grid"></div>
                <div class="support-workshop-vignette"></div>
                <div class="support-workshop-wash"></div>

                <div class="support-workshop-content">
                  <div class="support-card-top">
                    <span class="support-card-label">{labLabel}</span>
                    <span class="support-card-code">{item.code}</span>
                  </div>

                  <div class="support-workshop-overlay">
                    <div class="support-workshop-meta">
                      <span class="support-workshop-rule"></span>
                      {item.link && (
                        <a
                          href={item.link}
                          class="support-link"
                          target={item.link.startsWith("http") ? "_blank" : undefined}
                          rel={item.link.startsWith("http") ? "noopener noreferrer" : undefined}
                        >
                          {openLabel} &rarr;
                        </a>
                      )}
                    </div>

                    <h4>{item.title}</h4>
                    <p>{item.text}</p>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </>
    )}

    {highlightsTitle && highlightCards.length > 0 && (
      <>
        <h3 class="track-section-title animate-fade-in">{highlightsTitle}</h3>
        <div class="support-grid support-grid-highlights">
          {
            highlightCards.map((item, index) => (
              <article
                class="support-card support-card-workshop support-card-highlight-immersive highlight-card animate-slide-up"
                data-highlight-theme={item.theme}
                style={`--accent-from:${item.accent.from}; --accent-to:${item.accent.to}; --stagger:${index}; --workshop-bg:url('${item.background}');`}
              >
                <div class="support-workshop-grid"></div>
                <div class="support-workshop-vignette"></div>
                <div class="support-workshop-wash"></div>

                <div class="support-workshop-content">
                  <div class="support-card-top">
                    <span class="support-card-label">{item.badge}</span>
                    <span class="support-card-code">{item.code}</span>
                  </div>

                  <div class="support-workshop-overlay">
                    <div class="support-workshop-meta">
                      <span class="support-workshop-rule"></span>
                      {item.link && (
                        <a
                          href={item.link}
                          class="support-link"
                          target={item.link.startsWith("http") ? "_blank" : undefined}
                          rel={item.link.startsWith("http") ? "noopener noreferrer" : undefined}
                        >
                          {enterLabel} &rarr;
                        </a>
                      )}
                    </div>
                    <h4>{item.title}</h4>
                    <p>{item.text}</p>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </>
    )}
  </div>
</section>

<script>
  function initTrackAtlas() {
    const targets = document.querySelectorAll(
      ".section-track-atlas .animate-fade-in, .section-track-atlas .animate-slide-up",
    );

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -50px 0px" },
    );

    targets.forEach((target) => observer.observe(target));

    document.querySelectorAll(".section-track-atlas .support-card[data-href]").forEach((card) => {
      if (card.dataset.initialized === "true") return;
      card.dataset.initialized = "true";
      card.style.cursor = "pointer";
      card.addEventListener("click", (event) => {
        if (event.target.closest("a")) return;
        window.location.href = card.dataset.href;
      });
    });

    document.querySelectorAll(".section-track-atlas .track-station").forEach((station) => {
      if (station.dataset.initialized === "true") {
        return;
      }

      station.dataset.initialized = "true";
      station.addEventListener("click", (event) => {
        if (event.target.closest(".track-visit-link")) {
          return;
        }
        if (station.dataset.href) {
          window.location.href = station.dataset.href;
          return;
        }
        station.classList.toggle("expanded");
      });
    });
  }

  initTrackAtlas();
  document.addEventListener("astro:page-load", initTrackAtlas);
</script>

