      <g fill="#ffffff" fill-opacity="0.48">
        <circle cx="286" cy="590" r="18" />
        <circle cx="360" cy="452" r="22" />
        <circle cx="438" cy="330" r="18" />
        <circle cx="534" cy="248" r="16" />
      </g>
    `,
