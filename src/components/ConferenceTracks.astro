const highlightBackgroundSvg = (
  theme: HighlightTheme,
  from: string,
  to: string,
) => {
  const sharedDefs = `
    <defs>
      <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="${from}" />
        <stop offset="100%" stop-color="${to}" />
      </linearGradient>
      <radialGradient id="glowA" cx="0.22" cy="0.18" r="0.74">
        <stop offset="0%" stop-color="#ffffff" stop-opacity="0.24" />
        <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="glowB" cx="0.78" cy="0.82" r="0.68">
        <stop offset="0%" stop-color="#ffffff" stop-opacity="0.18" />
        <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
      </radialGradient>
      <pattern id="micro" width="34" height="34" patternUnits="userSpaceOnUse">
        <path d="M0 0H34V34" fill="none" stroke="#ffffff" stroke-opacity="0.08" />
