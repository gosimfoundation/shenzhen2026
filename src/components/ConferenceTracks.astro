const trackCards = tracks.map((track, index) => {
  const accent = routePalette[index % routePalette.length];
  const signals = signalSets[index % signalSets.length];

  return {
    ...track,
    accent,
    signals,
    teaser: teaserFromText(track.text),
    code: routeCodeFromTitle(track.title, index),
    anchor: `track-route-${index + 1}`,
  };
});

const workshopThemeMeta: Record<
  WorkshopTheme,
  { accent: { from: string; to: string } }
> = {
  "structured-runtime": {
    accent: { from: "#8A7F5C", to: "#A89968" },
  },
  "model-serving": {
    accent: { from: "#C23A0C", to: "#FF7A3C" },
  },
  "open-tooling": {
    accent: { from: "#7C7050", to: "#C9BD8F" },
  },
  "agentic-build": {
    accent: { from: "#8A7F5C", to: "#A89968" },
  },
  "open-compute": {
    accent: { from: "#6B6450", to: "#B3A878" },
  },
  "intelligent-os": {
    accent: { from: "#8F8259", to: "#FF7A3C" },
  },
  "lunch-learn": {
    accent: { from: "#A89968", to: "#D0C49A" },
  },
};

const inferWorkshopTheme = (item: CardItem): WorkshopTheme => {
  if (item.theme) {
    return item.theme;
  }

  const text = `${item.title} ${item.text}`.toLowerCase();
  if (text.includes("sglang")) return "structured-runtime";
  if (text.includes("vllm")) return "model-serving";
  if (text.includes("agentic app")) return "agentic-build";
  if (text.includes("open compute") || text.includes("flagos")) return "open-compute";
  if (text.includes("openharmony")) return "intelligent-os";
  if (text.includes("lunch") || text.includes("fundamental")) return "lunch-learn";
  return "open-tooling";
};

const workshopCards = (workshops || []).map((item, index) => {
  const theme = inferWorkshopTheme(item);
  const themeMeta = workshopThemeMeta[theme];
  return {
    ...item,
    theme,
    accent: themeMeta.accent,
    background: workshopBackgroundSvg(theme, themeMeta.accent.from, themeMeta.accent.to),
    code: `WS-${String(index + 1).padStart(2, "0")}`,
  };
});

const highlightThemeMeta: Record<
  HighlightTheme,
  { accent: { from: string; to: string }; label: string; codePrefix: string }
> = {
  "frontier-demo": {
    accent: { from: "#C23A0C", to: "#FF7A3C" },
    label: "Spotlight",
    codePrefix: "SP",
  },
  "robotics-hackathon": {
    accent: { from: "#8A7F5C", to: "#A89968" },
    label: "Hackathon",
    codePrefix: "RB",
  },
  "agentic-hackathon": {
    accent: { from: "#7C7050", to: "#C9BD8F" },
    label: "Hackathon",
    codePrefix: "AG",
  },
};

const inferHighlightTheme = (item: CardItem): HighlightTheme => {
  const text = `${item.title} ${item.text}`.toLowerCase();
  if (text.includes("robot") || text.includes("openarm")) {
    return "robotics-hackathon";
  }
  if (text.includes("agent")) {
    return "agentic-hackathon";
  }
  return "frontier-demo";
};

const highlightCards = (highlights || []).map((item, index) => {
  const theme = inferHighlightTheme(item);
  const themeMeta = highlightThemeMeta[theme];
  return {
    ...item,
    theme,
    accent: themeMeta.accent,
    badge: themeMeta.label,
    code: `${themeMeta.codePrefix}-${String(index + 1).padStart(2, "0")}`,
    background: highlightBackgroundSvg(theme, themeMeta.accent.from, themeMeta.accent.to),
  };
});
---

<section
  class="section section-track-atlas"
  id={id}
  data-theme-section="light"
  data-bg-section="lightgray"
  data-scroll-section
>
  <div class="track-atlas-noise"></div>
  <div class="container">

    <div class="track-atlas-header">
      {kicker && <span class="track-atlas-kicker animate-fade-in">{kicker}</span>}
      <div class="track-atlas-title-row animate-fade-in animate-delay-1">
        <h2 class="track-atlas-title">{title}</h2>
        {titleLink && (
          <a href={titleLink} class="track-atlas-title-link">{titleLinkLabel} →</a>
        )}
      </div>
      <p class="track-atlas-intro animate-fade-in animate-delay-2">{intro}</p>
    </div>

    {tracksTitle && <h3 class="track-section-label animate-fade-in">{tracksTitle}</h3>}

    <div class="tracks-grid">
      {trackCards.map((track, index) => (
        <article
          id={track.anchor}
          class="track-card animate-slide-up"
          style={`--accent-from:${track.accent.from}; --accent-to:${track.accent.to}; --stagger:${index};`}
        >
          <div class="track-card-head">
            <span class="track-num">{String(index + 1).padStart(2, "0")}</span>
            <h4 class="track-title">{track.title}</h4>
          </div>
          <p class="track-body">{track.text}</p>
        </article>
      ))}
    </div>

    {highlightsTitle && highlightCards.length > 0 && (
      <>
        <h3 class="track-section-label track-section-label--spotlight animate-fade-in">{highlightsTitle}</h3>
        <div class="spotlight-grid">
          {highlightCards.map((item, index) => (
            <article
              class="spotlight-card animate-slide-up"
              style={`--accent-from:${item.accent.from}; --accent-to:${item.accent.to}; --stagger:${index};`}
            >
              <span class="spotlight-badge">{item.badge}</span>
              <h4 class="spotlight-title">{item.title}</h4>
              <p class="spotlight-body">{item.text}</p>
              {item.link && (
                <a
                  href={item.link}
                  class="spotlight-link"
                  target={item.link.startsWith("http") ? "_blank" : undefined}
                  rel={item.link.startsWith("http") ? "noopener noreferrer" : undefined}
                >{enterLabel} →</a>
              )}
            </article>
          ))}
        </div>
      </>
    )}

  </div>
</section>

<script>
  function initTrackAtlas() {
    const targets = document.querySelectorAll(
      ".section-track-atlas .animate-fade-in, .section-track-atlas .animate-slide-up",
    );

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -50px 0px" },
    );

    targets.forEach((target) => observer.observe(target));
  }

  initTrackAtlas();
  document.addEventListener("astro:page-load", initTrackAtlas);
</script>

<style>
  /* ─── Section shell ─────────────────────────────── */
  .section-track-atlas {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, #1B1912 0%, #161410 100%);
  }

  .track-atlas-noise {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(234, 230, 210, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(234, 230, 210, 0.07) 1px, transparent 1px);
    background-size: 3rem 3rem;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.85), transparent);
  }

  .section-track-atlas .container {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.5rem;
  }

  .track-atlas-header {
    display: grid;
    gap: 0.8rem;
    max-width: 48rem;
  }

  .track-atlas-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(234, 230, 210, 0.75);
  }

  .track-atlas-kicker::before {
    content: "";
    width: 3rem;
    height: 1px;
    background: linear-gradient(90deg, #F84A10, transparent);
  }

  .track-atlas-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .track-atlas-title {
    margin: 0;
    font-size: clamp(2.4rem, 4vw, 4.8rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
    color: #EAE6D2;
  }

  .track-atlas-title-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #F84A10;
    text-decoration: none;
    white-space: nowrap;
    padding: 0.6rem 1.25rem;
    border: 2px solid #F84A10;
    border-radius: 8px;
    transition: background 0.15s, color 0.15s;
    flex-shrink: 0;
  }

  .track-atlas-title-link:hover {
    background: #F84A10;
    color: #EAE6D2;
  }

  .track-atlas-intro {
    margin: 0;
    font-size: 1rem;
    line-height: 1.75;
    color: rgba(234, 230, 210, 0.75);
  }

  /* ─── Section label (above tracks / spotlight) ─── */
  .track-section-label {
    margin: 2rem 0 0;
    padding-bottom: 1rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(234, 230, 210, 0.45);
    border-bottom: 1px solid rgba(234, 230, 210, 0.1);
  }

  .track-section-label--spotlight {
    margin-top: 3.5rem;
  }

  /* ─── Tracks grid (primary content) ─────────────── */
  .tracks-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .track-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: 2.2rem 2rem 2rem;
