---
import { EARLY_BIRD_DEADLINE, TICKET_SALES_DEADLINE } from 'utils/ticket-promotion';
interface Props { lang: 'en' | 'zh'; }
const { lang } = Astro.props;
const zh = lang === 'zh';
---

<aside class="ticket-promotion" data-ticket-promotion hidden aria-label={zh ? '限时购票优惠' : 'Ticket offers'}>
  <a href="https://www.bagevent.com/event/gosimshenzhen2026#website_moduleId_1164696" target="_blank" rel="noopener noreferrer">
    <span class="promotion-message" data-ticket-phase="early" hidden>
      <strong>{zh ? '标准票／全通票早鸟减 ¥100' : 'Standard & all-access early birds: save ¥100 each'}</strong>
      <span class="promotion-detail">{zh ? '学生早鸟票 ¥75' : 'Student early-bird ticket: ¥75'}</span>
      <time datetime={EARLY_BIRD_DEADLINE}>{zh ? '9 月 17 日 23:55 截止（北京时间）' : 'Ends 17 Sep, 23:55 (UTC+8)'}</time>
    </span>
    <span class="promotion-message" data-ticket-phase="standard" hidden>
      <strong>{zh ? 'GOSIM 深圳 · 学生票 ¥99' : 'GOSIM Shenzhen · Students ¥99'}</strong>
      <time datetime={TICKET_SALES_DEADLINE}>{zh ? '10 月 17 日 18:00 截止（北京时间）' : 'Ends 17 Oct, 18:00 (UTC+8)'}</time>
    </span>
    <span class="promotion-cta">{zh ? '立即购票' : 'Get tickets'} <span aria-hidden="true">↗</span></span>
  </a>
</aside>

<script>
  import { ticketPromotionPhase } from 'utils/ticket-promotion';
  function updateTicketPromotions() {
    const phase = ticketPromotionPhase();
    document.querySelectorAll<HTMLElement>('[data-ticket-promotion]').forEach(banner => {
      banner.hidden = phase === 'closed';
      banner.querySelectorAll<HTMLElement>('[data-ticket-phase]').forEach(panel => {
        panel.hidden = panel.dataset.ticketPhase !== phase;
      });
    });
  }
  const syncPromotionHeight = () => {
    const banner = document.querySelector<HTMLElement>('[data-ticket-promotion]');
    document.documentElement.style.setProperty('--ticket-promotion-height', `${banner?.getBoundingClientRect().height ?? 0}px`);
  };
  const banner = document.querySelector<HTMLElement>('[data-ticket-promotion]');
  if (banner) new ResizeObserver(syncPromotionHeight).observe(banner);
  updateTicketPromotions();
  syncPromotionHeight();
  window.setInterval(updateTicketPromotions, 1000);
  document.addEventListener('visibilitychange', updateTicketPromotions);
  document.addEventListener('astro:page-load', updateTicketPromotions);
</script>

<style>
  [hidden] { display: none !important; }
  .ticket-promotion {
    position: fixed;
    inset: 0 0 auto;
    z-index: 202;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: #ffb341;
    color: #241507;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.18);
  }
  a { flex: 1; min-width: 0; display: flex; justify-content: center; align-items: center; gap: 1.5rem; min-height: 44px; padding: 9px 20px; color: inherit; text-decoration: none; font-size: 14px; line-height: 1.4; }
  a:hover { background: rgba(255, 255, 255, 0.14); }
  a:focus-visible { outline: 3px solid currentColor; outline-offset: -4px; }
  .promotion-message { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 4px 18px; }
  strong { font-weight: 800; color: inherit; }
  .promotion-cta { flex-shrink: 0; font-weight: 800; text-decoration: underline; text-underline-offset: 3px; }
  /* Keep all offer text still; animate only the background glow and CTA arrow. */
  .ticket-promotion::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: -40%;
    width: 40%;
    pointer-events: none;
    background: linear-gradient(110deg, transparent 5%, rgba(255, 249, 219, 0.85) 50%, transparent 95%);
    animation: promotion-glow 3.6s ease-in-out infinite;
  }
  a { position: relative; z-index: 1; transition: background-color 180ms ease; }
  .promotion-cta > span { display: inline-block; animation: promotion-arrow 3.6s ease-in-out infinite; }
  @keyframes promotion-glow {
    0% { transform: translateX(0); }
    65%, 100% { transform: translateX(350%); }
  }
  @keyframes promotion-arrow {
    0%, 18%, 42%, 66%, 100% { transform: translate(0, 0); }
    30%, 54% { transform: translate(5px, -4px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticket-promotion::before, .promotion-cta > span { animation: none; }
    a { transition: none; }
  }
  :global(body) { padding-top: var(--ticket-promotion-height, 0px); }
  :global(body > header) { top: var(--ticket-promotion-height, 0px); }
  @media (max-width: 700px) {
    a { padding: 7px 12px; gap: 10px; font-size: 12px; }
    .promotion-message { justify-content: flex-start; gap: 2px 10px; }
    time { font-size: 11px; }
  }
</style>
