---
// Current sponsors and partners share the sponsor page's data source.
import sponsors from "json/Sponsors.json";

interface Props {
  lead: string;
  href: string;
  cta: string;
}
const { lead, href, cta } = Astro.props;
const partners = sponsors.partners.filter(
  ({ category }) => category !== "host" && category !== "co-organizer"
);

// duplicated once for a seamless -50% loop
const loop = [...partners, ...partners];
---

<section class="psup" data-theme-section="dark" data-bg-section="lightgray">
  <p class="psup-eyebrow">
    <a href={href}>
      <span>{lead}</span>
      <span class="psup-cta">
        {cta}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </a>
  </p>

  <div class="psup-marquee">
    <div class="psup-row">
      {loop.map((l, i) => (
        <span class="psup-pill" aria-hidden={i >= partners.length ? "true" : undefined}>
          <img
            src={`/images/sponsors/${l.image}`}
            alt={i >= partners.length ? "" : l.name}
            loading="lazy"
            decoding="async"
          />
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  .psup {
    --cream: #eae6d2;
    position: relative;
    padding: clamp(3rem, 6vw, 5rem) 0;
    /* base matches the ProgramSection below (#141209) so the two sections blend
       into one continuous block with no seam between them */
    background:
      radial-gradient(120% 90% at 50% -20%, rgba(248, 74, 16, 0.07), transparent 55%),
      #141209;
    overflow: hidden;
    isolation: isolate;
  }

  .psup-eyebrow {
    margin: 0 0 clamp(1.8rem, 3.5vw, 2.8rem);
    text-align: center;
    font-size: clamp(1.25rem, 0.95rem + 1.2vw, 1.95rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--cream);
    padding: 0 1.5rem;
  }
  .psup-eyebrow a {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    color: inherit;
    text-decoration: none;
  }
  .psup-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 1rem;
    border: 1px solid rgba(234, 230, 210, 0.4);
    border-radius: 999px;
    background: rgba(234, 230, 210, 0.08);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0;
    transition: background 180ms ease, border-color 180ms ease;
  }
  .psup-eyebrow a:hover .psup-cta,
  .psup-eyebrow a:focus-visible .psup-cta {
    background: rgba(234, 230, 210, 0.18);
    border-color: var(--cream);
  }
  .psup-eyebrow a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 6px;
    border-radius: 2px;
  }

  /* fade the strip into the background at both edges */
  .psup-marquee {
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    overflow: hidden;
  }

  .psup-row {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    white-space: nowrap;
    width: max-content;
    will-change: transform;
    /* promote to its own GPU layer so pills don't drop out mid-scroll */
    transform: translateZ(0);
    backface-visibility: hidden;
    animation: psup-scroll 30s linear infinite;
  }
  @keyframes psup-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* liquid-glass pill (no backdrop-filter — many of these scroll, so the glass
     is faked with a translucent fill + specular sheen + a bright rim). */
  .psup-pill {
    position: relative;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 4.4rem;
    width: 11rem;
    padding: 0 1.4rem;
    border-radius: 1.05rem;
    background: rgba(255, 255, 255, 0.05);
    backface-visibility: hidden;
    /* rim ring via inset shadow instead of a mask-composite pseudo-element,
       which Chrome can fail to repaint on a transforming row (vanishing pills) */
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.14),
      inset 0 1.5px 1px rgba(255, 255, 255, 0.22),
      inset 0 -3px 7px rgba(0, 0, 0, 0.18),
      0 6px 18px rgba(0, 0, 0, 0.22);
  }
  .psup-pill img {
    /* fit every logo into the same bounding box so they read at a consistent
       size and none get clipped (e.g. Hugging Face) */
    max-height: 2.4rem;
    max-width: 8.2rem;
    width: auto;
    height: auto;
    object-fit: contain;
    /* Keep internal light/dark detail: a flat white silhouette erases enclosed
       artwork in logos such as Kaiyuanshe. Invert grayscale for the dark strip. */
    filter: grayscale(1) invert(1) brightness(1.6);
    opacity: 0.95;
  }
  @media (max-width: 640px) {
    .psup-pill {
      height: 3.7rem;
      width: 8.5rem;
      padding: 0 1rem;
    }
    .psup-pill img {
      max-height: 2rem;
      max-width: 6.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .psup-row { animation: none; }
    .psup-cta { transition: none; }
  }
</style>
