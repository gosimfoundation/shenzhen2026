---
// Packages
import { Picture } from 'astro:assets';

interface Props {
	id?: string,
	title: string,
    events?: Array<{
        title: string,
        date: string,
        description: string,
        image: any,
        link: string,
    }>,
}

const { id, title, events } = Astro.props;
const eventCount = events?.length ?? 0;
---

<section
    id={id}
    class="section section-resources-featured"
    data-theme-section="light"
    data-bg-section="lightgray"
>
    <div class="container wide">
        <div class="row">
            <div class="col">
                <h2>{title}</h2>
            </div>
        </div>

        <div
            class={`flickity-slider-group three-col count-${eventCount}`}
            data-flickity-slider-type="cards"
        >
            <div class="carousel-container">
                <button
                    class="carousel-arrow carousel-arrow-prev"
                    data-flickity-control="prev"
                    aria-label="Previous events"
                >
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            d="M15 18L9 12L15 6"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path>
                    </svg>
                </button>
                <div class="flickity-carousel">
                {events?.map((loop) => (
                    <div class="flickity-slide">
                        <a
                            href={loop.link}
                            target="_blank"
                            class="single-resources-card"
                        >
                            <div class="card-row card-row-image">
                                <div class="card-image">
                                    {loop?.image &&
                                        <Picture
                                            src={loop.image}
                                            formats={['webp', 'jpg']}
                                            alt={loop.title}
                                            widths={[225, 450, 600, 1000]}
                                            sizes="(max-width: 480px) 55vw, 500px"
                                        />
                                    }
                                </div>
                            </div>
                            <div class="card-row card-row-info">
                                <h3 class="h5">{loop.title}</h3>
                                <p class="dateb">{loop.date}</p>
                                <p>{loop.description}</p>
                            </div>
                        </a>
                    </div>
                ))}
                </div>
                <button
                    class="carousel-arrow carousel-arrow-next"
                    data-flickity-control="next"
                    aria-label="Next events"
                >
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            d="M9 18L15 12L9 6"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path>
                    </svg>
                </button>
            </div>
        </div>
    </div>
</section>

<style>
  .carousel-container {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* Liquid-glass arrows: translucent frosted fill + bright specular rim + inner
     gloss and depth shadow — matches the glass pills used elsewhere on the site. */
  .carousel-arrow {
    position: relative;
    /* see-through glass: low-opacity tint + light blur with a brightness/saturate
       lift, so the content behind stays visible (matches the hero glass buttons). */
    background: rgba(255, 255, 255, 0.2);
    -webkit-backdrop-filter: blur(4px) saturate(100%) brightness(0.91);
    backdrop-filter: blur(4px) saturate(100%) brightness(0.91);
    border: 0;
    border-radius: 50%;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease, opacity 0.3s ease;
    z-index: 10;
    flex-shrink: 0;
    box-shadow:
      inset 0 2px 1.5px rgba(255, 255, 255, 0.55),
      inset 0 -5px 9px rgba(0, 0, 0, 0.12),
      0 8px 22px rgba(0, 0, 0, 0.26);
  }

  /* glowing rim, brightest top-left where light catches the glass */
  .carousel-arrow::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    padding: 1px;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.75),
      rgba(255, 255, 255, 0.12) 45%,
      rgba(255, 255, 255, 0.1) 60%,
      rgba(255, 255, 255, 0.5)
    );
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    pointer-events: none;
  }

  .carousel-arrow:hover {
    background: rgba(255, 255, 255, 0.28);
    transform: scale(1.05);
    box-shadow:
      inset 0 2px 1.5px rgba(255, 255, 255, 0.65),
      inset 0 -5px 9px rgba(0, 0, 0, 0.12),
      0 10px 28px rgba(0, 0, 0, 0.32);
  }

  .carousel-arrow:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    transform: none;
  }

  .carousel-arrow svg {
    position: relative;
    z-index: 1;
    color: var(--color-heading);
  }

  .flickity-carousel {
    flex: 1;
  }

  @media (max-width: 768px) {
    .carousel-arrow {
      width: 40px;
      height: 40px;
    }
    
    .carousel-arrow svg {
      width: 20px;
      height: 20px;
    }
  }
</style>
