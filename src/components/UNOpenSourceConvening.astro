---
import Button from "components/Button.astro";
import { Picture } from "astro:assets";
import unHeadquarters from "images/events/un-headquarters.jpg";

interface Props {
  lang: "en" | "zh";
  compact?: boolean;
}

const { lang, compact = false } = Astro.props;
const isZh = lang === "zh";
const detailsPath = `${isZh ? "/zh" : ""}/un-open-source-convening/`;
const registrationUrl = "https://www.bagevent.com/event/9228523?discountCode=UNOPENSOURCECONVENTING";
const ticketsUrl = "https://www.bagevent.com/event/gosimshenzhen2026#website_moduleId_1164696";
const photoSourceUrl = "https://www.facebook.com/photo/?fbid=10160988638280820&set=a.577863084369721";
const copy = isZh
  ? {
      eyebrow: "GOSIM Shenzhen 2026 · 同期边会",
      title: "联合国开源专题会议",
      subtitle: "United Nations Open Source Convening",
      photoAlt: "纽约联合国总部大楼及各国国旗",
      photoCaption: "联合国总部 · 纽约",
      photoSourceLabel: "查看 Facebook 原图 · UN Photo/Rick Bajornas",
      summary: "GOSIM Shenzhen 2026 大会官方同期高端边会，面向全球开源、AI 与数字技术领域的产业决策者、科研专家及国际合作机构，探讨联合国开源工作与国际协作机遇。参会须经审核，凭正式确认通知入场。",
      introductionLabel: "会议背景",
      introduction: "本次会议为 GOSIM Shenzhen 2026 大会官方同期高端边会，旨在面向全球开源生态、人工智能、数字技术领域的产业决策者、顶尖科研专家与国际合作机构，搭建联合国主导的开源治理与国际协作交流平台。会议将系统发布联合国现阶段开源体系建设成果，凝聚全球核心参与主体，共同规划未来开源生态建设路径、探索跨国产学研协同合作机遇。",
      introductionNotes: [
        "名额有限，请点击“申请参会”提交申请，我们将对您的申请进行审核。审核通过后，GOSIM 大会组委会将向您发送后续邮件，告知会议地点。",
        "这是了解联合国对开源的支持，以及您如何参与联合国未来开源倡议的良好机会。",
      ],
      dateLabel: "活动日期",
      date: "2026 年 10 月 16 日",
      timeLabel: "活动时间",
      time: "10:00–12:00（北京时间，UTC+8）",
      locationLabel: "活动地点",
      location: "中国 · 深圳",
      admissionNote: "报名须经审核；审核通过后，凭主办方发送的正式参会确认通知入场。",
      details: "查看活动详情",
      register: "申请参会",
      tickets: "购买大会门票",
      registrationNote: "进入百格大会购票页面后，请选择 UN Open Source Convening 的单独审核通道提交报名。",
      topicsLabel: "核心研讨内容",
      topicsIntro: "本次专题会议将集中展示与深度研讨联合国开源生态重点工作，核心议题包括：",
      topics: [
        {
          title: "联合国开源周",
          text: "联合国开源周整体规划，以及 2027 年联合国开源周的全球合作伙伴招募与参与机制。",
        },
        {
          title: "面向科研、教育与创新的开放计算",
          text: "科研、教育与创新领域开放计算工作组的建设成果与落地推进计划。",
        },
        {
          title: "联合国开源人工智能专项工作组",
          text: "联合国开源人工智能专项工作组的筹建研讨与发展方向。",
        },
        {
          title: "APEC 深圳峰会配套开源 AI 专项活动",
          text: "2026 年 11 月 20 日 APEC 深圳峰会配套开源 AI 专项活动筹备工作，聚焦开放 AI 技术栈体系、开源 AI 全球治理规则、开源人工智能产业经济价值。",
        },
      ],
      hostLabel: "主办机构",
      organizer: "联合国数字与新兴技术办公室",
      participationLabel: "参会报名说明",
      participation: "本次会议对外开放报名，面向全球开源领域中高端专业人士，重点邀请企业开源负责人、技术决策者、C 级高管，可对企业高层决策产生影响力的产业领袖，以及高校、科研机构的资深科研负责人与学科带头人，同时包含行业组织负责人与国际机构代表。所有报名参会人员将进行审核制，审核通过后，主办方将统一发送正式参会确认通知，凭通知入场参会。",
      invitation: "会议诚挚邀请各界核心决策者参会交流，汇聚全球顶层智慧，共建开放、合规、普惠的全球开源与 AI 创新生态。",
    }
  : {
      eyebrow: "Side Event of GOSIM Shenzhen 2026",
      title: "United Nations Open Source Convening",
      subtitle: "Official high-level side event",
      photoAlt: "United Nations Headquarters in New York with national flags in the foreground",
      photoCaption: "United Nations Headquarters · New York",
      photoSourceLabel: "View original photo on Facebook · UN Photo/Rick Bajornas",
      summary: "An official high-level side event of GOSIM Shenzhen 2026 for industry decision-makers, leading researchers and international organisations to explore UN open source initiatives and collaboration. Applications are subject to review; an official confirmation notice is required for entry.",
      introductionLabel: "Event Introduction",
      introduction: "This convening is an official high-level side event of GOSIM Shenzhen 2026. It creates a UN-lead platform for industry decision-makers, leading researchers and international collaborative organisations within the global open source, AI and digital technology ecosystem. The session will share progress of ongoing UN open source initiatives, bring together key global stakeholders to shape the roadmap of open source ecosystem development, and identify cross-border, academia-industry-research collaboration opportunities.",
      introductionNotes: [
        "The space is limited. Please “Apply to attend” and your application will be reviewed. Once it’s approved, the GOSIM Event Committee will send you a follow-up email with the meeting location.",
        "This is a great opportunity to learn about United Nation’s support in Open Source and how you can play a part in future United Nation’s Open Source initiatives.",
      ],
      dateLabel: "Date",
      date: "October 16, 2026",
      timeLabel: "Time",
      time: "10:00–12:00 (China Standard Time, UTC+8)",
      locationLabel: "Location",
      location: "Shenzhen, China",
      admissionNote: "Applications are subject to review. Approved applicants must present the organisers' official confirmation notice for entry.",
      details: "Explore the convening",
      register: "Apply to attend",
      tickets: "Buy conference tickets",
      registrationNote: "On the BagEvent conference ticketing page, select the separate application option for UN Open Source Convening to submit your registration for review.",
      topicsLabel: "Key Discussion Topics",
      topicsIntro: "The convening will showcase and dive deep into priority UN open source workstreams, covering:",
      topics: [
        {
          title: "UN Open Source Week",
          text: "The overall roadmap for UN Open Source Week and partnership engagement framework for its 2027 edition.",
        },
        {
          title: "Open Compute for Research, Education and Innovation",
          text: "Progress and implementation plan of the Working Group on Open Compute for Research, Education and Innovation.",
        },
        {
          title: "An open source AI working group",
          text: "Discussions on the formation of the working group focused on open-source AI.",
        },
        {
          title: "Open source AI in Shenzhen during APEC",
          text: "Preparation for the open-source AI session during APEC 2026 in Shenzhen on 20 November, covering open AI stack, governance of open-source AI, and the economic value of open-source AI.",
        },
      ],
      hostLabel: "Host",
      organizer: "United Nations Office for Digital and Emerging Technologies",
      participationLabel: "Participation Notice",
      participation: "This event is open for applications. We target senior professionals across the global open source ecosystem, with priority given to enterprise open source leads, technical decision-makers, C-suite executives, industry leaders with influence over corporate strategic decisions, principal investigators and academic leaders from universities and research institutions, as well as heads of industry associations and representatives of international organisations. All applications will undergo a formal eligibility review. Upon approval, applicants will receive an official confirmation notice from the organisers, which is required for on-site entry.",
      invitation: "We warmly invite cross-sector decision-makers to join this exchange. Together we leverage global insights to build an open, compliant and inclusive global open source and AI innovation ecosystem.",
    };
const Heading = compact ? "h2" : "h1";
---

<section
  id="un-open-source-convening"
  class:list={["un-convening", { "is-compact": compact }]}
  data-theme-section="dark"
  data-bg-section="dark-tint"
  aria-labelledby="un-convening-title"
>
  <div class="container wide">
    <div class="event-hero">
      {!compact && (
        <figure class="event-photo">
          <div class="event-photo-background">
            <Picture
              src={unHeadquarters}
              alt={copy.photoAlt}
              formats={["webp"]}
              widths={[600, 900, 1200]}
              sizes="(max-width: 1100px) 100vw, 75vw"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
          <figcaption>
            <span>{copy.photoCaption}</span>
            <a href={photoSourceUrl} target="_blank" rel="noopener noreferrer" aria-label={copy.photoSourceLabel}>UN Photo/Rick Bajornas ↗</a>
          </figcaption>
        </figure>
      )}
      <p class="event-eyebrow">{copy.eyebrow}</p>
      <div class="event-overview">
        <div class="event-copy">
          <div class="event-heading">
            <Heading id="un-convening-title" class="event-title">{copy.title}</Heading>
            <p class="event-subtitle">{copy.subtitle}</p>
          </div>
          <div class="event-introduction">
            {!compact && <h2 class="event-intro-label">{copy.introductionLabel}</h2>}
            <p class="event-summary">{compact ? copy.summary : copy.introduction}</p>
            {!compact && copy.introductionNotes.map((paragraph) => (
              <p class="event-summary">{paragraph}</p>
            ))}
          </div>
        </div>
        <div class="event-attendance">
          <div class="event-actions">
            <Button
              text={compact ? copy.details : copy.register}
              link={compact ? detailsPath : registrationUrl}
              openInNewTab={!compact}
              class="btn primary xl btn-hover glass-orange"
            />
            {!compact && <a class="event-tickets" href={ticketsUrl} target="_blank" rel="noopener noreferrer">{copy.tickets} ↗</a>}
          </div>
          <div class="event-logistics">
            <dl class="event-facts">
              <div>
                <dt>{copy.dateLabel}</dt>
                <dd><time datetime="2026-10-16">{copy.date}</time></dd>
              </div>
              <div>
                <dt>{copy.timeLabel}</dt>
                <dd>{copy.time}</dd>
              </div>
              <div>
                <dt>{copy.locationLabel}</dt>
                <dd>{copy.location}</dd>
              </div>
              {!compact && (
                <div>
                  <dt>{copy.hostLabel}</dt>
                  <dd>{copy.organizer}</dd>
                </div>
              )}
            </dl>
          </div>
          {!compact && (
            <div class="event-registration-copy">
              <p class="event-note">{copy.admissionNote}</p>
              <p class="event-note">{copy.registrationNote}</p>
            </div>
          )}
        </div>
      </div>
    </div>

    {!compact && (
      <div class="event-program">
        <section aria-labelledby="un-convening-topics">
          <h2 id="un-convening-topics">{copy.topicsLabel}</h2>
          <p class="program-intro">{copy.topicsIntro}</p>
          <ol class="event-topics">
            {copy.topics.map((topic, index) => (
              <li>
                <span class="topic-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <h3>{topic.title}</h3>
                  <p>{topic.text}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>
        <section class="event-participation" aria-labelledby="un-convening-participation">
          <h2 id="un-convening-participation">{copy.participationLabel}</h2>
          <p>{copy.participation}</p>
          <p>{copy.invitation}</p>
        </section>
      </div>
    )}
  </div>
</section>

<style>
  .un-convening {
    padding: calc(var(--nav-bar-height) + 3rem) 0 5rem;
    background: radial-gradient(ellipse at top right, rgba(248, 74, 16, 0.09), transparent 60%), #141209;
    color: #f6f3e7;
  }

  .un-convening.is-compact {
    padding-block: clamp(3rem, 5vw, 5rem);
    border-bottom: 1px solid rgba(246, 243, 231, 0.14);
  }

  .un-convening:not(.is-compact) {
    padding-top: calc(var(--nav-bar-height) + 0.5rem);
    background: #141209;
  }

  .un-convening:not(.is-compact) .event-hero {
    position: relative;
    isolation: isolate;
    padding-bottom: 2.5rem;
  }

  .un-convening:not(.is-compact) .event-eyebrow {
    margin-bottom: 0.85rem;
  }

  .event-eyebrow {
    margin: 0 0 1.5rem;
    color: #f84a10;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .event-overview,
  .event-program {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
  }

  .event-overview {
    row-gap: 3rem;
    align-items: start;
  }

  .un-convening:not(.is-compact) .event-overview {
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 3rem);
  }

  .event-photo {
    position: absolute;
    inset: 0;
    z-index: -1;
    margin: 0;
    pointer-events: none;
  }

  .event-photo-background {
    position: absolute;
    inset: calc(-1 * (var(--nav-bar-height) + 0.5rem)) calc(-1 * var(--container-padding)) -2rem 25%;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 25%);
  }

  .event-photo-background::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(0deg, #141209, transparent 25%),
      linear-gradient(90deg, #141209, rgba(20, 18, 9, 0.85) 30%, rgba(20, 18, 9, 0.4) 75%, rgba(20, 18, 9, 0.25));
  }

  .event-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 90%;
  }

  .event-photo :global(picture) {
    display: block;
    height: 100%;
  }

  .event-photo figcaption {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.25rem 0.75rem;
    color: rgba(246, 243, 231, 0.8);
    font-size: 0.68rem;
    line-height: 1.45;
    pointer-events: auto;
  }

  .event-photo figcaption a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .event-photo figcaption a:hover,
  .event-photo figcaption a:focus-visible {
    color: #f6f3e7;
  }

  .event-attendance {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .is-compact .event-actions {
    order: 1;
  }

  .un-convening:not(.is-compact) .event-attendance {
    gap: 1rem;
    padding: clamp(1rem, 1.5vw, 1.25rem);
    border: 1px solid rgba(246, 243, 231, 0.18);
    background: rgba(20, 18, 9, 0.66);
    box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.12);
  }

  .un-convening:not(.is-compact) .event-facts {
    gap: 0.85rem;
  }

  .un-convening:not(.is-compact) .event-facts dt {
    margin-bottom: 0.25rem;
    color: rgba(246, 243, 231, 0.76);
    font-size: 0.7rem;
  }

  .un-convening:not(.is-compact) .event-facts dd {
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .event-registration-copy {
    padding-top: 0.75rem;
    border-top: 1px solid rgba(246, 243, 231, 0.12);
  }

  .event-registration-copy .event-note {
    margin-top: 0.5rem;
    color: rgba(246, 243, 231, 0.76);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .event-registration-copy .event-note:first-child {
    margin-top: 0;
  }

  .un-convening:not(.is-compact) .event-actions {
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem 1.25rem;
    margin-top: 0;
  }

  .event-tickets {
    color: #f6f3e7;
    font-size: 0.82rem;
    line-height: 1.5;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .event-tickets:hover,
  .event-tickets:focus-visible {
    color: #ff9b70;
  }

  .event-title {
    max-width: 15ch;
    margin: 0;
    color: #f6f3e7;
    font-size: clamp(2.6rem, 5.4vw, 5.5rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .is-compact .event-title {
    font-size: clamp(2.4rem, 4.15vw, 4.6rem);
  }

  .un-convening:not(.is-compact) .event-title {
    font-size: clamp(2.1rem, 3.3vw, 3.1rem);
  }

  .un-convening:not(.is-compact) .event-subtitle {
    margin-top: 0.85rem;
    font-size: 1.1rem;
  }

  .un-convening:not(.is-compact) .event-intro-label {
    margin-top: 1rem;
  }

  .un-convening:not(.is-compact) .event-introduction .event-summary {
    margin-top: 0.75rem;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .event-subtitle {
    margin: 1.2rem 0 0;
    color: #f6f3e7;
    font-size: 1.2rem;
    line-height: 1.5;
  }

  .event-intro-label {
    margin: 2rem 0 0;
    color: #f6f3e7;
    font-size: 1.2rem;
    line-height: 1.45;
  }

  .event-summary,
  .program-intro,
  .event-topics p,
  .event-participation p {
    margin: 1.2rem 0 0;
    color: rgba(246, 243, 231, 0.76);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .event-facts {
    display: grid;
    gap: 1.3rem;
    margin: 0;
  }

  .event-facts dt {
    margin-bottom: 0.4rem;
    color: rgba(246, 243, 231, 0.6);
    font-size: 0.8rem;
  }

  .event-facts dd {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.5;
  }

  .event-actions {
    display: flex;
    margin-top: 2rem;
  }

  .event-note {
    margin: 1rem 0 0;
    color: rgba(246, 243, 231, 0.6);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .event-program {
    margin-top: clamp(3rem, 6vw, 6rem);
    padding-top: 3rem;
    border-top: 1px solid rgba(246, 243, 231, 0.18);
  }

  .event-program h2 {
    margin: 0;
    color: #f6f3e7;
    font-size: 2rem;
  }

  .event-topics {
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .event-topics li {
    display: flex;
    gap: 1.25rem;
    padding: 1.5rem 0;
    border-top: 1px solid rgba(246, 243, 231, 0.14);
  }

  .topic-number {
    padding-top: 0.2rem;
    color: #f84a10;
    font-size: 0.8rem;
  }

  .event-topics h3 {
    margin: 0;
    color: #f6f3e7;
    font-size: 1.2rem;
    line-height: 1.45;
  }

  .event-topics p {
    margin-top: 0.6rem;
  }

  @media (max-width: 1100px) {
    .event-photo-background {
      left: calc(-1 * var(--container-padding));
      max-height: 60rem;
      mask-image: none;
    }

    .event-photo-background::after {
      background:
        linear-gradient(0deg, #141209, transparent 35%),
        linear-gradient(90deg, rgba(20, 18, 9, 0.85), rgba(20, 18, 9, 0.55));
    }

    .event-photo figcaption {
      justify-content: flex-start;
      left: 0;
    }

    .un-convening:not(.is-compact) .event-overview {
      grid-template-columns: 1fr;
      row-gap: 1.5rem;
    }

    .un-convening:not(.is-compact) .event-copy {
      display: contents;
    }

    .event-heading {
      order: 1;
    }

    .event-attendance {
      order: 2;
    }

    .event-introduction {
      order: 3;
    }

    .un-convening:not(.is-compact) .event-intro-label {
      margin-top: 0;
    }

  }

  @media (max-width: 800px) {
    .event-overview,
    .event-program {
      grid-template-columns: 1fr;
    }

    .un-convening {
      padding-top: calc(var(--nav-bar-height) + 2rem);
    }
  }

</style>
