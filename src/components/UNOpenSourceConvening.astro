---
import Button from "components/Button.astro";
import { Picture } from "astro:assets";
import unHeadquarters from "images/events/un-headquarters.jpg";
import { schedule } from "utils/conference";
import { eventPhotoAlbumUrl } from "utils/event-summary";

interface Props {
  lang: "en" | "zh";
  compact?: boolean;
}

const { lang, compact = false } = Astro.props;
const isZh = lang === "zh";
const conveningTime = schedule.activities.find((activity) => activity.id === "un-open-source-convening")!.sessions[0].timeSlot!.replace("-", "–");
const detailsPath = `${isZh ? "/zh" : ""}/un-open-source-convening/`;
const photoSourceUrl = "https://www.facebook.com/photo/?fbid=10160988638280820&set=a.577863084369721";
const copy = isZh
  ? {
      eyebrow: "GOSIM Shenzhen 2026 · 同期边会",
      title: "联合国开源专题会议",
      subtitle: "United Nations Open Source Convening",
      photoAlt: "纽约联合国总部大楼及各国国旗",
      photoCaption: "联合国总部 · 纽约",
      photoSourceLabel: "查看 Facebook 原图 · UN Photo/Rick Bajornas",
      summary: "GOSIM Shenzhen 2026 大会官方同期高端边会，面向全球开源、AI 与数字技术领域的产业决策者、科研专家及国际合作机构，探讨联合国开源工作与国际协作机遇。活动已结束，参会申请已关闭。",
      introductionLabel: "会议背景",
      introduction: "本次会议为 GOSIM Shenzhen 2026 大会官方同期高端边会，旨在面向全球开源生态、人工智能、数字技术领域的产业决策者、顶尖科研专家与国际合作机构，搭建联合国主导的开源治理与国际协作交流平台。会议围绕联合国现阶段开源体系建设成果、未来开源生态建设路径与跨国产学研协同合作机遇展开交流。",
      introductionNotes: [
        "本次会议已结束，参会申请已关闭。感谢各位嘉宾的参与与支持。",
        "本页保留本次会议的背景与议题资料，供会后查阅。",
      ],
      dateLabel: "活动日期",
      date: "2026 年 10 月 16 日",
      timeLabel: "活动时间",
      time: `${conveningTime}（北京时间，UTC+8）`,
      locationLabel: "活动地点",
      location: "中国 · 深圳",
      admissionNote: "本次活动已结束，参会申请已关闭。",
      details: "查看活动详情",
      album: "查看大会相册",
      registrationNote: "感谢各位嘉宾的参与，欢迎浏览大会相册。",
      topicsLabel: "核心研讨内容",
      topicsIntro: "本次专题会议围绕联合国开源生态重点工作展开，核心议题包括：",
      topics: [
        {
          title: "联合国开源周",
          text: "联合国开源周整体规划，以及 2027 年联合国开源周的全球合作伙伴招募与参与机制。",
        },
        {
          title: "面向科研、教育与创新的开放计算",
          text: "科研、教育与创新领域开放计算工作组的建设成果与落地推进计划。",
        },
        {
          title: "联合国开源人工智能专项工作组",
          text: "联合国开源人工智能专项工作组的筹建研讨与发展方向。",
        },
        {
          title: "APEC 深圳峰会配套开源 AI 专项活动",
          text: "2026 年 11 月 20 日 APEC 深圳峰会配套开源 AI 专项活动筹备工作，聚焦开放 AI 技术栈体系、开源 AI 全球治理规则、开源人工智能产业经济价值。",
        },
      ],
      hostLabel: "主办机构",
      organizer: "联合国数字与新兴技术办公室",
      participationLabel: "参会信息（存档）",
      participation: "本次会议面向全球开源领域的企业开源负责人、技术决策者、产业领袖、高校与科研机构代表、行业组织及国际机构代表。活动已结束，报名通道已关闭。",
      invitation: "感谢各位嘉宾对全球开源与 AI 创新交流的参与和支持。",
    }
  : {
      eyebrow: "Side Event of GOSIM Shenzhen 2026",
      title: "United Nations Open Source Convening",
      subtitle: "Official high-level side event",
      photoAlt: "United Nations Headquarters in New York with national flags in the foreground",
      photoCaption: "United Nations Headquarters · New York",
      photoSourceLabel: "View original photo on Facebook · UN Photo/Rick Bajornas",
      summary: "An official high-level side event of GOSIM Shenzhen 2026 for industry decision-makers, leading researchers and international organisations to explore UN open source initiatives and collaboration. The event has concluded and applications are closed.",
      introductionLabel: "Event Introduction",
      introduction: "This convening was an official high-level side event of GOSIM Shenzhen 2026. It provided a UN-led platform for industry decision-makers, leading researchers and international collaborative organisations within the global open source, AI and digital technology ecosystem. The session focused on ongoing UN open source initiatives, the roadmap for open source ecosystem development, and cross-border collaboration between industry and research institutions.",
      introductionNotes: [
        "This event has concluded and applications are closed. Thank you for your participation.",
        "The meeting background and topics are retained here for reference.",
      ],
      dateLabel: "Date",
      date: "October 16, 2026",
      timeLabel: "Time",
      time: `${conveningTime} (China Standard Time, UTC+8)`,
      locationLabel: "Location",
      location: "Shenzhen, China",
      admissionNote: "This event has concluded and applications are closed.",
      details: "Explore the convening",
      album: "View Event Photos",
      registrationNote: "Thank you for joining us. Explore the conference photo album.",
      topicsLabel: "Key Discussion Topics",
      topicsIntro: "The convening focused on priority UN open source workstreams, covering:",
      topics: [
        {
          title: "UN Open Source Week",
          text: "The overall roadmap for UN Open Source Week and partnership engagement framework for its 2027 edition.",
        },
        {
          title: "Open Compute for Research, Education and Innovation",
          text: "Progress and implementation plan of the Working Group on Open Compute for Research, Education and Innovation.",
        },
        {
          title: "An open source AI working group",
          text: "Discussions on the formation of the working group focused on open-source AI.",
        },
        {
          title: "Open source AI in Shenzhen during APEC",
          text: "Preparation for the open-source AI session during APEC 2026 in Shenzhen on 20 November, covering open AI stack, governance of open-source AI, and the economic value of open-source AI.",
        },
      ],
      hostLabel: "Host",
      organizer: "United Nations Office for Digital and Emerging Technologies",
      participationLabel: "Participation Information (Archive)",
      participation: "The convening was intended for enterprise open source leads, technical decision-makers, industry leaders, researchers, academic leaders, and representatives of industry associations and international organisations. The event has concluded and applications are closed.",
      invitation: "Thank you to everyone who supported this exchange on global open source and AI innovation.",
    };
const Heading = compact ? "h2" : "h1";
---

<section
  id="un-open-source-convening"
  class:list={["un-convening", { "is-compact": compact }]}
  data-theme-section="dark"
  data-bg-section="dark-tint"
  aria-labelledby="un-convening-title"
>
  <div class="container wide">
    <div class="event-hero">
      <figure class="event-photo">
        <div class="event-photo-background">
          <Picture
            src={unHeadquarters}
            alt={copy.photoAlt}
            formats={["webp"]}
            widths={[600, 900, 1200]}
            sizes="100vw"
            loading={compact ? "lazy" : "eager"}
            fetchpriority={compact ? "auto" : "high"}
            decoding="async"
          />
        </div>
        <figcaption>
          <span>{copy.photoCaption}</span>
          <a href={photoSourceUrl} target="_blank" rel="noopener noreferrer" aria-label={copy.photoSourceLabel}>UN Photo/Rick Bajornas ↗</a>
        </figcaption>
      </figure>
      <p class="event-eyebrow">{copy.eyebrow}</p>
      <div class="event-overview">
        <div class="event-copy">
          <div class="event-heading">
            <Heading id="un-convening-title" class="event-title">{copy.title}</Heading>
            <p class="event-subtitle">{copy.subtitle}</p>
          </div>
          <div class="event-introduction">
            {!compact && <h2 class="event-intro-label">{copy.introductionLabel}</h2>}
            <p class="event-summary">{compact ? copy.summary : copy.introduction}</p>
            {!compact && copy.introductionNotes.map((paragraph) => (
              <p class="event-summary">{paragraph}</p>
            ))}
          </div>
        </div>
        <div class="event-attendance">
          <div class="event-actions">
            <Button
              text={compact ? copy.details : copy.album}
              link={compact ? detailsPath : eventPhotoAlbumUrl}
              openInNewTab={!compact}
              class="btn primary xl btn-hover glass-orange"
            />
          </div>
          <div class="event-logistics">
            <dl class="event-facts">
              <div>
                <dt>{copy.dateLabel}</dt>
                <dd><time datetime="2026-10-16">{copy.date}</time></dd>
              </div>
              <div>
                <dt>{copy.timeLabel}</dt>
                <dd>{copy.time}</dd>
              </div>
              <div>
                <dt>{copy.locationLabel}</dt>
                <dd>{copy.location}</dd>
              </div>
              {!compact && (
                <div>
                  <dt>{copy.hostLabel}</dt>
                  <dd>{copy.organizer}</dd>
                </div>
              )}
            </dl>
          </div>
          {!compact && (
            <div class="event-registration-copy">
              <p class="event-note">{copy.admissionNote}</p>
              <p class="event-note">{copy.registrationNote}</p>
            </div>
          )}
        </div>
      </div>
    </div>

    {!compact && (
      <div class="event-program">
        <section aria-labelledby="un-convening-topics">
          <h2 id="un-convening-topics">{copy.topicsLabel}</h2>
          <p class="program-intro">{copy.topicsIntro}</p>
          <ol class="event-topics">
            {copy.topics.map((topic, index) => (
              <li>
                <span class="topic-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <h3>{topic.title}</h3>
                  <p>{topic.text}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>
        <section class="event-participation" aria-labelledby="un-convening-participation">
          <h2 id="un-convening-participation">{copy.participationLabel}</h2>
          <p>{copy.participation}</p>
          <p>{copy.invitation}</p>
        </section>
      </div>
    )}
  </div>
</section>

<style>
  .un-convening {
    container-type: inline-size;
    padding: calc(var(--nav-bar-height) + 3rem) 0 5rem;
    background: #141209;
    color: #f6f3e7;
  }

  .un-convening.is-compact {
    --event-section-padding: clamp(3rem, 5vw, 5rem);
    padding-block: var(--event-section-padding);
    border-bottom: 1px solid rgba(246, 243, 231, 0.14);
  }

  .un-convening:not(.is-compact) {
    padding-top: calc(var(--nav-bar-height) + 0.5rem);
  }

  .event-hero {
    position: relative;
    isolation: isolate;
    padding-bottom: 2.5rem;
  }

  .un-convening:not(.is-compact) .event-eyebrow {
    margin-bottom: 0.85rem;
  }

  .event-eyebrow {
    margin: 0 0 1.5rem;
    color: #f84a10;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .event-overview,
  .event-program {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
  }

  .event-overview {
    row-gap: 3rem;
    align-items: start;
  }

  .un-convening:not(.is-compact) .event-overview {
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 3rem);
  }

  .event-photo {
    position: absolute;
    inset: 0;
    z-index: -1;
    margin: 0;
    pointer-events: none;
  }

  .event-photo-background {
    position: absolute;
    /* Span the section width independently of the centered content container. */
    inset: calc(-1 * (var(--nav-bar-height) + 0.5rem)) calc(50% - 50cqw) -2rem;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 25%);
  }

  .is-compact .event-photo-background {
    top: calc(-1 * var(--event-section-padding));
    bottom: calc(-1 * var(--event-section-padding));
    max-height: none;
  }

  .event-photo-background::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(0deg, #141209, transparent 25%),
      linear-gradient(90deg, #141209, rgba(20, 18, 9, 0.93) 35%, rgba(20, 18, 9, 0.72) 60%, rgba(20, 18, 9, 0.4) 85%, rgba(20, 18, 9, 0.25));
  }

  .event-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 90%;
  }

  .event-photo :global(picture) {
    display: block;
    height: 100%;
  }

  .event-photo figcaption {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.25rem 0.75rem;
    color: rgba(246, 243, 231, 0.8);
    font-size: 0.68rem;
    line-height: 1.45;
    pointer-events: auto;
  }

  .event-photo figcaption a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .event-photo figcaption a:hover,
  .event-photo figcaption a:focus-visible {
    color: #f6f3e7;
  }

  .event-attendance {
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: clamp(1rem, 1.5vw, 1.25rem);
    border: 1px solid rgba(246, 243, 231, 0.18);
    background: rgba(20, 18, 9, 0.66);
    box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.12);
  }

  .is-compact .event-actions {
    order: 1;
  }

  .un-convening:not(.is-compact) .event-attendance {
    gap: 1rem;
  }

  .un-convening:not(.is-compact) .event-facts {
    gap: 0.85rem;
  }

  .un-convening:not(.is-compact) .event-facts dt {
    margin-bottom: 0.25rem;
    color: rgba(246, 243, 231, 0.76);
    font-size: 0.7rem;
  }

  .un-convening:not(.is-compact) .event-facts dd {
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .event-registration-copy {
    padding-top: 0.75rem;
    border-top: 1px solid rgba(246, 243, 231, 0.12);
  }

  .event-registration-copy .event-note {
    margin-top: 0.5rem;
    color: rgba(246, 243, 231, 0.76);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .event-registration-copy .event-note:first-child {
    margin-top: 0;
  }

  .un-convening:not(.is-compact) .event-actions {
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem 1.25rem;
    margin-top: 0;
  }

  .event-tickets {
    color: #f6f3e7;
    font-size: 0.82rem;
    line-height: 1.5;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .event-tickets:hover,
  .event-tickets:focus-visible {
    color: #ff9b70;
  }

  .event-title {
    max-width: 15ch;
    margin: 0;
    color: #f6f3e7;
    font-size: clamp(2.6rem, 5.4vw, 5.5rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .is-compact .event-title {
    font-size: clamp(2.4rem, 4.15vw, 4.6rem);
  }

  .un-convening:not(.is-compact) .event-title {
    font-size: clamp(2.1rem, 3.3vw, 3.1rem);
  }

  .un-convening:not(.is-compact) .event-subtitle {
    margin-top: 0.85rem;
    font-size: 1.1rem;
  }

  .un-convening:not(.is-compact) .event-intro-label {
    margin-top: 1rem;
  }

  .un-convening:not(.is-compact) .event-introduction .event-summary {
    margin-top: 0.75rem;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .event-subtitle {
    margin: 1.2rem 0 0;
    color: #f6f3e7;
    font-size: 1.2rem;
    line-height: 1.5;
  }

  .event-intro-label {
    margin: 2rem 0 0;
    color: #f6f3e7;
    font-size: 1.2rem;
    line-height: 1.45;
  }

  .event-summary,
  .program-intro,
  .event-topics p,
  .event-participation p {
    margin: 1.2rem 0 0;
    color: rgba(246, 243, 231, 0.76);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .event-facts {
    display: grid;
    gap: 1.3rem;
    margin: 0;
  }

  .event-facts dt {
    margin-bottom: 0.4rem;
    color: rgba(246, 243, 231, 0.6);
    font-size: 0.8rem;
  }

  .event-facts dd {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.5;
  }

  .event-actions {
    display: flex;
    margin-top: 2rem;
  }

  .event-note {
    margin: 1rem 0 0;
    color: rgba(246, 243, 231, 0.6);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .event-program {
    margin-top: clamp(3rem, 6vw, 6rem);
    padding-top: 3rem;
    border-top: 1px solid rgba(246, 243, 231, 0.18);
  }

  .event-program h2 {
    margin: 0;
    color: #f6f3e7;
    font-size: 2rem;
  }

  .event-topics {
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .event-topics li {
    display: flex;
    gap: 1.25rem;
    padding: 1.5rem 0;
    border-top: 1px solid rgba(246, 243, 231, 0.14);
  }

  .topic-number {
    padding-top: 0.2rem;
    color: #f84a10;
    font-size: 0.8rem;
  }

  .event-topics h3 {
    margin: 0;
    color: #f6f3e7;
    font-size: 1.2rem;
    line-height: 1.45;
  }

  .event-topics p {
    margin-top: 0.6rem;
  }

  @media (max-width: 1100px) {
    .event-photo-background {
      max-height: 60rem;
      mask-image: none;
    }

    .event-photo-background::after {
      background:
        linear-gradient(0deg, #141209, transparent 35%),
        linear-gradient(90deg, rgba(20, 18, 9, 0.85), rgba(20, 18, 9, 0.55));
    }

    .event-photo figcaption {
      justify-content: flex-start;
      left: 0;
    }

    .un-convening:not(.is-compact) .event-overview {
      grid-template-columns: 1fr;
      row-gap: 1.5rem;
    }

    .un-convening:not(.is-compact) .event-copy {
      display: contents;
    }

    .event-heading {
      order: 1;
    }

    .event-attendance {
      order: 2;
    }

    .event-introduction {
      order: 3;
    }

    .un-convening:not(.is-compact) .event-intro-label {
      margin-top: 0;
    }

  }

  @media (max-width: 800px) {
    .event-overview,
    .event-program {
      grid-template-columns: 1fr;
    }

    .un-convening {
      padding-top: calc(var(--nav-bar-height) + 2rem);
    }
  }

</style>
